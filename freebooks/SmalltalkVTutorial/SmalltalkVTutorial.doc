\plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-223\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer the denominator of the receiver. Default is one which can be overridden\line \expndtw-1 by the subclasses.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 even}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer true if the integer part of the receiver is even, else answer false.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb83\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw19\dn0\f3\cchs0\lang1033\fs20 exp}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the exponential of the receiver.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb86\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f2\cchs0\lang1033\fs20 floor}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer the integer nearest the receiver truncating towards negative infinity.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 integerCos}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer the integer cosine of the receiver angle, measured in degrees, scaled by\line \expndtw-1 100.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2280\margrsxn2040\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs16 420      Number}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb317\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-1\dn0\f3\cchs0\lang1033\fs20 integerSin}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer the integer sine of the receiver angle, measured in degrees, scaled by 100.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb72\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 In}\par \pard \plain \cbpat0\ql\li785\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the natural log of the receiver.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 log:  \b0 aNumber}\par \pard \plain \cbpat0\ql\li781\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the log base aNumber of the receiver.}\par \pard \plain \cbpat0\ql\li389\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw1\dn0\f3\cchs0\lang1033\fs20 negated}\par \pard \plain \cbpat0\ql\li781\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the negation of the receiver.}\par \pard \plain \cbpat0\ql\li389\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw1\dn0\f3\cchs0\lang1033\fs20 negative}\par \pard \plain \cbpat0\ql\li781\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver is less than zero, else answer false.}\par \pard \plain \cbpat0\ql\li382\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-1\dn0\f3\cchs0\lang1033\fs20 numerator}\par \pard \plain \cbpat0\ql\li778\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 Answer the numerator of the receiver.  Default is the receiver which can be\line \expndtw3 overridden by the subclasses.}\par \pard \plain \cbpat0\ql\li382\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 odd}\par \pard \plain \cbpat0\ql\li778\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the integer part of the receiver is odd, else answer false.}\par \pard \plain \cbpat0\ql\li378\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw0\dn0\f3\cchs0\lang1033\fs20 positive}\par \pard \plain \cbpat0\ql\li774\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver is greater than or equal to zero, else answer false.}\par \pard \plain \cbpat0\ql\li378\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 printFraction: \b0 numberFractionDigits}\par \pard \plain \cbpat0\ql\li778\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer   a   string,   the   ASCII   representation   of   the   receiver   truncated   to\line \expndtw3 numberFractionDigits decimal places.}\par \pard \plain \cbpat0\ql\li374\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-6\dn0\f3\cchs0\lang1033\fs20 print On: \b0 aStream}\par \pard \plain \cbpat0\ql\li774\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Append the ASCII representation of the receiver to aStream.}\par \pard \plain \cbpat0\ql\li374\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 printRounded: \b0 numberFractionDigits}\par \pard \plain \cbpat0\ql\li774\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer   a   string,   the   ASCII   representation   of   the   receiver   rounded   to\line numberFractionDigits decimal places.}\par \pard \plain \cbpat0\ql\li382\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 quo: \b0 aNumber}\par \pard \plain \cbpat0\ql\li770\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the integer quotient with truncation toward zero.}\par \pard \plain \cbpat0\ql\li374\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw0\dn0\f3\cchs0\lang1033\fs20 radiansToDegrees}\par \pard \plain \cbpat0\ql\li770\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the receiver converted from radians to degrees.}\par \pard \plain \cbpat0\ql\li378\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-3\dn0\f3\cchs0\lang1033\fs20 raisedTo: \b0 aNumber}\par \pard \plain \cbpat0\ql\li770\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the receiver raised to the power of aNumber.}\par \pard \plain \cbpat0\ql\li371\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw0\dn0\f3\cchs0\lang1033\fs20 raisedToInteger: \b0 anlnteger}\par \pard \plain \cbpat0\ql\li767\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the receiver raised to the power of anlnteger.}\par \pard \plain \cbpat0\ql\li367\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-1\dn0\f3\cchs0\lang1033\fs20 reciprocal}\par \pard \plain \cbpat0\ql\li763\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer one divided by the receiver.}\par \pard \plain \cbpat0\ql\li367\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 rent: \b0 aNumber}\par \pard \plain \cbpat0\ql\li763\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 Answer the integer remainder after dividing the receiver by aNumber with\line \expndtw3 truncation towards zero.}\par \pard \plain \cbpat0\ql\li364\fi0\ri0\sb94\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-2\dn0\f3\cchs0\lang1033\fs20 rounded}\par \pard \plain \cbpat0\ql\li760\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the nearest integer to the receiver.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2480\margrsxn2207\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs14 Number     421}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb320\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 roundTo: \b0 aNumber}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the receiver rounded to the nearest multiple of aNumber.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw15\dn0\f3\cchs0\lang1033\fs20 sign}\par \pard \plain \cbpat0\qj\li392\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer 1 if the receiver is greater than zero, answer -1 if the receiver is less than\line zero, else answer zero.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb104\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs20 sin}\par \pard \plain \cbpat0\qj\li396\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the sine of the receiver. The receiver is an angle measured\line \expndtw4 in radians.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb72\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 sqrt}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the square root of the receiver.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 squared}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the receiver multiplied by the receiver.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 storeOn: \b0 aStream}\par \pard \plain \cbpat0\qj\li396\fi0\ri7\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Append the ASCII representation of the receiver to aStream from which the\line \expndtw4 receiver can be reconstructed.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb94\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw16\dn0\f3\cchs0\lang1033\fs20 strictlyPositive}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver is greater than zero, else answer false.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs20 tan}\par \pard \plain \cbpat0\qj\li400\fi0\ri7\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer a Float which is the tangent of the receiver. The receiver is an angle\line measured in radians.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb90\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw15\dn0\f3\cchs0\lang1033\fs20 timesTwoPower: anlnteger}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the result of multiplying the receiver by 2 to the exponent anlnteger.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 to: \b0 aNumber}\par \pard \plain \cbpat0\qj\li400\fi0\ri18\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Answer an Interval for the numbers between the receiver and the argument\line \expndtw5 aNumber where each number is the previous number plus 1.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 to: \b0 sNumber by: iNumber}\par \pard \plain \cbpat0\qj\li400\fi0\ri22\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Answer an Interval for the numbers between the receiver and the argument\line \expndtw3 sNumber where each number is the previous number plus the argument iNumber.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb83\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 to: \b0 sNumber by: iNumber \b do: \b0 aBlock}\par \pard \plain \cbpat0\qj\li400\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Evaluate the one argument block aBlock for the numbers between the receiver and\line \expndtw6 the argument sNumber where each number is the previous number plus the\line \expndtw4 argument iNumber.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 to: \b0 aNumber \b do: \b0 aBlock}\par \pard \plain \cbpat0\qj\li400\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Evaluate the one argument block aBlock for the numbers between the receiver and\line \expndtw6 the argument aNumber where each number is the previous number plus 1.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 truncateTo: \b0 aNumber}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the receiver truncated (towards zero) to the nearest multiple of aNumber.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2289\margrsxn1995\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs16 4i2      \i Object}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb256\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs26 Object}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb205\sa198\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Class Object is the superclass of all other classes and defines the protocol common to all\line \expndtw6 objects. It defines the default behavior for displaying, comparing, copying, hashing,\line inspecting objects, evaluating blocks, accessing indexed instance variables and error\line \expndtw3 handling. It includes capabilities to maintain dependency relationships between objects and\line \expndtw2 to broadcast messages from an object to its dependents. It also provides the entry point for\line \expndtw5 interrupt handling.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2296\margrsxn6257\margtsxn1440\margbsxn720\cols2\colno1\colw1227\colsr1408\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Inherits From:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs20 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2289\margrsxn1995\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb36\sa0\sl-439\slmult0\tx2642 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Inherited By:{\charscalex100\expndtw0\tab }\expndtw-1 (All classes)}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables: (None)}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Class Variables:}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb54\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Dependents}\par \pard \plain \cbpat0\qj\li796\fi0\ri4\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Contains an IdentityDictionary representing object dependents. For each entry, the\line key is an object and the associated value is the set of all other objects which are\line \expndtw6 dependent on the key object. It is initialized to an empty dictionary.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 RecursionlnError}\par \pard \plain \cbpat0\qj\li796\fi0\ri7\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Contains a Boolean indicating whether an error has occurred while reporting an\line \expndtw1 error in a walkback window. If so, the destination of the error output switches from\line \expndtw5 the walkback window to the display screen. It is initialized to false.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 RecursiveSet}\par \pard \plain \cbpat0\qj\li792\fi0\ri0\sb4\sa212\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Contains a Set of objects whose display has started but not finished. It is used for\line \expndtw0 gracefully detecting the display of self referencing data structures (e.g., show it from\line \expndtw4 TextPane menu).}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2296\margrsxn6261\margtsxn1440\margbsxn720\cols2\colno1\colw1479\colsr1152\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Pool Dictionaries:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs20 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2289\margrsxn1995\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb205\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Class Methods:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 initDependents}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Initialize the Dependents dictionary to empty.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 initialize}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Initialize the class variables for detecting recursive data structures.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb202\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Instance Methods:}\par \pard \plain \cbpat0\ql\li439\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs20 \'99\hich\af1\dbch\af3\loch\f1\cchs0  anObject}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 This is the default equality test. Answer true if the receiver and anObject are the\line same object, else answer false.}\par \pard \plain \cbpat0\ql\li439\fi0\ri0\sb83\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-2\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs20 \'97\hich\af1\dbch\af3\loch\f1\cchs0  \i0 >\dbch\af3\loch\af1\hich\f1\cchs0 \u9632\'3f\hich\af1\dbch\af3\loch\f1\cchs0  anObject}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver and anObject are the same object, else answer false.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 addDependent: \b0 anObject}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Add anObject to the class variable Dependents of class Object.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2589\margrsxn2092\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs16 Object      423}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb288\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 allDependents}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a Set containing all the dependents of the receiver.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb47\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 allReferences}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer an Array of all of the references to the receiver.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 at: \b0 anlnteger}\par \pard \plain \cbpat0\qj\li400\fi0\ri4\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the object in the receiver at index position anlnteger. If the receiver does\line not have indexed instance variables, or if anlnteger is greater than the number of\line \expndtw5 indexed instance variables, report an error.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 at: \b0 anlnteger \b put: \b0 anObject}\par \pard \plain \cbpat0\qj\li396\fi0\ri4\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Replace the object in the receiver at index position anlnteger\line with anObject. If the receiver does not have indexed instance variables, or if\line \expndtw2 anlnteger is greater than the number of indexed instance variables, report an error.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb79\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 basic At: \b0 anlnteger}\par \pard \plain \cbpat0\qj\li403\fi0\ri4\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the object in the receiver at index position anlnteger. If the receiver does\line not have indexed instance variables, or if anlnteger is greater than the number of\line \expndtw5 indexed instance variables, report an error.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 basicAt: \b0 anlnteger \b put: \b0 anObject}\par \pard \plain \cbpat0\qj\li396\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Replace the object in the receiver at index position anlnteger\line with anObject. If the receiver does not have indexed instance variables, or if\line \expndtw2 anlnteger is greater than the number of indexed instance variables, report an error.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 basicHash}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the integer hash based on its hash field.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 basicSize}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the number of indexed instance variables in the receiver.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs20 become: anObject}\par \pard \plain \cbpat0\qj\li400\fi0\ri18\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 The receiver takes on the identity of anObject. All the objects that referenced the\line \expndtw4 receiver will now point to anObject.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 broadcast: \b0 aSymbol}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Send the argument aSymbol as a unary message to all of the receiver's dependents.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 broadcast: \b0 aSymbol \b with: \b0 anObject}\par \pard \plain \cbpat0\qj\li400\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Send the argument aSymbol as a keyword message with argument anObject to all\line \expndtw5 of the receiver's dependents.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 changed}\par \pard \plain \cbpat0\qj\li396\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 The receiver changed in some general way. Inform all dependents by sending each\line \expndtw4 dependent an update message.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb83\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 changed: \b0 aParameter}\par \pard \plain \cbpat0\qj\li410\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Something has changed releated to the dependents of the receiver. Send the\line \expndtw5 'update: aParameter' message to all the dependents.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb83\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 changed: \b0 firstParameter \b with: \b0 secondParameter}\par \pard \plain \cbpat0\qj\li407\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Something has changed releated to the dependents of the receiver. Send the\line \expndtw5 'update: firstParameter with: secondParameter' message to all the dependents.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2194\margrsxn2101\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs14 424      Object}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb328\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 changed: \b0 firstParameter}\par \pard \plain \cbpat0\ql\li601\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 with: \b0 secondParameter \b with: \b0 thirdParameter}\par \pard \plain \cbpat0\ql\li806\fi0\ri0\sb4\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Something has changed releated to the dependents of the receiver. Send the\line \expndtw-3 'update: firstParameter with: secondParameter' message to all the dependents.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 class}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Answer the class of the receiver.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 copy}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Answer a shallow copy of the receiver.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 deepCopy}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Answer a copy of the receiver with shallow copies of each instance variable.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 dependents}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Answer a collection of all dependents of the receiver.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb54\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 dependsOn: \b0 anObject}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Add the receiver to anObject's collection of dependents.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb90\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 doesNotUnderstand: \b0 aMessage}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Initiate a walkback because a message was sent which is not understood, i.e., there\line \expndtw-4 is no matching method.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 error: \b0 aString}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Create a walkback window describing an error condition with the error message\line \expndtw-3 aString in the window label.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 halt}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Initiate a walkback with 'halt encountered' message for debugging.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 hash}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Answer the integer hash value of the receiver. This is the default implementation\line \expndtw-3 which uses the object hash value assigned at the creation time.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 hash: \b0 anlnteger}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Set the hash value of the receiver to anlnteger.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 implementedBySubclass}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Initiate a walkback because a subclass doesn't implement a message that it should.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 inspect}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Open an inspector window on the receiver.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 invalidMessage}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Initiate walkback because inappropriate message was sent to the receiver.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 isKindOf: \b0 aClass}\par \pard \plain \cbpat0\ql\li785\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 Answer true if receiver is an instance of aClass or one of its subclasses, else answer\line \expndtw-8 false.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb68\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 isMemberOf: \b0 aClass}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Answer true if the receiver is an instance of aClass, else answer false.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 isNil}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Answer true if the receiver is the object nil, else answer false.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2522\margrsxn2155\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs16 Object      425}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb310\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-1\dn0\f3\cchs0\lang1033\fs20 notNil}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver is not the object nil, else answer false.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb72\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw0\dn0\f3\cchs0\lang1033\fs20 perform: \b0 aSymbol}\par \pard \plain \cbpat0\qj\li410\fi0\ri14\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Answer the result of sending a unary message to the receiver with selector aSymbol.\line \expndtw5 Report an error if the number of arguments expected by the selector is not zero.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb83\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 perform: \b0 aSymbol \b with: \b0 anObject}\par \pard \plain \cbpat0\qj\li403\fi0\ri7\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Answer the result of sending a binary message to the receiver with selector aSymbol\line \expndtw4 and argument anObject. Report an error if the number of arguments expected by\line \expndtw5 the selector is not one.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb101\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 perform: \b0 aSymbol \b with: \b0 firstObject \b with: \b0 secondObject}\par \pard \plain \cbpat0\qj\li403\fi0\ri7\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the result of sending a keyword message to the receiver with selector\line \expndtw5 aSymbol and arguments firstObject and secondObject. Report an error if the\line number of arguments expected by the selector is not two.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb79\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw0\dn0\f3\cchs0\lang1033\fs20 perform: \b0 aSymbol}\par \pard \plain \cbpat0\ql\li202\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 with: \b0 firstObject \b with: \b0 secondObject \b with: \b0 thirdObject}\par \pard \plain \cbpat0\qj\li403\fi0\ri4\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the result of sending a keyword message to the receiver with selector\line \expndtw5 aSymbol and arguments firstObject, secondObject and thirdObject. Report an\line \expndtw6 error if the number of arguments expected by the selector is not three.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw-1\dn0\f3\cchs0\lang1033\fs20 perform: \b0 aSymbol \b with Arguments: \b0 an Array}\par \pard \plain \cbpat0\qj\li400\fi0\ri11\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer the result of sending a message to the receiver with selector aSymbol and\line \expndtw4 arguments the elements of anArray. Report an error if the number of arguments\line expected by the selector is not equal to anArray size.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb83\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw1\dn0\f3\cchs0\lang1033\fs20 printOn: \b0 aStream}\par \pard \plain \cbpat0\qj\li403\fi0\ri11\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Append the ASCII representation of the receiver to aStream. This is the default\line \expndtw6 implementation which prints 'a' ('an') followed by the receiver class name.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb76\sa0 \f3\fs20{\b\i0\cf0\charscalex114\expndtw-1\dn0\f3\cchs0\lang1033\fs20 printString}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Answer a String that is an ASCII representation of the receiver.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex119\expndtw-1\dn0\f3\cchs0\lang1033\fs20 release}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Discard all dependents of the receiver, if any.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw1\dn0\f3\cchs0\lang1033\fs20 respondsTo: \b0 aSymbol}\par \pard \plain \cbpat0\qj\li400\fi0\ri11\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver class or one of its superclasses implements a method\line \expndtw4 with selector equal to aSymbol.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw0\dn0\f3\cchs0\lang1033\fs20 shallowCopy}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer a copy of the receiver which shares the receiver instance variables.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb97\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f2\cchs0\lang1033\fs18 size}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the number of indexed instance variables in the receiver.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex119\expndtw-3\dn0\f3\cchs0\lang1033\fs20 species}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer a class which is similar to (or the same as) the receiver class which can be\line \expndtw4 used for containing derived copies of the receiver.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw2\dn0\f3\cchs0\lang1033\fs20 storeOn: \b0 aStream}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 Append the ASCII representation of the receiver to aStream from which the\line \expndtw5 receiver can be reinstantiated.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2230\margrsxn2065\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs14 426     Object}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb295\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 storeString}\par \pard \plain \cbpat0\ql\li803\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer the receiver represented as a String from which it can be reconstructed.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb79\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 update: \b0 aParameter}\par \pard \plain \cbpat0\qj\li799\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 An object on whom the receiver is dependent has changed. The receiver updates\line \expndtw5 its status accordingly (the default behavior is to do nothing). The argument\line aParameter usually identifies the kind of update.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 update: \b0 firstParameter \b with: \b0 secondParameter}\par \pard \plain \cbpat0\qj\li796\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 An object on whom the receiver is dependent has changed. The receiver updates\line \expndtw3 its status accordingly (the default behavior is to do nothing). The argument\line firstParameter usually identifies the kind of update and the secondParameter is a\line \expndtw4 unary message defined in the receiver protocol.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb90\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 update: \b0 firstParameter}\par \pard \plain \cbpat0\ql\li605\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 with: \b0 secondParameter \b with: \b0 thirdParameter}\par \pard \plain \cbpat0\qj\li796\fi0\ri0\sb4\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 An object on whom the receiver is dependent has changed. The receiver updates\line \expndtw3 its status accordingly (the default behavior is to do nothing). The argument\line firstParameter usually identifies the kind of update and the secondParameter is a\line \expndtw4 unary message defined in the receiver protocol.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 yourself}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the receiver.}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 "" \i0 ** anObject}\par \pard \plain \cbpat0\qj\li796\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver and anObject do not compare equal (using =), else\line \expndtw1 answer false.}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb86\sa0\tlhyph\tx774 \f3\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 anObject}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver and anObject are not the same object, else answer false.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb274\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f2\cchs0\lang1033\fs24 OrderedCollection}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb212\sa29\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 An OrderedCollection can be used like a dynamic array, stack or queue. Unlike fixed size\line collections, an OrderedCollection can grow to accomodate more elements if the original\line \expndtw3 collection is not big enough.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2234\margrsxn4060\margtsxn1440\margbsxn720\cols2\colno1\colw2250\colsr371\colno2\colw2995 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Inherits From:}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Inherited By:}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 IndexedCollection Collection Object\line \expndtw2 Process SortedCollection}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2230\margrsxn2065\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li396\fi0\ri0\sb43\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 contents}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Contains an Array of objects included in the OrderedCollection.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 endPosition}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 Contains the contents index position of the last element of the collection. All\line \expndtw4 successive index positions (to contents size), are assumed to be empty.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 startPosition}\par \pard \plain \cbpat0\ql\li781\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs20 Contains the contents index position of the first element of the collection. All\line \expndtw5 preceding index positions (to contents position 1), are assumed to be empty.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2049\margrsxn2243\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs14 OrderedCollecdon      427}\par \pard \plain \cbpat0\ql\li414\fi-410\ri0\sb252\sa0\sl-317\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs20 Class Variables:\line \expndtw-2 (None)}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb191\sa0\tx2635 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Pool Dictionaries:{\charscalex100\expndtw0\tab }\expndtw-3 (None)}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Class Methods:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw15\dn0\f3\cchs0\lang1033\fs20 new}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer an instance of OrderedCollection capable of holding 12 elements initially.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb79\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 new: \b0 anlnteger}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer an initialized instance of OrderedCollection capable of holding anlnteger\line \expndtw5 number of elements.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Instance Methods:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 , aCollection}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer an OrderedCollection containing all the elements of the receiver followed\line \expndtw3 by all the elements of aCollection.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 add: \b0 anObject}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Add anObject after the last element of the receiver collection.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs20 add: \b0 newObject \b after: \b0 oldObject}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer newObject. Insert newObject immediately after the element oldObject in\line \expndtw5 the receiver collection. If oldObject is not in the collection, report an error.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw12\dn0\f3\cchs0\lang1033\fs20 add: \b0 anObject \b afterlndex: \b0 anlnteger}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Insert anObject at index position anlnteger + 1 in the receiver\line \expndtw5 collection. If anlnteger is out of the collection bounds, report an error.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 add: \b0 newObject \b before: \b0 oldObject}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer newObject. Insert newObject immediately before the element oldObject\line \expndtw5 in the receiver collection. If oldObject is not in the collection, report an error.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw12\dn0\f3\cchs0\lang1033\fs20 add: \b0 anObject \b beforelndex: \b0 anlnteger}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Insert anObject at index position anlnteger - 1 in the receiver\line collection. If anlnteger is out of the collection bounds, report an error.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 addAUFirst: \b0 aCollection}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer aCollection. Add all the elements contained in aCollection to the receiver\line \expndtw4 before its first element.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 addAULast: \b0 aCollection}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer aCollection. Add all the elements contained in aCollection to the receiver\line \expndtw5 after its last element.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb72\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 addFirst: \b0 anObject}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Add anObject before the first element of the receiver.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 addLast: \b0 anObject}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Add anObject after the last element of the receiver.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2329\margrsxn1966\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs14 428      OrderedCollection}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb328\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 after: \b0 anObject}\par \pard \plain \cbpat0\qj\li788\fi0\ri32\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the element that immediately follows anObject in the receiver collection.\line \expndtw6 If anObject is not an element of the receiver, report an error.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb90\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 after: \b0 anObject \b ifNone: \b0 aBlock}\par \pard \plain \cbpat0\qj\li788\fi0\ri18\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the element that immediately follows anObject in the receiver collection.\line \expndtw5 If anObject is not an element of the receiver, aBlock is evaluated (with no\line \expndtw2 arguments).}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 at: \b0 anlnteger}\par \pard \plain \cbpat0\qj\li788\fi0\ri25\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the element of the receiver at index position anlnteger. If anlnteger is an\line \expndtw5 invalid index for the receiver collection, report an error.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb90\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 at: \b0 anlnteger \b put: \b0 anObject}\par \pard \plain \cbpat0\qj\li785\fi0\ri14\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Replace the element of the receiver at index position anlnteger\line \expndtw1 with the anObject. If anlnteger is an invalid index for the receiver collection, report\line \expndtw5 an error.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb104\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 before: \b0 anObject}\par \pard \plain \cbpat0\qj\li788\fi0\ri29\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer the element that immediately precedes anObject in the receiver collection.\line \expndtw6 If anObject is not an element of the receiver, report an error.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 before: \b0 anObject \b ifNone: \b0 aBlock}\par \pard \plain \cbpat0\qj\li781\fi0\ri14\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer the element that immediately precedes anObject in the receiver collection.\line \expndtw5 If anObject is not an element of the receiver, aBlock is evaluated (with no\line \expndtw3 arguments).}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 copyFrom: \b0 beginning \b to: \b0 end}\par \pard \plain \cbpat0\qj\li778\fi0\ri14\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer an OrderedCollection containing the elements of the receiver from index\line \expndtw4 position beginning through index position end.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs20 do: \b0 aBlock}\par \pard \plain \cbpat0\qj\li785\fi0\ri18\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer the receiver. For each element in the receiver, evaluate aBlock with that\line \expndtw5 element as the argument.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb97\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 includes: \b0 anObject}\par \pard \plain \cbpat0\qj\li781\fi0\ri11\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer true if the receiver contains an element equal to anObject, else answer\line \expndtw-1 false.}\par \pard \plain \cbpat0\ql\li389\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 remove: \b0 anObject \b ifAbsent: \b0 aBlock}\par \pard \plain \cbpat0\qj\li785\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Answer anObject. Remove the element anObject from the receiver collection. If\line \expndtw0 anObject is not an element of the receiver, aBlock is evaluated (with no arguments).}\par \pard \plain \cbpat0\ql\li389\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 removeFirst}\par \pard \plain \cbpat0\qj\li781\fi0\ri22\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Remove and answer the first element of the receiver. If the collection is empty,\line \expndtw6 report an error.}\par \pard \plain \cbpat0\ql\li385\fi0\ri0\sb79\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 removelndex: \b0 anlnteger}\par \pard \plain \cbpat0\qj\li781\fi0\ri22\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Answer the receiver. Remove the element of the receiver at index position\line anlnteger. If anlnteger is an invalid index for the receiver, report an error.}\par \pard \plain \cbpat0\ql\li385\fi0\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 removeLast}\par \pard \plain \cbpat0\qj\li781\fi0\ri22\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Remove and answer the last element of the receiver. If the collection is empty,\line \expndtw5 report an error.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2259\margrsxn2011\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs16 Pane      429}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb331\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex103\expndtw7\dn0\f3\cchs0\lang1033\fs20 replaceFrom: \b0 start \b to: \b0 stop \b with: \b0 aCollection}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa50\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw0\dn0\f3\cchs0\lang1033\fs20 Answer a new OrderedCollection containing the receiver whose elements at index\line \expndtw2 position start through stop have been replaced by the elements of aCollection.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2673\margrsxn3004\margtsxn1440\margbsxn720\cols2\colno1\colw720\colsr0\colno2\colw5839 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 size}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb241\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Answer the number of elements contained by the receiver collection.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2259\margrsxn2011\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li25\fi0\ri0\sb284\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-13\dn0\f2\cchs0\lang1033\fs24 Pane}\par \pard \plain \cbpat0\qj\li0\fi0\ri11\sb209\sa194\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw-1\dn0\f3\cchs0\lang1033\fs20 Class Pane is an abstract class which provides the common protocol for all its subclasses. A\line \expndtw3 pane is a subarea of a window. It is responsible for displaying a portion of its contents in\line \expndtw4 a designated area on the display screen. It is one of the three major elements (pane,\line \expndtw-2 dispatcher, and application model) of a window application. Each pane is associated with one\line \expndtw2 dispatcher. All the panes of a window are normally tied to one application model.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2270\margrsxn2821\margtsxn1440\margbsxn720\cols2\colno1\colw1220\colsr1397\colno2\colw4201 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Inherits From:}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw0\dn0\f3\cchs0\lang1033\fs20 Inherited By:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Object}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb202\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 GraphPane ListPane SubPane TextPane TopPane}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2259\margrsxn2011\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li14\fi0\ri0\sb194\sa0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb94\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 curFont}\par \pard \plain \cbpat0\ql\li410\fi392\ri0\sb4\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw3\dn0\f3\cchs0\lang1033\fs20 Contains the current font used in the pane.\line \b\charscalex100\expndtw4\fs22 dispatcher}\par \pard \plain \cbpat0\ql\li407\fi396\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Contains the dispatcher associated with the pane object,\line \expndtw19 frame}\par \pard \plain \cbpat0\ql\li803\fi0\ri0\sb4\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Contains the Rectangle on the display screen into which the pane object can display}\par \pard \plain \cbpat0\ql\li407\fi396\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw0\dn0\f3\cchs0\lang1033\fs20 its contents.\line \b\charscalex100\expndtw4\fs22 framingBlock}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 Contains a block of code which computes the frame rectangle of the pane based}\par \pard \plain \cbpat0\ql\li407\fi396\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw3\dn0\f3\cchs0\lang1033\fs20 on an argument representing the pane's outer frame.\line \b\charscalex100\expndtw2\fs22 model}\par \pard \plain \cbpat0\ql\li403\fi396\ri0\sb4\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Contains the application model that controls this pane object.\line \b\charscalex100\expndtw4\fs22 paneMenuSelector}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 Contains a no-argument message selector which, when invoked, answers a Menu}\par \pard \plain \cbpat0\ql\li400\fi403\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw0\dn0\f3\cchs0\lang1033\fs20 customized for the pane.\line \b\charscalex100\expndtw5\fs22 paneScanner}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw3\dn0\f3\cchs0\lang1033\fs20 Contains a StringBlt which is responsible for all the output to the borders form}\par \pard \plain \cbpat0\ql\li407\fi410\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw1\dn0\f3\cchs0\lang1033\fs20 (refer to class TopPane) and transfer from the borders form to the display screen.\line \b\charscalex100\expndtw4\fs22 subpanes}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Contains an OrderedCollection of subpanes which are under the control of this Pane}\par \pard \plain \cbpat0\ql\li410\fi389\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw-2\dn0\f3\cchs0\lang1033\fs20 object.\line \b\charscalex100\expndtw2\fs22 superpane}\par \pard \plain \cbpat0\ql\li803\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw2\dn0\f3\cchs0\lang1033\fs20 Contains the parent pane that controls this pane object. Note that a TopPane has}\par \pard \plain \cbpat0\ql\li803\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex103\expndtw0\dn0\f3\cchs0\lang1033\fs20 no superpane.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2282\margrsxn2013\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 430     Pane}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb295\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 Class Variables:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 WindowClip}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Contains the clipping Rectangle of the display screen to update following the move\line \expndtw-5 or a close of a window.\line \b\expndtw2 ZoomedPane}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa180\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Contains the TextPane currently being zoomed.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2286\margrsxn6272\margtsxn1440\margbsxn720\cols2\colno1\colw1479\colsr1152\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 Pool Dictionaries:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-12\dn0\f3\cchs0\lang1033\fs22 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2282\margrsxn2013\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb184\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f3\cchs0\lang1033\fs22 Class Methods:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb72\sa0\sl-223\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 initWindowClip}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-223\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Reinitialize the clipping rectangle of redrawing windows to be the whole display\line screen.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 new}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Answer a new pane.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 windowClip}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Answer the clipping rectangle for redrawing windows.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 windowClip: \b0 aRectangle}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Set the clipping rectangle for redrawing windows to aRectangle.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb180\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Instance Methods:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 activatePane}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Mark the dispatcher of the receiver pane as active.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 border}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Draw a border around the receiver frame.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 border: \b0 aRectangle}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Draw two lines around aRectangle. The outside one has the foreground color and\line \expndtw-3 the inside one the background color.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\s