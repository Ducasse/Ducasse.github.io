, do nothing since it has no color.}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 set Width: \b0 wlnteger \b height: \b0 hlnteger}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs20 Set  the  width  and  height  of the  display  screen  to  wlnteger  and  hlnteger\line \expndtw0 respectively.}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb288\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-11\dn0\f2\cchs0\lang1033\fs24 Dos}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb198\sa22\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Class Dos allows DOS interrupt calls or interface with I/O ports directly from Smalltalk code.\line \expndtw2 It contains an Array of registers whose values are loaded into machine registers prior to the\line \expndtw4 call. Upon return from the call, the values in the registers reflect the machine state at the\line \expndtw7 end of the interrupt or I/O port call.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2043\margrsxn6532\margtsxn1440\margbsxn720\cols2\colno1\colw1224\colsr1390\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb14\sa0\sl-436\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Inherits From:\line \expndtw3 Inherited By:}\par \column \pard \plain \cbpat0\ql\li11\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Object\line \expndtw-4 (None)}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2464\margrsxn1841\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f2\cchs0\lang1033\fs14 372     Dos}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb320\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb97\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex117\expndtw-1\dn0\f3\cchs0\lang1033\fs20 registers}\par \pard \plain \cbpat0\qj\li796\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Contains an Array of 17 elements. The first 16 are AH, AL, BH, BL, CH, CL,\line \expndtw4 DH, DL, SI(H), SI(L), DI(H), DI(L), DS(H), DS(L), ES(H), ES(L). The 17th\line \expndtw5 element is the flag register.}\par \pard \plain \cbpat0\ql\li418\fi-418\ri0\sb126\sa187\sl-320\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs20 Class Variables:\line \expndtw-2 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2471\margrsxn6089\margtsxn1440\margbsxn720\cols2\colno1\colw1476\colsr1152\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Pool Dictionaries:}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs20 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2464\margrsxn1841\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs20 Class Methods:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex111\expndtw0\dn0\f3\cchs0\lang1033\fs20 checkDosError: \b0 registers}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Generate a walkback if the carry flag is set in registers. The error code is obtained\line \expndtw5 from AL in registers.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 dosError: \b0 aninteger}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Initiate a walkback for a DOS error described by aninteger.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb83\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex111\expndtw2\dn0\f3\cchs0\lang1033\fs20 environmentVariable: \b0 aString}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Answer a String which is the value of DOS environment variable aString if the\line \expndtw3 variable exists, else answer nil.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb86\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw14\dn0\f3\cchs0\lang1033\fs20 new}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer a new instance of Dos.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Instance Methods:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb86\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 call: \b0 aPoint}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 Far call to seg @ offset}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 dosPrimitive: \b0 function}\par \pard \plain \cbpat0\ql\li594\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 registers: \b0 an Array \b value: \b0 aninteger}\par \pard \plain \cbpat0\qj\li792\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Perform a DOS function with an immediate value aninteger and registers in\line \expndtw8 anArray. Functions are: interrupt = 0 in Word = 1 inByte = 2 outWord = 3\line \expndtw16 outByte = 4 peek = 5 poke = 6 blockMove = 7 farCall = 8}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex117\expndtw-2\dn0\f3\cchs0\lang1033\fs20 initialize}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Initialize registers.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb83\sa0 \f3\fs20{\b\i0\cf0\charscalex111\expndtw1\dn0\f3\cchs0\lang1033\fs20 interrupt: \b0 aninteger}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Issue software interrupt number aninteger.}\par \pard \plain \cbpat0\ql\li796\fi-400\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 outByte: \b0 byte Value \b toPort: \b0 portAddress\line \expndtw1 Output byte Value to portAddress.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb76\sa0 \f3\fs20{\b\i0\cf0\charscalex111\expndtw2\dn0\f3\cchs0\lang1033\fs20 peekFrom: \b0 aPoint}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs20 Answer the byte value at address aPoint (x = segment, y \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  offset).}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 poke: \b0 aByte \b to: \b0 aPoint}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs20 Store aByte into address aPoint (x = segment, y = offset).}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2083\margrsxn2183\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs16 False     373}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb292\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 registers}\par \pard \plain \cbpat0\ql\li814\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the register array.}\par \pard \plain \cbpat0\ql\li814\fi-389\ri0\sb90\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 setPaletteRegister: \b0 anlnteger \b to: \b0 aColor\line \expndtw-4 Set palette register anlnteger to aColor.}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 setReg: \b0 reglnteger \b to: \b0 anObject}\par \pard \plain \cbpat0\ql\li814\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Set register reglnteger to anObject. AX = O, BX = 1, CX = 2, DX = 3, SI = 4,\line \expndtw3 DI = 5, DS=6, ES = 7}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb101\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 setRegHigh: \b0 reglnteger \b to: \b0 vallnteger}\par \pard \plain \cbpat0\ql\li810\fi0\ri0\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Set the high byte of register reglnteger to vallnteger. AX = O, BX = 1, CX = 2,\line \expndtw1 DX = 3, SI = 4, DI = 5, DS=6, ES = 7}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb97\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 setRegLow: \b0 reglnteger \b to: \b0 vallnteger}\par \pard \plain \cbpat0\ql\li810\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Set the low byte of register reglnteger to vallnteger. AX = 0, BX = 1, CX = 2,\line \expndtw5 DX = 3, SI = 4, DI = 5, DS=6, ES=7}\par \pard \plain \cbpat0\ql\li29\fi0\ri0\sb292\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs24 EmptySlot}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb209\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 This class represents a deleted element in certain hashed systeni data structures. There is\line \expndtw4 only a single instance.}\par \pard\pl