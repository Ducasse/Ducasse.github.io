\ql\li799\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Draw a dragon pattern where aninteger is the recursion factor.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 mandala}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Draw a mandala.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 multiEllipse}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Draw 5 ellipses.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 multiMandala}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Draw 8 mandalas.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb65\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 multiPentagon}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Draw multiple pentagons.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb54\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 multiPolygon: \b0 aninteger}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Draw mutiple polygons where each polygon has aninteger number of sides.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 multiSpiral}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Draw 4 spirals.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 run}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Initialize and start the animation demonstration.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb68\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 walkLine}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Draw a rotating line.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb284\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs24 Dictionary}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb212\sa32\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 A Dictionary is a collection of key/value pairs of objects. The keys in a dictionary are unique,\line \expndtw1 whereas values may be duplicated. A Dictionary may be searched either by key or by value.\line \expndtw4 Key searches use hashing for efficiency. Elements may be entered into and extracted from\line \expndtw5 a dictionary either as a pair of objects (e.g., atrput:) or as an Association (e.g., add:).\line \expndtw3 Internally, a Dictionary stores the key /value pairs as a set of associations whereas an\line \expndtw13 IdentityDictionary stores the key/value pairs in successive array elements (see\line \expndtw0 Identity Dictionary).}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2282\margrsxn2359\margtsxn1440\margbsxn720\cols2\colno1\colw2246\colsr367\colno2\colw4654 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Inherits From:\line \expndtw3 Inherited By:}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables:}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb58\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 contents}\par \pard \plain \cbp