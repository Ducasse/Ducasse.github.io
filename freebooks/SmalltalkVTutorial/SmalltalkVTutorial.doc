ain \cbpat0\ql\li11\fi0\ri0\sb0\sa0\sl-443\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 OrderedCollection IndexedCollection Collection Object\line \expndtw-1 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2197\margrsxn2079\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li425\fi0\ri0\sb101\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 contents}\par \pard \plain \cbpat0\ql\li428\fi403\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 (From class OrderedCollection)\line \b\expndtw4\fs22 endPosition}\par \pard \plain \cbpat0\ql\li428\fi407\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 (From class OrderedCollection)\line \b\expndtw4\fs22 sortBlock}\par \pard \plain \cbpat0\ql\li828\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Contains the block of code such that when it is evaluated for a pair of elements,\line \expndtw4 it dictates which element comes first in the SortedCoUection.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2226\margrsxn2061\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs14 456      SortedCollection}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb299\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 startPosition}\par \pard \plain \cbpat0\ql\li810\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 (From class OrderedCollection)}\par \pard \plain \cbpat0\ql\li414\fi-410\ri0\sb137\sa187\sl-317\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs20 Class Variables:\line \expndtw-2 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2230\margrsxn6331\margtsxn1440\margbsxn720\cols2\colno1\colw1483