\ql\li396\fi0\ri0\sb79\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs20 fork: \b0 forkBlock at: aPriority}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Create a new process to execute forkBlock and schedule it at priority priority.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb54\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 highUserPriority}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the highest priority for a user process.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex109\expndtw-2\dn0\f2\cchs0\lang1033\fs20 initialize}\par \pard \plain \cbpat0\qj\li796\fi0\ri7\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Initialize the receiver by discarding all processes and then creating a new user\line \expndtw2 interface process.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 lowUserPriority}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the lowest priority for a user process.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs20 resume: aProcess}\par \pard \plain \cbpat0\qj\li792\fi0\ri14\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Add aProcess to the process scheduler's queue of ready processes. If aProcess has\line \expndtw5 the highest priority, make it the current process.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb86\sa0\sl-220\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 schedule}\par \pard \plain \cbpat0\qj\li792\fi0\ri25\sb0\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Schedule the highest priority ready process, or if none, create the idle process.\line \expndtw3 Called with interrupts disabled.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 suspendActive}\par \pard \plain \cbpat0\qj\li792\fi0\ri11\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Suspend the active process and schedule the highest priority ready process, if any.\line \expndtw5 Called with interrupts disabled and CurrentProcess already entered in proper\line \expndtw2 waiting queue.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb61\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 topPriority}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Answer the highest allowable priority for system processes.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb58\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 userPriority}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Answer the priority of the user interface process.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb94\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f2\cchs0\lang1033\fs20 yield}\par \pard \plain \cbpat0\qj\li792\fi0\ri11\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Give other processes at the priority of the currently running process a chance to\line \expndtw3 run.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2246\margrsxn2045\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li22\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs14 444      PromptEditor}\par \pard \plain \cbpat0\ql\li36\fi0\ri0\sb281\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs24 PromptEditor}\par \pard \plain \cbpat0\qj\li18\fi0\ri0\sb205\sa22\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 A PromptEditor processes input for its associated TextPane in a Prompter. Its allowed input\line is more restrictive than a TextEditor. It will not give up control until the user either accepts\line \expndtw1 or cancels the Prompter. The user response is accepted by either pressing the carriage-return\line \expndtw6 key or selecting the accept item from the menu.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2264\margrsxn3136\margtsxn1440\margbsxn720\cols2\colno1\colw2250\colsr364\colno2\colw3895 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb7\sa0\sl-436\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs20 Inherits From:}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-436\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Inherited By:}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-436\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 Named Instance Variables:}\par \column \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa0\sl-439\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 TextEditor ScrollDispatcher Dispatcher Object\line \expndtw-2 (None)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2246\margrsxn2045\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li418\fi0\ri0\sb54\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 active}\par \pard \plain \cbpat0\qj\li414\fi407\ri4813\sb0\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 (From class Dispatcher)\line \b\expndtw3\fs22 modified}\par \pard \plain \cbpat0\qj\li410\fi410\ri4824\sb4\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 (From class TextEdit