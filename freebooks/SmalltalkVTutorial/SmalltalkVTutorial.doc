}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb709\sa0\sl-133\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs14 "Dratt a polygon flower"}\par \pard \plain \cbpat0\ql\li7\fi130\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f17\cchs0\lang1033\fs12 sides length !\line sides := 5.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-11\dn0\f17\cchs0\lang1033\fs12 length \dbch\af17\loch\af16\hich\f16\cchs0 \u9632\'3f\hich\af16\dbch\af17\loch\f16\cchs0 '= 248 \i // \i0 sides.\line \expndtw-7 Turtle}\par \pard \plain \cbpat0\ql\li274\fi0\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-12\dn0\f17\cchs0\lang1033\fs12 black;\line ho\loch\af16\hich\af16\dbch\f17\cchs0 \'ab\hich\af16\dbch\af17\loch\f16\cchs0 e;\line north.}\par \pard \plain \cbpat0\ql\li277\fi-266\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f17\cchs0\lang1033\fs12 sides \b tinesRepeat: \b0 [\line \expndtw-7 Turtle\line \expndtw-14 up;}\par \pard \plain \cbpat0\ql\li540\fi0\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-13\dn0\f17\cchs0\lang1033\fs12 go*. length//2:\line \expndtw-11 down;}\par \pard \plain \cbpat0\ql\li540\fi0\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f17\cchs0\lang1033\fs12 go: length.}\par \pard \plain \cbpat0\ql\li547\fi-274\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f17\cchs0\lang1033\fs12 sides - \b 1 tiaesRepeat: \b0 [\line \expndtw-7 Turtle}\par \pard \plain \cbpat0\ql\li806\fi0\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f17\cchs0\lang1033\fs12 turn: 368 \loch\af16\hich\af16\dbch\f17\cchs0 \'95\hich\af16\dbch\af17\loch\f16\cchs0 / sides;\line \expndtw-7 go: length]]}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2564\margrsxn1741\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li385\fi0\ri0\sb184\sa0\sl-212\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 Figure 3.1\line \expndtw-5 Polygon Flower}\par \pard \plain \cbpat0\ql\li22\fi0\ri0\sb457\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs28 What YouVe Now Learned}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb205\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 At this point, you should be familiar with:}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb151\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb151\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 simple objects}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 simple messages}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 unary, keyword, and binary (including arithmetic) messages}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 messages inside of other messages}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 message series}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 cascaded messages}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 temporary and global variables}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 assignment expressions}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 return expressions}\par {\pntext\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0\tx702 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent292\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 comments}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2410\margrsxn1892\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-1040\posnegy0\absw0\absh1800\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw914\pich3175\picwgoal518\pichgoal1800\jpegblip
}\par\pard \plain \cbpat0\qr\li0\fi0\ri0\sb450\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs16 Chapter 3: Objects and Messages    \i0 .5.5}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb320\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 If you want to review any of these topics, simply refer back to the appropriate section in\line \expndtw1 this chapter. Of course, Part 3 describes all of these topics in greater detail.}\par \pard \plain \cbpat0\qj\li4\fi0\ri0\sb144\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Here's one final point which you can think about as you proceed on to the following\line \expndtw-1 tutorials. As we mentioned, Turtle, which you have been using throughout this tutorial,\line \expndtw-3 is a global variable. You have been able to use this variable in a number of different\line situations, without knowing anything about its internal contents. This is a unique feature\line of Smalltalk; you can use an object simply by knowing its \i external behavior, \i0 without\line \expndtw-4 knowing anything of its \i internal behavior. \i0 You'll see further examples \i oi \i0 this throughout\line \expndtw-1 the following tutorials.}\par \pard \plain \cbpat0\qj\li4\fi0\ri11\sb144\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Now that you've learned the above topics, you can proceed on to the next tutorial:\line \expndtw-1 control structures.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn754\margrsxn11155\margtsxn1440\margbsxn720 {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2083\margrsxn2191\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li25\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs30 4 CONTROL STRUCTURES}\par \pard \plain \cbpat0\qj\li14\fi0\ri14\sb446\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 In the previous tutorial, you learned some of Smalltalk's basic expressions. But like any\line \expndtw-2 language, Smalltalk cannot do much unless it can make decisions: evaluate a condition\line \expndtw-3 and perform an action based on the result, or repeat actions a specified or unspecified\line \expndtw-5 number of times. This chapter introduces you to Smalltalk's \i conditional expressions \i0 and\line \i control structures, \i0 which perform these tasks.}\par \pard \plain \cbpat0\qj\li18\fi0\ri22\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 As always, you can access the examples for this tutorial \i if \i0 you do not want to type them\line \expndtw0 in. Simply use the Disk Browser to retrieve the contents of the file \b chapter.4.}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb371\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs26 Comparing Objects}\par \pard \plain \cbpat0\qj\li11\fi0\ri18\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Smalltalk compares objects by sending messages. The normal comparisons of \i K, \i0 <!=,\line =, >=, >, and \i ~\super s\nosupersub = \i0 are implemented as binary messages. For example, evaluate these\line \expndtw-6 expressions:}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb137\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw66\dn0\f3\cchs0\lang1033\fs22 3<4}\par \pard \plain \cbpat0\ql\li436\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw66\dn0\f3\cchs0\lang1033\fs22 #(12\expndtw0  \expndtw23 34) = #(1 2 3 4)}\par \pard \plain \cbpat0\qj\li29\fi0\ri18\sb151\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 All objects understand equality, =. Many objects also define the relational operators, or\line \i\expndtw-8 ordering messages, \i0 as in these examples:}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb133\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs22 'hello' \b0 <= \b 'goodbye'}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Since these comparison messages are binary messages, parentheses are often needed if\line there are other binary messages in the expression. For example, evaluate the following\line \expndtw-1 expression with and without parentheses:}\par \pard \plain \cbpat0\ql\li14\fi407\ri0\sb36\sa0\sl-389\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw25\dn0\f3\cchs0\lang1033\fs22 5 - (2 + 3)\line \expndtw-5 As you have seen from evaluating these examples, comparisons return either \b true \b0 or \b false.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb360\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs26 Testing Objects}\par \pard \plain \cbpat0\qj\li11\fi0\ri22\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Many objects understand messages that let you test something about their state or\line \expndtw-2 condition. For example, evaluate these expressions:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb148\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 $a isUpperCase\line \expndtw1 ('hello' at: 1) isVowel\line \b0\expndtw0 7 \b odd}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb133\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 These messages return \b true \b0 or \b false \b0 as well.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2592\margrsxn1688\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li22\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 38    Chapter 4: Control Structures}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb353\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs26 Conditional Execution}\par \pard \plain \cbpat0\qj\li7\fi0\ri22\sb230\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Most languages use \b if \b0 statements to conditionally execute a series of statements.\line \expndtw-2 Smalltalk uses blocks of code and messages to do the same thing. For example, look at\line \expndtw0 this expression, which computes the greater of two numbers:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 I \b max a b \b0 I\line \b a \b0 :\super ss:\nosupersub  \b 5 squared,\line \expndtw2 b := 4 factorial,\line \expndtw35 a <b}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 ifTrue: [max \b0 := \b b]}\par \pard \plain \cbpat0\ql\li425\fi374\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 ifFalse: [max \b0 := \b a].\line \b0\scaps\expndtw-16 a \scaps0\b max}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb148\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The comparison message \b a \b0 < \b b \b0 returns either \b true \b0 or \b false, \b0 which then becomes the\line \expndtw-3 receiver of the \b ifTrue:ifFalse: \b0 message. It, in turn, executes the corresponding block of\line \expndtw-5 code.}\par \pard \plain \cbpat0\qj\li7\fi0\ri22\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 As you have seen, all messages return a result. The \b ifTrue:i\loch\af1\hich\af1\dbch\f3\cchs0 \'a3\hich\af1\dbch\af3\loch\f1\cchs0 False: \b0 message, like any\line \expndtw-2 message, also returns a result. Evaluate the following expression:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb137\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw69\dn0\f3\cchs0\lang1033\fs22 3<4}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 ifTrue: ['the true block']\line \expndtw-1 ifFalse: ['the false block']}\par \pard \plain \cbpat0\qj\li4\fi0\ri18\sb151\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The message \b ifTrue-.ifFalse: \b0 returns the result of the last expression in the block that it\line \expndtw0 executes. Let's look at another example:}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 I \b string index c I\line \expndtw5 string := 'Now is the time',\line \expndtw8 index := 1.}\par \pard \plain \cbpat0\qj\li788\fi-400\ri4860\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 string size timesRepeat: [\line \expndtw-4 c :\loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  string at: index,\line \expndtw-1 string}\par \pard \plain \cbpat0\ql\li1184\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 at: index\line \expndtw-7 put:}\par \pard \plain \cbpat0\ql\li1598\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 (c is Vowel}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20\pvpara\phcol\posnegx2783\posnegy-43\absw1533\absh-486\dfrmtxtx40\dfrmtxty0 {\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 c asUpperCase]\line \expndtw-6 c asLowerCase]).}\par \pard \plain \cbpat0\ql\li1984\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 ifTrue:\line \expndtw-10 ifFalse:}\par \pard \plain \cbpat0\ql\li410\fi385\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs22 index := index + 1\line \b0\scaps\expndtw-8 a \scaps0\b string}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The above example converts all consonants to lower case and all vowels to upper case,\line \expndtw2 using the \b c is Vowel \b0 test on each letter to find out which to do.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2370\margrsxn1921\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 Chapter 4: Control Structures    39}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb328\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The other messages that execute a block of code conditionally are \b ifTrue:, ifFalse:, and\line \expndtw-7 ifFalse:ifTrue:\b0 .}\par \pard \plain \cbpat0\ql\li25\fi0\ri0\sb374\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-13\dn0\f2\cchs0\lang1033\fs28 Boolean Expressions}\par \pard \plain \cbpat0\qj\li7\fi0\ri7\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The examples so far have depended on single comparison or testing messages, such as\line \expndtw-3 <C or \b is Vowel. \b0 But often you need to perform a compound test. To do so, you use the\line \b\expndtw-2 and: \b0 and or: messages. For example, look at the following code fragment, which tests\line \expndtw0 whether a character is not a digit:}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb151\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw14\dn0\f3\cchs0\lang1033\fs22 ( c < $0 \b or: \b0 [ c > $9 \b ] \b0 )}\par \pard \plain \cbpat0\qj\li4\fi0\ri14\sb137\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The receiver of the \b or: \b0 message \i is \i0 the result of the first comparison, either \b true \b0 or \b false.\line \b0\expndtw-1 The argument is a block of code whose last expression also returns \b true \b0 or \b false. \b0 The\line \b\expndtw-2 and: \b0 message works in the same way:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb144\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw17\dn0\f3\cchs0\lang1033\fs22 ( c >= $0 \b and: \b0 [ c <= $9 \b ] \b0 )}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb137\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 To see how this is used in a complete example, evaluate this expression:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 "compute the value of the first integer in a string"}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 I string index answer c I}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 string \b0 := '1234 \b is the number'.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 answer : = 0.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 index := 1.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 string size timesRepeat: [}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 c :\loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  string at: index.}\par \pard \plain \cbpat0\ql\li1188\fi-389\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs22 (c < $0 or: [c > $9])\line \expndtw-1 ifTrue: \scaps [a\scaps0 answer].}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 answer := answer * 10}\par \pard \plain \cbpat0\ql\li1213\fi0\ri0\sb4\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 + c asciiValue \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  $0 asciiValue.}\par \pard \plain \cbpat0\ql\li418\fi374\ri0\sb0\sa0\sl-227\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs22 index \b0 := \b index + l].\line \b0\scaps\expndtw-13 a \scaps0\b answer}\par \pard \plain \cbpat0\qj\li0\fi0\ri25\sb173\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Notice the return expression \b ifTrue: \scaps [a\scaps0 answer] \b0 in the middle of the above example.\line This exits the expression as soon as the first non digit is encountered.}\par \pard \plain \cbpat0\qj\li0\fi0\ri22\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 You can perform more complex tests by nesting the expressions. For example, look at\line \expndtw-4 the following fragment, which tests if a character is a digit or one of the letters from A-F.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb137\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs22 ( c \b isDigit or: [ c >= $A and: [ c <= $F ] ] )}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2434\margrsxn360\margtsxn1440\margbsxn720\cols2\colno1\colw7617\colsr778\colno2\colw720 \pard \plain \cbpat0\ql\li18\fi0\ri0\sb536\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs16 60    Chapter 4: Control Structures}\par \pard \plain \cbpat0\ql\li22\fi0\ri0\sb331\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-14\dn0\f2\cchs0\lang1033\fs28 Looping Messages}\par \pard \plain \cbpat0\qj\li4\fi0\ri0\sb216\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 You've already seen one simple looping message, \b timesRepeat:. \b0 Here's a simple\line \expndtw0 expression that uses another simple looping message to copy a file:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb137\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 "copy a disk file"}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 I input output I}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 input : = File pathName: 'go'.}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 output := File pathName: 'junk'.}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 [input atEnd]}\par \pard \plain \cbpat0\ql\li392\fi403\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 whileFalse: [output nextPut: input next],\line \expndtw0 input close,\line \expndtw1 output close}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 You may have noticed the message \b atEnd \b0 in the above example. This message returns\line \b\expndtw-2 true \b0 when there are no more characters to read from the input file stream; otherwise, it\line \expndtw-3 returns \b fake. \b0 The input file stream is read with the \b next \b0 message, which returns the next\line character in the file. The output file stream is written with the \b nextPut: \b0 message, which\line \expndtw1 writes its argument to the output.}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb148\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The message \b whileFalse: \b0 is sent to a block of code with another block of code as an\line \expndtw-4 argument. The message repeatedly evaluates its receiver block for as long as the argument\line \expndtw-2 is \b false. \b0 When the receiver block evaluates to \b true, \b0 the expression closes the input and\line output files.}\par \pard \plain \cbpat0\qj\li4\fi0\ri7\sb144\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 As you might expect, Smalltalk also provides a corresponding \b whileTrue: \b0 message. To\line \expndtw0 see it, look at this graphical example, which uses \b Turtle \b0 to draw some polygons:}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 "draw several polygons"\line \expndtw-7 I sides I\line \expndtw6 sides := 3.\line \expndtw14 [sides <= 6]\line \expndtw0 whileTrue: [}\par \pard \plain \cbpat0\ql\li1580\fi-396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 sides timesRepeat: [\line \expndtw-3 Turtle}\par \pard \plain \cbpat0\ql\li1980\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 go: 60;}\par \pard \plain \cbpat0\ql\li1188\fi788\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 turn: 360 // sides],\line \expndtw12 sides := sides + l]}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-425\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn7\f2\cchs0\lang1033\fs60 1}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2271\margrsxn2006\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri29\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 Chapter 4: Control Structures    61}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb353\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f2\cchs0\lang1033\fs26 Simple Iterators}\par \pard \plain \cbpat0\qj\li7\fi0\ri18\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The Turtle example above increases the temporary variable sides from 3 to 6 by 1, and\line \expndtw-4 evaluates some code for each value along the way. Like most other languages, Smalltalk\line \expndtw0 provides iteration statements to do this more easily. For example, here's the same\line \expndtw-1 expression, using one such iteration statement:}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "draw several polygons"\line \expndtw0 3 to: 6 do: [ :sides I\line \expndtw-3 sides timesRepeat: [\line Turtle}\par \pard \plain \cbpat0\ql\li1588\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 go: 60;}\par \pard \plain \cbpat0\ql\li1588\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 turn: 360 // sides]]}\par \pard \plain \cbpat0\qj\li11\fi0\ri14\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The iteration message is \b to:do:, \b0 which has two arguments. It takes the receiver object, 3,\line \expndtw-2 as the lower limit of the iteration, and uses the first argument, 6, as the upper limit. The\line \expndtw0 second argument is a block of code, which itself uses a block argument, \b sides, \b0 to draw\line \expndtw-3 a polygon with \b sides \b0 number of sides. The iteration message assigns the values 3 thru 6\line \expndtw0 successively to the block argument, evaluating the block for each value.}\par \pard \plain \cbpat0\qj\li7\fi0\ri18\sb151\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 The \b to:do: \b0 message uses an increment of one. But you can also specify your own\line \expndtw-1 increment by using the \b to:by:do: \b0 message, as in this example:}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 "compute the sum of 1/2, 5/8, 3/4, 7/8, 1"}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex65\expndtw11\dn0\f3\cchs0\lang1033\fs26 I sum I}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs22 sum \b0 := 0.}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 1/2 \b to: \b0 1 \b by: \b0 1/8 \b do: \b0 [ :i I}\par \pard \plain \cbpat0\ql\li425\fi371\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs22 sum \b0 := \b sum \b0 + i].\line \scaps\expndtw-16 a \scaps0\b sum}\par \pard \plain \cbpat0\qj\li11\fi0\ri25\sb155\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The first argument, 1, is the upper limit, while the second argument, 1/8, is the\line \expndtw-5 increment.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb378\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs26 Block Arguments}\par \pard \plain \cbpat0\qj\li4\fi0\ri4\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 As you can see from the last example, a block argument is declared in the first part of\line \expndtw-2 the block, preceded by a colon, :, and separated from the statements in the block by a\line \expndtw0 vertical bar, I. For example, here's a block with one argument:}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb133\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 [ \b xharacter \b0 I \b character is Vowel ]}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb151\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 In this example, the block argument is \b character. \b0 Block arguments are a kind of\line \expndtw-1 temporary variable, but do not have to be declared at the beginning of the expression\line \expndtw-9 series.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1485\margrsxn1917\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-194\shptop5234\shpright-194\shpbottom9540\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}{\shp {\*\shpinst \shpleft-230\shptop5558\shpright-230\shpbottom8712\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft-43\shptop6826\shpright-43\shpbottom8417\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li925\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 62    Chapter 4: Control Structures}\par \pard \plain \cbpat0\ql\li914\fi0\ri0\sb346\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs26 Generalized Iterators}\par \pard \plain \cbpat0\ql\li907\fi0\ri0\sb230\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex110\expndtw-4\dn0\f3\cchs0\lang1033\fs20 Blocks with arguments allow Smalltalk to supply several generalized iteration messages:\line \b\expndtw-2 do:, select:, reject:, \b0 and \b collect:.}\par \pard \plain \cbpat0\ql\li907\fi0\ri0\sb356\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f2\cchs0\lang1033\fs22 The do: Iterator}\par \pard \plain \cbpat0\ql\li911\fi0\ri0\sb223\sa0 \f3\fs20{\b0\i0\cf0\charscalex110\expndtw-1\dn0\f3\cchs0\lang1033\fs20 The simplest of these is the \b do: \b0 message:}\par \pard \plain \cbpat0\ql\li1303\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw1\dn0\f3\cchs0\lang1033\fs20 "count vowels in a string"\line \expndtw-3 I vowels I\line \expndtw8 vowels := 0.}\par \pard \plain \cbpat0\ql\li0\fi1307\ri0\sb0\sa0\sl-238\slmult0\tx1699 \f3\fs20{\b\i0\cf0\charscalex110\expndtw1\dn0\f3\cchs0\lang1033\fs20 'Now is the time' do: [ :char I\line \charscalex33\expndtw-9 I){\charscalex100\expndtw0\tab }\charscalex110\expndtw-6 char is Vowel}\par \pard \plain \cbpat0\ql\li1325\fi770\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw8\dn0\f3\cchs0\lang1033\fs20 ifTrue: [vowels := vowels + I]].\line \b0\scaps\expndtw-6 a \scaps0\b vowels}\par \pard \plain \cbpat0\ql\li911\fi0\ri0\sb162\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex110\expndtw0\dn0\f3\cchs0\lang1033\fs20 The \b do: \b0 iterator causes the string to iterate across itself and pass each character to the\line block. The above example is equivalent to the following:}\par \pard \plain \cbpat0\ql\li1296\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw1\dn0\f3\cchs0\lang1033\fs20 "count vowels in a string"\line \expndtw0 I vowels string index I\line \expndtw9 vowels := 0.\line \expndtw8 index := 1.}\par \pard \plain \cbpat0\ql\li1321\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw5\dn0\f3\cchs0\lang1033\fs20 string := 'Now is the time',\line \expndtw-1 [index <C = string size]\line \expndtw0 whileTrue: [}\par \pard \plain \cbpat0\ql\li2106\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw-1\dn0\f3\cchs0\lang1033\fs20 (string at: index) is Vowel}\par \pard \plain \cbpat0\ql\li1318\fi396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw9\dn0\f3\cchs0\lang1033\fs20 ifTrue: [vowels := vowels + l].\line \expndtw8 index \i :\loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  \i0 index + l].\line \b0\scaps\expndtw-6 a \scaps0\b vowels}\par \pard \plain \cbpat0\ql\li900\fi0\ri0\sb166\sa0 \f3\fs20{\b0\i0\cf0\charscalex110\expndtw-1\dn0\f3\cchs0\lang1033\fs20 The \b do: \b0 message can also iterate arrays, as in this example:}\par \pard \plain \cbpat0\ql\li1321\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw-2\dn0\f3\cchs0\lang1033\fs20 "draw several polygons"\line \expndtw6 #( 3 4 12 24 ) do: [ :sides I\line \expndtw-3 sides timesRepeat: [\line \expndtw-4 Turtle}\par \pard \plain \cbpat0\ql\li2488\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw1\dn0\f3\cchs0\lang1033\fs20 go: 60;}\par \pard \plain \cbpat0\ql\li2484\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex110\expndtw7\dn0\f3\cchs0\lang1033\fs20 turn: \b0 360 // \b sides]]}\par \pard \plain \cbpat0\ql\li904\fi0\ri0\sb162\sa0 \f3\fs20{\b0\i0\cf0\charscalex110\expndtw-3\dn0\f3\cchs0\lang1033\fs20 or file streams:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2225\margrsxn2064\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 Chapter 4: Control Structures    63}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb317\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "Strip all carriage return characters (ascii 13)\line \expndtw-2 from a disk file. Answer the number of characters\line \expndtw-5 stripped."\line \expndtw-4 I output stripped I\line \expndtw4 stripped := 0.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 output := File pathName: 'stripped.go'.\line (File pathName: 'go') do: [ :char I\line \expndtw-2 char = 13 asCharacter}\par \pard \plain \cbpat0\ql\li1192\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 ifTrue: [stripped := stripped + l]}\par \pard \plain \cbpat0\ql\li396\fi796\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 ifFalse: [output nextPut: char]],\line \expndtw-1 output close.\line \b0\scaps\expndtw-9 a \scaps0\b stripped}\par \pard \plain \cbpat0\qj\li11\fi0\ri7\sb140\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The above expression reformats a DOS text file for use with Unix, replacing DOS's\line \expndtw0 carriage return/line feed pair at the end of lines with Unix's single line feed.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb338\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f2\cchs0\lang1033\fs24 The select: Iterator}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb194\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 A more powerful iterator \i is \i0 the \b select: \b0 message:}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb148\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 "count the vowels in a string"\line \expndtw2 ('Now is the time' select: [ :c I c is Vowel ] )\line \expndtw-5 size}\par \pard \plain \cbpat0\qj\li7\fi0\ri7\sb148\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The \b select: \b0 message iterates across its receiver and returns all of the elements for which\line \expndtw-4 the argument block evaluates to true. In this case, the result is a string of all of the vowels\line \expndtw-2 in the original string. The message \b size \b0 then tells us how many elements were selected.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb342\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f2\cchs0\lang1033\fs24 The reject: Iterator}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb191\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The reject: message is another generalized iterator:}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 "answer all digits whose factorial is\line less than the digit raised to the 4th power"\line \expndtw69 #(123456789)\expndtw0  \expndtw1 reject: [ :i I\line \expndtw12 i factorial \b0 >= ( \b i \b0 * \b i \b0 * \b i \b0 * \b i \b0 ) \b ]}\par \pard \plain \cbpat0\qj\li14\fi0\ri0\sb151\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The \b reject: \b0 message works just as \b select:, \b0 but answers all elements of the receiver for\line \expndtw1 which the block of code returns false, instead of true.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2568\margrsxn1712\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-875\shptop3103\shpright-875\shpbottom4089\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft-896\shptop6026\shpright-896\shpbottom7819\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li29\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 64    Chapter 4: Control Structures}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb353\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs24 The collect: \b0 Iterator}\par \pard \plain \cbpat0\qj\li14\fi0\ri11\sb216\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The \b collect: \b0 message evaluates the block of code for each element of the receiver and\line \expndtw1 answers the collection of all of the results returned by the block:}\par \pard \plain \cbpat0\ql\li432\fi0\ri0\sb140\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 "square each element in the array"\line \expndtw9 #(1 13 7 10) collect: \b0 [:il i * \b i]}\par \pard \plain \cbpat0\qj\li11\fi0\ri0\sb162\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 To help see the differences between \b select:, reject:, \b0 and \b collect:, \b0 evaluate the following\line \expndtw-6 expressions:}\par \pard \plain \cbpat0\qj\li428\fi0\ri3600\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 #(1 2 \b0 3 \b 4 5 6 \b0 7) \b select: [ :c I c odd ]\line \expndtw3 #(1 2 3 4 5 6 7) reject: [ :c I c odd ]\line \expndtw7 #(1 2 3 4 5 6 7) collect: [ :c I c odd ]}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb367\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-11\dn0\f2\cchs0\lang1033\fs28 Concluding Example}\par \pard \plain \cbpat0\qj\li7\fi0\ri4\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Our concluding example is inspired by the limitations of DOS file names. DOS limits file\line \expndtw-3 names to eight characters with a three character extension. Often, you need to abbreviate\line \expndtw-2 long names that appear inside of programs. A good algorithm is to remove lower case\line vowels from the original name from right to left. If this doesn't shorten it enough, you\line might truncate what's left to eight characters. With names already shorter than eight\line \expndtw3 characters, you might want to pad the name with blanks, and not throw out any\line \expndtw-1 characters. Here, then, is a Smalltalk solution:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb158\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 "abbreviate a long file name to 8 characters"}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 I name length I}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 name := 'LongFileName'.}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 length := name size.}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\scaps\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 a( \scaps0 name reversed reject: [ :c I}\par \pard \plain \cbpat0\ql\li799\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 c is Vowel and: [}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 c isLowerCase and: [}\par \pard \plain \cbpat0\ql\li1195\fi-389\ri0\sb0\sa0\sl-238\slmult0\tx3031 \f3\fs20{\b\i0\cf0\charscalex100\expndtw13\dn0\f3\cchs0\lang1033\fs22 ( length := length \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  1 ) >= 8 ] ] ] )\line \expndtw-5 reversed, '{\charscalex100\expndtw0\tab }\expndtw0 '}\par \pard \plain \cbpat0\ql\li1595\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 copyFrom: 1 to: 8}\par \pard \plain \cbpat0\qj\li0\fi0\ri14\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Let's examine this example in detail. The caret \scaps (a) \scaps0 on the fourth line tells us that the\line \expndtw-3 remainder of the program will return a single result. We reverse the name so that we can\line \expndtw-2 throw out characters from the end of the original name first. Similarly, we reverse the\line result of the \b reject: \b0 message to put the abbreviated name back in the proper order. We\line \expndtw0 then append blanks to the resulting string and return the first eight characters as the\line \expndtw-7 answer.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb148\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Look more closely at the expression inside of the argument block to the \b reject: \b0 message:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2417\margrsxn1863\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-1080\posnegy0\absw0\absh1195\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw1104\pich2108\picwgoal626\pichgoal1195\jpegblip
}\par\pard \plain \cbpat0\ql\li403\fi4864\ri0\sb65\sa0\sl-619\slmult0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs16 Chapter 4: Control Structures    65\line \i0\charscalex105\expndtw33\fs22 [Kl}\par \pard \plain \cbpat0\ql\li385\fi0\ri0\sb0\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex105\expndtw-7\dn0\f3\cchs0\lang1033\fs22 c is Vowel and: [}\par \pard \plain \cbpat0\ql\li389\fi0\ri0\sb4\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex105\expndtw-9\dn0\f3\cchs0\lang1033\fs22 c isLowerCase and: [}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex105\expndtw10\dn0\f3\cchs0\lang1033\fs22 ( length := length \b0 - \b 1 \b0 ) >= \b 8 \b0 ] ] ]}\par \pard \plain \cbpat0\qj\li0\fi0\ri29\sb133\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Remember that the \b reject: \b0 message eliminates only those characters for which this block\line \expndtw-3 evaluates to true. It's easy to see why the first two tests are \b is Vowel \b0 and \b isLowerCase,\line \b0\expndtw0 since they are the possible characters to eliminate. The final test is more complex:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb133\sa0 \f3\fs20{\b0\i0\cf0\charscalex105\expndtw9\dn0\f3\cchs0\lang1033\fs22 ( \b length := length \b0 - \b 1 \b0 ) >= \b 8}\par \pard \plain \cbpat0\qj\li4\fi0\ri18\sb133\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 This expression must evaluate to true to delete the character, and false to keep it. The\line \expndtw-2 expression decrements the temporary variable length. If the length is less than 8, the\line \expndtw-3 character is to be kept; otherwise it is eliminated. Since we initially set \b length \b0 to the size\line \expndtw0 of the string \b name, \b0 this expression of code returns true at most \b name size \b0 - \b 8 \b0 times,\line which is the number of characters we want to eliminate.}\par \pard \plain \cbpat0\ql\li22\fi0\ri0\sb374\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs28 What YouVe Now Learned}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb205\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 After finishing this chapter, you should be familiar with:}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb144\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb144\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 comparing and testing objects}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 conditional statements}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 boolean expressions}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 simple loops}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 simple iterators}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 block arguments}\par {\pntext\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\tx709 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\tx709 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent291\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 the generalized iterators, \b do:, select:, reject:, \b0 and \b collect:}\par \pard \plain \cbpat0\qj\li32\fi0\ri0\sb122\sa0\sl-248\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 If you want to review any of these topics, you can either repeat the corresponding section\line \expndtw1 of the tutorial, or refer to a detailed explanation in \b Part 3, The Smalltalk/V 286\line \expndtw-6 Reference.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn765\margrsxn10366\margtsxn1440\margbsxn720 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx0\posnegy0\absw0\absh1494\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw1371\pich2635\picwgoal777\pichgoal1494\jpegblip
}\par{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2140\margrsxn2158\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li25\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f2\cchs0\lang1033\fs30 5 CLASSES AND METHODS}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb443\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 In the preceding chapters, you have learned Smalltalk versions of techniques which are\line common to most programming languages. For example, you have learned how to form\line basic expressions, and how to use loops and conditional statements. In this chapter, you\line will learn some of the concepts that make Smalltalk unique: \b class \b0 and \b method. \b0 You will\line examine some \b Smalltalk/V \b0 classes and methods, and add new methods to these classes\line \expndtw-2 for numeric processing, pattern matching, and graphics. You'll also learn how to use\line \b\expndtw-4 Inspectors, \b0 windows for viewing and changing the internal variables that define the state\line \expndtw0 of objects.}\par \pard \plain \cbpat0\qj\li7\fi0\ri4\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Beginning with this tutorial, you will make changes to the \b Smalltalk/V \b0 environment\line \expndtw0 itself. In order to make these changes permanent (so that you can use them in later\line \expndtw-4 tutorials), be sure to \i save the image \i0 whenever you leave \b Smalltalk/V. \b0 That is, when you\line select \b exit Smalltalk \b0 from the system menu, be sure to then use the \b save image \b0 function.}\par \pard \plain \cbpat0\qj\li11\fi0\ri7\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 As always, you can find the examples for this tutorial in the disk file \b chapter. 5. \b0 Use the\line \expndtw-1 Disk Browser to retrieve them, if you wish.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb338\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs32 Classes}\par \pard \plain \cbpat0\qj\li11\fi0\ri4\sb205\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Problem solving using Smalltalk involves \i classifying \i0 objects according to their similarities\line \expndtw1 and differences. You've already seen the external behavior of objects, by sending\line \expndtw-5 messages to them and observing the results. A \i class \i0 defines the behavior of similar objects\line \expndtw-3 by specifying their insides: the variables they contain and the methods available for\line \expndtw0 responding to messages sent to them.}\par \pard \plain \cbpat0\qj\li4\fi0\ri7\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Every object is an \i instance \i0 (member) of a class. For example, #(1 2 3) and #(sam \b joe)\line \b0\expndtw-6 are instances of class \b Array, \b0 whereas \b 'north' \b0 and \b 'south' \b0 are instances of class \b String. \b0 All\line \expndtw3 objects know which class they belong to. For example, evaluate the following\line \expndtw-6 expressions:}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb144\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 #(Francesca Jackie Marisa) class\line 'Rakesh Vijay' class\line Turtle class}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 An object's internal variables are called \i instance variables, \i0 they are themselves containers\line \expndtw2 for other objects. For example, objects in class Fraction have instance variables\line \b\expndtw-3 numerator \b0 and \b denominator. \b0 For the object representing the fraction 1/7, the instance\line \expndtw-5 variable \b numerator \b0 contains the object 1 and the instance variable \b denominator \b0 contains\line \expndtw2 the object 7.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2444\margrsxn1466\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li472\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 68     Chapter 5: Classes and Methods}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2444\margrsxn1466\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-587\shptop3992\shpright-587\shpbottom5036\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}{\shp {\*\shpinst \shpleft-652\shptop4568\shpright-652\shpbottom7318\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li446\fi0\ri0\sb288\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-14\dn0\f2\cchs0\lang1033\fs28 Methods}\par \pard \plain \cbpat0\qj\li385\fi0\ri0\sb241\sa0\sl-202\slmult0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Methods \i0 are Smalltalk code, the algorithms that determine an object's behavior and\line \expndtw-2 performance. They are like function definitions in other languages. When a message is\line \expndtw-3 sent to an object, a method is evaluated, and an object returned as a result. Evaluate the\line \expndtw-4 following message expression:}\par \pard \plain \cbpat0\ql\li767\fi0\ri0\sb104\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 (1/7) \b numerator}\par \pard \plain \cbpat0\qj\li331\fi0\ri65\sb148\sa0\sl-144\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 When the message \b numerator \b0 is sent to the fraction 1/7, Smalltalk evaluates the method\line \b numerator \b0 defined in class \b Fraction:}\par \pard \plain \cbpat0\ql\li709\fi0\ri0\sb86\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 numerator}\par \pard \plain \cbpat0\ql\li1120\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\scaps\cf0\charscalex100\expndtw-11\dn0\f3\cchs0\lang1033\fs22 a \scaps0\b numerator}\par \pard \plain \cbpat0\qj\li263\fi0\ri112\sb144\sa0\sl-202\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The first line of the method defines the method name. (Notice that it matches the selector\line \expndtw-5 in the corresponding message.) The second line returns the result \b numerator, \b0 the instance\line \expndtw0 variable of the receiver fraction object. As a more complex example, evaluate the\line \expndtw-4 following message expression:}\par \pard \plain \cbpat0\ql\li641\fi0\ri0\sb101\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw14\dn0\f3\cchs0\lang1033\fs22 (2/3) * (5/7)}\par \pard \plain \cbpat0\qj\li212\fi0\ri173\sb133\sa0\sl-155\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs22 Sending the message * to the fraction 2/3 with the fraction 5/7 as the argument\line \expndtw0 evaluates the method * in class Fraction:}\par \pard \plain \cbpat0\ql\li601\fi0\ri0\sb86\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 * \b aNumber}\par \pard \plain \cbpat0\ql\li1001\fi0\ri0\sb40\sa0 \f3\fs20{\b0\i0\scaps\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 a \scaps0\b (numerator * aNumber numerator) /}\par \pard \plain \cbpat0\ql\li1368\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 (denominator * aNumber denominator)}\par \pard \plain \cbpat0\qj\li119\fi0\ri248\sb0\sa0\sl-205\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The first line defines the method name (*) and the name for the argument, \b aNumber,\line \b0 which is used in the rest of the method to represent the argument object. The method\line \expndtw-3 returns a new fraction whose numerator is the product of the receiver and argument\line \expndtw-1 numerators, and whose denominator is the product of the receiver and argument\line \expndtw-4 denominators.}\par \pard \plain \cbpat0\qj\li65\fi0\ri306\sb180\sa0\sl-191\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Notice that \b numerator \b0 and \b denominator \b0 appear both as instance variables and messages\line in this method. In processing the example message, the argument \b aNumber \b0 contains the\line \expndtw-3 fraction 5/7, while the instance variables \b numerator \b0 and \b denominator \b0 contain 2 and 3\line \expndtw-7 respectively.}\par {\shp {\*\shpinst \shpleft-1386\shptop576\shpright3748\shpbottom3110\shpfhdr0\shpbxcolumn\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw9055\pich4470\picwgoal5133\pichgoal2534\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(0,0);(0,10493);(0,10493);(0,21600);(21600,21600);(21600,10493);(5513,10493);(5513,0);(0,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\qj\li0\fi0\ri349\sb162\sa0\sl-227\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 As you can see from this example, Smalltalk objects are abstract data types. The multiply\line \expndtw2 method operates on behalf of the receiver object (2/3), whose internal variables\line \b\expndtw-3 numerator \b0 and \b denominator \b0 are accessible. The argument is another object (5/7). Even\line \expndtw-4 though it is the same class as the receiver, its internal variables are not available in this\line method, and so messages must be used to request the desired information. This Smalltalk\line \expndtw-1 feature provides complete safety from outside manipulation.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1383\margrsxn1890\margtsxn1440\margbsxn720\cols2\colno1\colw720\colsr313\colno2\colw7603 {\shp {\*\shpinst \shpleft72\shptop0\shpright1051\shpbottom2124\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw1727\pich3746\picwgoal979\pichgoal2124\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(0,0);(0,11202);(0,11202);(0,21600);(19852,21600);(19852,11202);(21600,11202);(21600,0);(0,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20\par \column {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20\pvpara\phcol\posnegx-4\posnegy529\absw0\absh-320\nowrap\dfrmtxtx40\dfrmtxty0 {\b\i0\cf0\charscalex100\expndtw-12\dn0\f2\cchs0\lang1033\fs28 The Class Hierarchy Browser}\par \pard \plain \cbpat0\qr\li0\fi0\ri7\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 Chapter 3: Classes and Methods    69}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 In using the Smalltalk/V environment up to this point, you may be wondering where\line \expndtw0 you do your actual programming. To program in Small\ul talk\ul0 /V, you use a special window\line \expndtw2 called the \i Class Hierarchy Browser. \i0 It lets you browse and change existing class and\line \expndtw0 method definitions, and create new ones. Open a Class Hierarchy Browser window now\line \expndtw2 by evaluating the following expression:}\par \pard \plain \cbpat0\ql\li781\fi-389\ri0\sb122\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs20 ClassHierarchyBrowser new openOn: (Array with: Integer\line \expndtw8 with: Fraction with: String with: DemoClass)}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 A new window will appear on the screen. Remember that you can resize or move this\line \expndtw-2 window as you learned in Chapter 2. A Class Hierarchy Browser window is now available\line \expndtw4 for the classes Integer, Fraction, String and DemoClass, as you can see from the top\line left pane. Select the entry for class Fraction; you'll see the following window:}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1383\margrsxn1883\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li3262\ri198\sb281\sa0{\pict\picw9144\pich3365\picwgoal5184\pichgoal1908\jpegblip
}\par\pard \plain \cbpat0\ql\li4648\fi-151\ri0\sb119\sa0\sl-133\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f17\cchs0\lang1033\fs10 Number subclass: tFraction\line \expndtw-11 lint nnrnifnr \i i \i0 nil Inf1\loch\af16\hich\af16\dbch\f17\cchs0 \'bb\hich\af16\dbch\af17\loch\f16\cchs0 no\loch\af16\hich\af16\dbch\f17\cchs0 \'ab\hich\af16\dbch\af17\loch\f16\cchs0 '}\par \pard \plain \cbpat0\ql\li4630\fi133\ri0\sb0\sa0\sl-133\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw5\dn0\f17\cchs0\lang1033\fs10 'numerator denoninator\line \expndtw8 classUariableNaaes: "\line poolDictionaries: "}\par \pard \plain \cbpat0\ql\li1418\fi0\ri0\sb54\sa0\sl-216\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs20 Figure 5.1\line \expndtw-5 Class Hierarchy\line \expndtw-1 Browser}\par \pard \plain \cbpat0\qj\li1033\fi0\ri0\sb266\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 The top right pane shows the methods defined for class Fraction, the seleaed class. The\line \expndtw0 bottom pane shows the \i class definition message \i0 for class Fraction. The class definition\line \expndtw3 message shows the characteristics that make up a class. Notice the instanceVari-\line \expndtw2 ableNames: argument; it's a string specifying that the instance variable names are\line \expndtw0 numerator and denominator. You'll learn about this message's other arguments later in\line the chapter.}\par \pard \plain \cbpat0\qj\li1044\fi0\ri4\sb144\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 Select the method * in the top right pane; the source code for the method appears in the\line \expndtw3 bottom pane. This pane is a text editor which you can use to change existing methods\line \expndtw4 and create new ones. Try selecting other methods, and look at the source code.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1034\margrsxn1795\margtsxn1440\margbsxn720\cols3\colno1\colw720\colsr0\colno2\colw720\colsr148\colno3\colw7851 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb7924\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f2\cchs0\lang1033\fs14 .III l)}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb5454\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs18 I}\par \column \pard \plain \cbpat0\ql\li353\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs16 70    Chapter 5: Classes and Methods}\par \pard \plain \cbpat0\ql\li310\fi0\ri0\sb353\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-11\dn0\f2\cchs0\lang1033\fs28 The Special Variable "serf"}\par \pard \plain \cbpat0\ql\li670\fi-378\ri0\sb173\sa0\sl-338\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Now let's add the following new method to class \b Fraction:\line \expndtw-5 fraction}\par \pard \plain \cbpat0\ql\li1084\fi389\ri0\sb32\sa0\sl-187\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "Answer the receiver minus its integral part."\line \b0\scaps\expndtw-4 a \scaps0\b self - self truncated}\par \pard \plain \cbpat0\qj\li234\fi0\ri0\sb155\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 This method returns a fraction less than one, the receiver of the message minus the\line \expndtw-1 integral part of the receiver. The method contains the word \b self, \b0 a special variable\line representing the object which is the receiver of the \b fraction \b0 message. Add the method\line \i to \i0 class \b Fraction \b0 using the following steps:}\par {\pntext\pard \plain \cbpat0\ql\li605\fi0\ri0\sb104\sa0\tx821 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li605\fi0\ri0\sb104\sa0\tx821 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent216\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Pop up the pane menu in the top right pane and select \b new \b0 method.}\par {\pntext\pard \plain \cbpat0\ql\li821\fi-216\ri0\sb0\sa0\sl-202\slmult0\tx821 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li821\fi-216\ri0\sb0\sa0\sl-202\slmult0\tx821 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent216\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 You'll see a prototype method in the bottom pane. Replace it with the source\line \expndtw0 code for the \b fraction \b0 method defined above.}\par {\pntext\pard \plain \cbpat0\ql\li605\fi0\ri0\sb0\sa0\tx821 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li605\fi0\ri0\sb0\sa0\tx821 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent216\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Pop up the pane menu in the bottom pane and select \b save.}\par \pard \plain \cbpat0\qj\li180\fi0\ri61\sb76\sa0\sl-173\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Smalltalk/V \b0 compiles the new method and installs it in class \b Fraction. \b0 Try it out by\line \expndtw-2 evaluating the following messages:}\par \pard \plain \cbpat0\ql\li569\fi0\ri0\sb108\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 (22/7) fraction\line \expndtw3 (2/3) fraction}\par \pard \plain \cbpat0\ql\li151\fi0\ri0\sb331\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f2\cchs0\lang1033\fs28 Creating New Objects and the Special Object "nil"}\par \pard \plain \cbpat0\ql\li133\fi0\ri0\sb122\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 You have seen several messages which create new objects, such as:}\par \pard \plain \cbpat0\ql\li529\fi0\ri0\sb65\sa0\sl-227\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 'bigger', ' string'\line \b0\expndtw12 1 / 3}\par \pard \plain \cbpat0\qj\li86\fi0\ri158\sb173\sa0\sl-191\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Classes are also objects, and so can be used in message expressions. A common way to\line create a new object is to send a message to its class. For example, evaluate the following\line \expndtw-8 messages:}\par \pard \plain \cbpat0\ql\li439\fi0\ri0\sb162\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Array new: 10\line \expndtw-4 Array new\line \expndtw1 Pen new\line \expndtw-3 Date today\line \expndtw2 Time now}\par \pard \plain \cbpat0\qj\li0\fi0\ri223\sb169\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The first message creates an array with 10 elements, all initialized to the object \b nil. \b0 The\line \expndtw-1 object \b nil \b0 is the sole instance of class UndefinedObject; it is assigned to the instance\line \expndtw0 variables of all new objects. This means that unless an object assigns a value to \i its\line \i0\expndtw-3 instance variables, they contain \b nil. \b0 The second message, on the other hand, creates an\line \expndtw-1 array with no elements at all.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2172\margrsxn2123\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 Chapter 5: Classes and Methods    71}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb324\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The third message creates a pen, an instance of class \b Pen; \b0 if you show it, it displays itself\line \b\expndtw-6 as \b0 "a \b Pen". \b0 This is the default way for an object to display itself. (In Chapter 7, you'll learn\line \expndtw-1 how to include more information when an instance displays itself.)}\par \pard \plain \cbpat0\qj\li7\fi0\ri25\sb144\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The final two messages create an instance of class \b Date \b0 (representing the current date),\line \expndtw-1 and an instance of class \b Time \b0 (representing the current time), respectively.}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb360\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-12\dn0\f2\cchs0\lang1033\fs28 Instance Variables}\par \pard \plain \cbpat0\qj\li4\fi0\ri14\sb216\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Objects can contain both \i namedand indexed\i0 instance variables. Named instance variables\line are accessed by name, as with \b numerator \b0 for fraction objects. Indexed instance variables\line are identified by integers beginning with 1. They are always accessed via messages, such\line \expndtw-12 as:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb137\sa0\sl-245\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 'location* at: 2\line \expndtw-3 'parts' at: 5 put: \b0 $y}\par \pard \plain \cbpat0\qj\li4\fi0\ri18\sb144\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 An object's class specifies the named instance variables, and whether or not indexed\line instance variables can be used in its instances. The number of named instance variables\line \expndtw-4 is fixed for all instances of the class. The number of indexed instance variables is defined\line \expndtw-3 when you create the object, and may differ among instances of a class. For example, the\line \expndtw-2 two strings above have eight and five indexed instance variables, respectively.}\par \pard \plain \cbpat0\qj\li7\fi0\ri22\sb155\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 For a complete description of how to specify class information, refer to \b Part 3, The\line \expndtw-1 Smalltalk/V 286 Reference.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb378\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-14\dn0\f2\cchs0\lang1033\fs28 Recursion}\par \pard \plain \cbpat0\qj\li4\fi0\ri18\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 A powerful programming technique is \i recursion. \i0 Recursion is often used when an\line \expndtw-4 algorithm or data structure is defined in terms of itself. In Chapter 3, you saw examples\line \expndtw-3 using the \b factorial \b0 message. Let's look at the \b factorial \b0\i method, \i0 defined in class Integer:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb137\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 factorial}\par \pard \plain \cbpat0\ql\li796\fi400\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "Answer the factorial of the receiver."\line \expndtw9 self >1}\par \pard \plain \cbpat0\ql\li792\fi400\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 ifTrue: \scaps [a\scaps0 (self - 1) factorial * self],\line \expndtw11 self <0}\par \pard \plain \cbpat0\ql\li821\fi371\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 ifTrue: [Aself error: 'negative factorial'].\line \b0\scaps\charscalex142\expndtw-7\fs18 aI}\par \pard \plain \cbpat0\qj\li0\fi0\ri18\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The \b factorial \b0 method multiplies the receiver by the factorial of the quantity, receiver\line \expndtw0 minus one. If the receiver is less than or equal to one, the answer is one. As in this\line \expndtw-3 example, a recursive solution is often a straightforward translation of a mathematical\line \expndtw-1 definition into a Smalltalk method.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2559\margrsxn1743\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-817\shptop6689\shpright-817\shpbottom7675\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li43\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs16 72    Chapter 5: Classes and Methods}\par \pard \plain \cbpat0\qj\li11\fi0\ri4\sb324\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Evaluate the following expression, which sends the \b factorial \b0 message to each of the\line \expndtw0 elements of an array and returns the answers in a new array:}\par \pard \plain \cbpat0\ql\li428\fi0\ri0\sb133\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 #(0 1 2 \b0 3 \b 4 10 15 20) collect: [ :n I n factorial ]}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 As another example of recursion using integers, consider how to compute Fibonacci\line \expndtw-4 numbers. A Fibonacci number is a statistical function used in many applications. The nth\line Fibonacci number for n greater than 2 is defined to be the sum of the Fibonacci numbers\line \expndtw0 for n - 1 and n - 2. (The Fibonacci number for n less than 3 is one.) Use the Class\line Hierarchy Browser to add the following method to class \b Integer \b0 (Note that you can\line \b\expndtw-2 copy \b0 the method from the tutorial file \b chapter. 5 \b0 and \b paste \b0 it over the \b new method\line \b0\expndtw0 template in the bottom pane of the Class Hierarchy Browser):}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 fibonacci}\par \pard \plain \cbpat0\ql\li817\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 "Answer the nth fibonacci number,\line \expndtw-1 where n is the receiver."\line \expndtw5 Aself <3}\par \pard \plain \cbpat0\ql\li1195\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 ifTrue: [l]\line \expndtw-4 ifFalse: [}\par \pard \plain \cbpat0\ql\li1598\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 (self - 1) fibonacci + (self \b0 - \b 2) fibonacci]}\par \pard \plain \cbpat0\qj\li7\fi0\ri4\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Notice that the \b fibonacci \b0 method returns its result differently from the \b factorial \b0 method.\line \expndtw-3 Instead of using the caret \scaps (a) \scaps0 in multiple places, as in \b factorial, fibonacci \b0 uses \b a \b0 single\line \expndtw-2 caret to return the result of the ifTrue:ifFalse: message. That result is the result of either\line \expndtw-1 of the two blocks, depending on the value of the <message. Test the \b fibonacci \b0 method\line \expndtw-2 by evaluating the following message:}\par \pard \plain \cbpat0\ql\li428\fi0\ri0\sb133\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 #(1 \b0 2 3 4 \b 5 \b0 6 7 \b 10 \b0 20) \b collect: [ :m \b0 I \b m fibonacci ]}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb382\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs26 Pattern Matching}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The following example illustrates simple pattern matching applied to strings. (Later,\line you'll see how Smalltalk's inheritance allows this same method to do pattern matching\line \expndtw-3 for several other classes as well.) Add the method \b indexOfString: \b0 to class \b String \b0 using\line the Class Hierarchy Browser:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2340\margrsxn1940\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-1073\posnegy0\absw0\absh1167\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw1397\pich2057\picwgoal792\pichgoal1166\jpegblip
}\par\pard \plain \cbpat0\qr\li0\fi0\ri0\sb482\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 Chapter 5: Classes and Methods    73}\par \pard \plain \cbpat0\ql\li374\fi0\ri0\sb331\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 indexOfString: aString}\par \pard \plain \cbpat0\ql\li778\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 "Answer the index position of the first occurrence\line \expndtw1 of aString in the receiver. If no such element\line \expndtw-1 is found, answer zero."\line \expndtw-5 I index 1 index2 limit 1 Iimit2 I\line \expndtw1 Iimit2 := aString size,\line limit 1 : = self size \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  Iimit2 + 1.\line \expndtw11 indexl := 1.\line \expndtw6 [index 1 <= limit l]\line \expndtw-1 whileTrue: [}\par \pard \plain \cbpat0\ql\li1598\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 index2 := 1.\line \expndtw6 [index2 <= Iimit2}\par \pard \plain \cbpat0\ql\li1969\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 and: [(self at: indexl + index2 \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0  1)}\par \pard \plain \cbpat0\ql\li1577\fi421\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 = (aString at: index2)]]\line \expndtw8 whileTrue: [index2 := index2 + l].\line \expndtw5 index2 >limit2}\par \pard \plain \cbpat0\ql\li814\fi389\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 ifTrue: [Aindexl].\line \expndtw16 indexl := indexl + l].\line \b0\scaps\expndtw-11\fs20 aO}\par \pard \plain \cbpat0\qj\li4\fi0\ri14\sb144\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 This method starts at the beginning of the receiver string and searches for the first\line \expndtw-2 occurrence of the argument string. It returns either the index of the first character in the\line \expndtw-1 receiver's matching substring, or 0 if there are no matches. The method contains two\line \expndtw-3 nested \b whileTrue: \b0 loops. The outer loop proceeds through the characters of the receiver.\line \expndtw-1 Beginning at each character reached in the outer loop, the inner loop compares the\line \expndtw0 characters of the argument to corresponding characters of the receiver.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb130\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Test the \b indexOf String: \b0 method by evaluating each of the following messages:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 'abcdebcd' indexOf String: *ebg'\line \expndtw-4 'abcdebcd' indexOf String: 'bed'\line \expndtw-3 'abcdebcd' indexOfString: 'c'\line \expndtw-6\loch\af1\hich\af1\dbch\f3\cchs0 \'95\hich\af1\dbch\af3\loch\f1\cchs0 abcdebcd' indexOf String: 'abcdebcd'\line \expndtw-4 'abcdebcd' indexOf String: "}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb385\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f2\cchs0\lang1033\fs26 Adding a Method to a Graphics Program}\par \pard \plain \cbpat0\qj\li14\fi0\ri0\sb209\sa0\sl-245\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 In Chapter 3 you used a series of expressions to draw a polygon flower on your display.\line \expndtw-2 The next example packages those expressions into a method, and extends the graphics\line \expndtw0 demo program so that you can choose the polygon flower from the demo program's\line \expndtw-7 menu.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2624\margrsxn1660\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-828\shptop6282\shpright-828\shpbottom7600\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}{\shp {\*\shpinst \shpleft-828\shptop6966\shpright-828\shpbottom7211\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li47\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 74    Chapter 5: C/asses and Methods}\par \pard \plain \cbpat0\qj\li25\fi0\ri0\sb328\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 To create the new method, add the following to class \b DemoClass \b0 using the Class\line \expndtw-5 Hierarchy Browser:}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 polyFlower}\par \pard \plain \cbpat0\ql\li814\fi382\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 "Draw a polygon flower"\line \expndtw-2 I sides length I\line \expndtw-1 Display white: rectangle,\line \expndtw2 sides := Prompter}\par \pard \plain \cbpat0\ql\li806\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 prompt: 'Number of sides?'\line \expndtw-4 defaultExpression: '30'.\line \expndtw10 length := 240 // sides,\line \expndtw-4 pen}\par \pard \plain \cbpat0\ql\li1206\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-10\dn0\f3\cchs0\lang1033\fs22 home;\line \expndtw-5 north.}\par \pard \plain \cbpat0\ql\li1206\fi-396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 sides timesRepeat: [\line \expndtw-5 pen\line \expndtw-9 up;}\par \pard \plain \cbpat0\ql\li1595\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs22 go: length // 2;\line \expndtw-3 down;\line \expndtw4 go: length.}\par \pard \plain \cbpat0\ql\li1595\fi-389\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 sides - 1 timesRepeat: [\line \expndtw-4 pen}\par \pard \plain \cbpat0\ql\li1991\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 turn: 360 // sides;\line \expndtw6 go: length]]}\par \pard \plain \cbpat0\qj\li4\fi0\ri7\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The \b polyFlower \b0 method differs from the polygon flower expressions used earlier in two\line \expndtw-3 ways. Firstly, this method uses a prompter window, rather than a constant, to determine\line \expndtw-4 the number of sides. Secondly, this method uses the instance variable \b pen, \b0 rather than the\line \expndtw-1 global variable \b Turtle, \b0 to draw the polygon flower.}\par \pard \plain \cbpat0\qj\li11\fi0\ri14\sb155\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 To add "poly flower" as a choice in the graphics demo menu, extend the \b demoMenu\line \b0 method in class \b DemoClass, \b0 as follows:}\par \pard \plain \cbpat0\ql\li821\fi-421\ri0\sb162\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 demoMenu\line \b0\scaps\expndtw-15 a \scaps0\b Menu}\par \pard \plain \cbpat0\ql\li1195\fi0\ri0\sb4\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 labels: ('exit\\poly flower\\walking lineY,\line \expndtw-3 'dragon \\mandala\\mandalas\\pentagonsV,\line \expndtw1 'spirals\\ellipses\\bouncing ball') withCrs\line \expndtw5 lines: \expndtw39 #(15\expndtw5  8)}\par \pard \plain \cbpat0\ql\li1188\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 selectors: # (exit polyFlower walkline dragon mandala\line \expndtw-3 multiMandala multiPentagon multiSpiral multiEllipse bounceBall)}\par \pard \plain \cbpat0\qj\li0\fi0\ri22\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Replace the \b demoMenu \b0 method in class \b DemoClass \b0 with the version above. Now try the\line \expndtw0 extended demo program by selecting \b run demo \b0 from the system menu.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2348\margrsxn1953\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri29\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs16 Chapter 5: Classes and Methods    \i0 7.5}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb356\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-15\dn0\f2\cchs0\lang1033\fs28 Class Variables}\par \pard \plain \cbpat0\qj\li7\fi0\ri18\sb209\sa0\sl-241\slmult0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Class variables \i0 are global variables accessible to all instances of a class. They are used to\line \expndtw-1 share data within a class. Class variables begin with \b a \b0 capital letter.}\par \pard \plain \cbpat0\qj\li0\fi0\ri14\sb140\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Let's add a class variable to DemoClass to count the number of times we perform the\line mandala graphics demo method. First, define the new class variable using the Class\line \expndtw-4 Hierarchy Browser. Select \b DemoClass, \b0 then edit the class definition to have the name\line \b\expndtw-5 MandalaCount \b0 following \b VariableCount \b0 in the \b classVariableNames: \b0 argument. Then\line \expndtw-3 pop up the pane menu and select save. This creates the class variable and recompiles\line \b\expndtw0 DemoClass. \b0 Now add the following instance method to \b DemoClass:}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb137\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-9\dn0\f3\cchs0\lang1033\fs22 mandalaCount}\par \pard \plain \cbpat0\ql\li824\fi0\ri0\sb0\sa0\sl-400\slmult0 \f3\fs20{\b0\i0\scaps\cf0\charscalex100\expndtw-12\dn0\f3\cchs0\lang1033\fs22 a \scaps0\b MandalaCount}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-400\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Then add the following code at the end of the \b mandala \b0 method in \b DemoClass:}\par \pard \plain \cbpat0\ql\li803\fi0\ri0\sb0\sa0\sl-400\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 MandalaCount isNil}\par \pard \plain \cbpat0\ql\li1199\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 ifTrue: [MandalaCount := l]}\par \pard \plain \cbpat0\ql\li1199\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 ifFalse: [MandalaCount := MandalaCount + l]}\par \pard \plain \cbpat0\qj\li18\fi0\ri4\sb140\sa0\sl-248\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 To see how many times \b mandala \b0 has been drawn, evaluate the following expression\line \expndtw0 before and after running the demo program:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb133\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 DemoClass new mandalaCount}\par \pard \plain \cbpat0\ql\li29\fi0\ri0\sb378\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-13\dn0\f2\cchs0\lang1033\fs28 Inspectors}\par \pard \plain \cbpat0\ql\li25\fi0\ri0\sb202\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 An \i Inspector \i0 is a window which allows you to view and change an object's instance\line \expndtw-2 variables. Evaluate the following expression to create an inspector window on an array:}\par \pard \plain \cbpat0\ql\li439\fi0\ri0\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw26\dn0\f3\cchs0\lang1033\fs24 lal}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs22 a \b0 := \b #(1 2 sam 'joe' \b0 (4 \b 5)).}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 a at: 2 put: \b0\expndtw44 3/4.}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 a inspect}\par \pard \plain \cbpat0\ql\li25\fi0\ri0\sb130\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 The inspector on an array looks as follows:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2583\margrsxn1723\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li36\fi0\ri0\sb0\sa295 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 76    \i Chapter 3: Classes and Methods}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2583\margrsxn1723\margtsxn1440\margbsxn720 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx2293\posnegy0\absw0\absh2059\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw7988\pich3632\picwgoal4528\pichgoal2059\jpegblip
}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\tlul\tx2081 \f3\fs20\pvpara\phmrg\posnegx2963\posnegy36\absw0\absh-194\nowrap\dfrmtxtx10080\dfrmtxty0 {\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs14 SoalUalk/U Transcript,{\charscalex100\expndtw0\tab }\ul\expndtw0 |Z)Ej}\par {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2583\margrsxn1723\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li389\fi0\ri0\sb842\sa0\sl-216\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 Figure 5.2\line \expndtw-2 Inspector}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb479\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The left pane of the inspector shows the names of the named instance variables and the\line \expndtw-3 numbers of the indexed instance variables. You select a name or number in the left pane\line to see the object contained in that variable in the right pane. You can create an inspector\line \expndtw-1 on the contents of an instance variable by selecting the variable, popping up the pane\line \expndtw-2 menu and selecting \b inspect \b0 or by clicking on a selected variable. Try this by inspecting\line \expndtw0 the second instance variable of the array which contains a fraction object (3/4).}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The fraction object has instance variables named \b numerator \b0 and \b denominator \b0 with\line \expndtw-4 values 3 and 4, respectively. Let's try changing the \b denominator \b0 variable. First select\line \b\expndtw-3 denominator, \b0 and then go to the right pane and use the text editor to replace 4 with \b 100.\line \b0\expndtw-2 Then pop up the pane menu and select save. The instance variable is now changed. Just\line \expndtw-4 to make sure, close the \b fraction \b0 inspector window, return to the \b array \b0 inspector window,\line \expndtw2 and select \b self. \b0 There it is; the fraction has been changed to \b 3/100.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb364\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs28 What YouVe Now Learned}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb209\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 By the end of this tutorial, you should now be familiar with:}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb155\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb155\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 classes and methods}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 the Class Hierarchy Browser}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 the special variable \b self}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 creating new objects}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 the special object \b nil}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 named instance variables}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 indexed instance variables}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 recursion}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 pattern matching}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 adding new methods}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2327\margrsxn1975\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-1022\posnegy0\absw0\absh1851\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw927\pich3263\picwgoal525\pichgoal1850\jpegblip
}\par\pard \plain \cbpat0\qr\li0\fi0\ri4\sb425\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 Chapter 5: Classes and Methods    11}\par \pard \plain \cbpat0\ql\li619\fi0\ri0\sb335\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 class variables\line \expndtw-4 inspectors}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb133\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 As always, if you need to review any of these topics, you can repeat that section of the\line tutorial, or refer to a complete description in \b Part 3, The Smalltalk/V 286 Reference.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb130\sa0\sl-252\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 If you are going to exit the \b Smalltalk/V \b0 environment before proceeding to the next\line \expndtw0 tutorial, be sure to save the image.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn887\margrsxn11022\margtsxn1440\margbsxn720 {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2010\margrsxn2285\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs30 6 INHERITANCE}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb457\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 This chapter presents Smalltalk's \i class hierarchy and \i0 the concept of \b inheritance. \b0 You'll see\line \expndtw-3 inheritance through an example of animal classification and see how to generalize the\line \expndtw-2 pattern matching method you saw in Chapter 5. You'll also see how to add new classes\line \expndtw-3 to \b Smalltalk/V, \b0 using the Class Hierarchy Browser. And finally, you'll be introduced to\line \expndtw0 the Smalltalk concept of polymorphism, and how to process recursive data structures.}\par \pard \plain \cbpat0\qj\li4\fi0\ri7\sb144\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 As always, the examples for this section are stored on a disk file, chapter.6. You can use\line \expndtw1 the Disk Browser to load these files if you do not want to type the examples.}\par \pard \plain \cbpat0\qj\li11\fi0\ri7\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 You'll also add new classes and methods to your environment during this lesson, so be\line \expndtw0 sure to save the image when you exit the environment.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb367\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-10\dn0\f2\cchs0\lang1033\fs28 The Class Hierarchy}\par \pard \plain \cbpat0\qj\li4\fi0\ri0\sb220\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Much of Smalltalk's power comes from arranging its classes in a hierarchy. Each class has\line an immediate superclass and possibly one or more subclasses, with class \b Object \b0 at the top\line of the hierarchy. You're already familiar with this same system in biology, which arranges\line living organisms in classes, based on characteristics common to each class. Classes higher\line in the hierarchy represent more general characteristics, while classes lower in the hierarchy\line \expndtw-4 represent more specific characteristics. For example, \b fish \b0 and \b tree \b0 are more abstract than\line \b\expndtw-2 halibut \b0 and \b maple.}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 In Chapter 5, you saw how Smalltalk organizes its code (methods) by class. In this and\line \expndtw-4 later chapters, you will see how you can develop generic problem solutions using abstract\line \expndtw-1 classes, and then develop more application-specific solutions which "specialize" the\line \expndtw0 general solution by adding a small amount of code in subclasses.}\par \pard \plain \cbpat0\qj\li7\fi0\ri7\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Close the Class Hierarchy Browser window opened in Chapter 5, pop up the system\line \expndtw-3 menu, and select the \b browse classes \b0 choice. This opens a new Class Hierarchy Browser\line \expndtw-4 on the entire class hierarchy. Select class \b Boolean \b0 in the class list pane. Then pop up the\line \expndtw-1 pane menu and select the hide/show menu choice or click on \b Boolean \b0 a second time.\line Now select class \b True, \b0 which shows you the following window:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2576\margrsxn1720\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa418 \f3\fs20{\b0\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs16 80    Chapter 6: Inheritance}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2576\margrsxn1720\margtsxn1440\margbsxn720 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx2412\posnegy0\absw0\absh1490\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw9131\pich2628\picwgoal5176\pichgoal1490\jpegblip
}\par{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2576\margrsxn1720\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qj\li2671\fi-130\ri3514\sb104\sa0\sl-133\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-9\dn0\f17\cchs0\lang1033\fs12 Boolean subclass: IT rue\line \expndtw-12 instanceUar iableNames:\line \expndtw-6 classUariableNaaes: "\line \expndtw-8 poolDictionaries: '*}\par \pard \plain \cbpat0\ql\li371\fi0\ri0\sb745\sa0\sl-220\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 Figure 6.1\line \expndtw-8 Class True}\par \pard \plain \cbpat0\qj\li4\fi0\ri18\sb364\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Notice that the classes in the class list pane are indented. The indentations show the class\line \expndtw-2 hierarchy. Each class is a superclass of the classes indented below it. As you can see,\line \b\expndtw-3 Object \b0 is the superclass of all classes, and \b Boolean \b0 is the superclass of \b True \b0 and \b False.}\par \pard \plain \cbpat0\qj\li0\fi0\ri18\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 A class with "..." following its name has subclasses that are not displayed. When you first\line \expndtw-1 open the Class Hierarchy Browser, it displays only the first level subclasses of class\line \b\expndtw-2 Object. \b0 This keeps the pane from becoming too cluttered. To display a class' hidden\line \expndtw-5 subclasses (or hide a class' displayed subclasses), simply use \b hide/show, \b0 as you did above\line \expndtw-3 to show \b True \b0 and \b False \b0 in class \b Boolean \b0 or double click on the class name. Try hiding\line \expndtw-1 the subclasses of class \b Boolean.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb389\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f2\cchs0\lang1033\fs26 Inheritance}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb223\sa425\sl-238\slmult0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Inheritance \i0 is the Smalltalk capability which allows you to re-use software by specializing\line \expndtw0 already existing general solutions. To see this, we'll define a new class hierarchy of\line \i\expndtw-16 animals:}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2576\margrsxn1720\margtsxn1440\margbsxn720 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx4529\posnegy0\absw0\absh1102\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw1854\pich1943\picwgoal1051\pichgoal1101\jpegblip
}\par{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3000\margrsxn7404\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft3269\shptop22\shpright5991\shpbottom22\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx2081\posnegy43\absw0\absh1138\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw9004\pich2006\picwgoal5104\pichgoal1137\jpegblip
}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb781\sa0\sl-212\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Figure 6.2\line \expndtw-7 Animal Hierarchy}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2261\margrsxn2020\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 Chapter 6: Inheritance   81}\par \pard \plain \cbpat0\qj\li0\fi0\ri22\sb331\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 You'll see these same classes again in the following chapters to illustrate collections,\line \expndtw-5 graphics and window applications. The class \b Animal \b0 is a subclass of class \b Object. \b0 In turn,\line classes \b Bird \b0 and \b Mammal \b0 are subclasses of class \b Animal. \b0 Finally, classes \b Parrot \b0 and\line \b\expndtw-4 Penguin \b0 are subclasses of class \b Bird, \b0 and classes \b Dog \b0 and \b Whale \b0 are subclasses of class\line \b\expndtw1\fs20 Mammal.}\par \pard \plain \cbpat0\qj\li11\fi0\ri25\sb144\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Whenever you define a new class, you also declare its instance variables. The following\line \expndtw-5 shows in parentheses the instance variables defined for each class in the animal hierarchy:}\par \pard \plain \cbpat0\ql\li806\fi-407\ri0\sb144\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Animal (name, knowledge, habitat, topSpeed, color, picture)\line \expndtw1 Bird (flying)}\par \pard \plain \cbpat0\ql\li1199\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Parrot (vocabulary)}\par \pard \plain \cbpat0\ql\li803\fi400\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Penguin ()\line \expndtw-3 Mammal ()}\par \pard \plain \cbpat0\ql\li1199\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Dog (barksAlot)}\par \pard \plain \cbpat0\ql\li1202\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Whale \b0 ()}\par \pard \plain \cbpat0\ql\li22\fi0\ri0\sb382\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs26 Inheritance of Instance Variables}\par \pard \plain \cbpat0\qj\li14\fi0\ri11\sb216\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 In this chapter, we'll use the instance variables \b name, vocabulary \b0 and \b barksAlot. \b0 (You'll\line \expndtw-4 see the others used in subsequent chapters.) The instance variable \b name \b0 contains a string\line \expndtw-3 representing the animal's name, \b vocabulary \b0 contains a string of all words known by \b a\line \b0\expndtw-2 parrot, and \b barksAlot \b0 contains either \b true \b0 or \b false, \b0 depending upon how much \b a \b0 dog\line \expndtw-6 barks.}\par \pard \plain \cbpat0\qj\li22\fi0\ri11\sb144\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 An object inherits all the instance variables defined in its superclasses in addition to\line containing the ones defined in its own class. For example, parrots, penguins, dogs and\line \expndtw-2 whales each contain the following instance variables:}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 Parrot}\par \pard \plain \cbpat0\ql\li421\fi392\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 name, knowledge, habitat, topSpeed, color, picture, flying, vocabulary\line \expndtw0 Penguin}\par \pard \plain \cbpat0\ql\li418\fi396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 name, knowledge, habitat, topSpeed, color, picture, flying\line \expndtw11 Dog}\par \pard \plain \cbpat0\ql\li418\fi396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 name, knowledge, habitat, topSpeed, color, picture, barksAlot\line \expndtw0 Whale}\par \pard \plain \cbpat0\ql\li814\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 name, knowledge, habitat, topSpeed, color, picture}\par \pard \plain \cbpat0\qj\li25\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Normally, you create new classes using the Class Hierarchy Browser. (You'll see how to\line do this later in this chapter.) Since we have several classes and methods to define for the\line \expndtw-3 animal class hierarchy, however, we've simplified the procedure for you by putting them\line \expndtw-2 in a file. To add the animal classes to your \b Smalltalk/V \b0 environment, install the file by\line evaluating the following expression:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1010\margrsxn2015\margtsxn1440\margbsxn720\cols2\colno1\colw720\colsr562\colno2\colw7603\linebetcol \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20\par \column \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 82    Chapter 6: Inheritance}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb302\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 (File pathName: 'animal6.st') fileln}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Now, in order to see these new classes with the Class Hierarchy Browser, activate the\line \expndtw-4 Class Hierarchy Browser window, pop up the class list pane menu, and select the \b update\line \b0\expndtw-6 function. Now all the animal classes are visible. If they are not, use the \b hide/show \b0 selection\line \expndtw-4 from the class list pane menu. By selecting its classes and methods, you can now browse\line \expndtw-3 the animal hierarchy.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb385\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f2\cchs0\lang1033\fs26 The Methods of the Animal Classes}\par \pard \plain \cbpat0\qj\li11\fi0\ri4\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 As you can see from the Class Hierarchy Browser, the methods you have just included\line for class \b Animal \b0 are as follows:}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 answer: aString}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 "Display a message for the receiver animal\line \expndtw0 on the System Transcript window, consisting\line \expndtw-2 of the animal's class name and name preceding\line \expndtw-5 aString."\line \expndtw-4 Transcript nextPutAll:}\par \pard \plain \cbpat0\ql\li1192\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 self class name, ' ', name, ': ', aString;\line \expndtw-8 cr}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb162\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 name: aString}\par \pard \plain \cbpat0\ql\li796\fi403\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 "Change the receiver animal's name to aString."\line \expndtw1 name := aString}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 talk}\par \pard \plain \cbpat0\ql\li792\fi407\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "Display a message that the receiver can't talk."\line \expndtw-4 self answer: *I can"t talk'}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb140\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Similarly, the methods for class \b Parrot \b0 are:}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 talk}\par \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 "Display a message containing the receiver\line \expndtw-5 parrot's vocabulary."\line \expndtw-4 self answer: vocabulary}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb158\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 vocabulary: aString}\par \pard \plain \cbpat0\ql\li788\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 "Change the receiver parrot's vocabulary\line to aString."\line \expndtw0 vocabulary := aString}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb137\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 And finally, the methods for class \b Dog \b0 are:}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1925\margrsxn2376\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 Chapter \i0 6; \i Inheritance   83}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb320\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-9\dn0\f3\cchs0\lang1033\fs22 bark}\par \pard \plain \cbpat0\ql\li1202\fi0\ri0\sb7\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 "Have the receiver dog bark by ringing the bell}\par \pard \plain \cbpat0\ql\li796\fi396\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 and displaying a bark message."\line \expndtw-2 Terminal bell,\line \expndtw-10 barks Alot}\par \pard \plain \cbpat0\ql\li1192\fi0\ri0\sb4\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 ifTrue: [self answer: 'Bow Wow, Bow Wow, Bow Wow!']}\par \pard \plain \cbpat0\ql\li1192\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 ifFalse: [self answer: 'Woof]}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 beNoisy}\par \pard \plain \cbpat0\ql\li796\fi400\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 "Change the status of the receiver dog to noisy."\line \expndtw-2 barksAlot : = true,\line \expndtw-7 self answer: \b0 '1**11 \b bark a lot'}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb162\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 beQuiet}\par \pard \plain \cbpat0\ql\li799\fi403\ri0\sb0\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 "Change the status of the receiver dog to quiet."\line \expndtw1 barksAlot := false,\line \expndtw-1 self answer: 'I won"t bark much'}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb162\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs20 talk}\par \pard \plain \cbpat0\ql\li796\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 "Have the receiver dog talk by barking unless\line \expndtw-1 barksAlot is nil, in which case the superclass\line \expndtw0 can decide how to talk."\line barksAlot isNil}\par \pard \plain \cbpat0\ql\li1192\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 ifTrue: [super talk]\line ifFalse: [self bark]}\par \pard \plain \cbpat0\qj\li4\fi0\ri4\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 We didn't define any methods for classes \b Penguin \b0 and \b Whale. \b0 However, these classes\line \expndtw-3 do inherit the methods of class \b Animal, \b0 so we can create whale and penguin objects and\line \expndtw1 send messages to them, as we do later in this chapter.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb367\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-10\dn0\f2\cchs0\lang1033\fs28 Inheritance of Methods}\par \pard \plain \cbpat0\qj\li0\fi0\ri7\sb216\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Like instance variables, methods are also inherited. When a message is sent to an object,\line \expndtw-3 Smalltalk looks for the corresponding method defined in the object's class. If it finds the\line method, Smalltalk performs it. If it doesn't find the method, however, Smalltalk repeats\line \expndtw0 the procedure in the object's superclass. This process continues all the way to class\line \b\expndtw-3 Object. \b0 If no method is found in any superclass, a walkback window pops up to display\line \expndtw-1 the error.}\par \pard \plain \cbpat0\qj\li0\fi0\ri4\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 For example, look at the \b name: \b0 method defined in class \b Animal. \b0 Since this method is not\line \expndtw-3 defined in any of \b Animal's \b0 subclasses, the \b name: \b0 method in class \b Animal \b0 is evaluated\line whenever a \b name: \b0 message is sent to instances of classes \b Dog, Parrot, Penguin, \b0 or\line \b\expndtw-2 Whale.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2426\margrsxn1876\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li29\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 84    Chapter 6: Inheritance}\par \pard \plain \cbpat0\qj\li18\fi0\ri0\sb328\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 As another example, look at the \b talk \b0 method in the animal classes. Classes \b Penguin \b0 and\line \b\expndtw-3 Whale \b0 inherit \b talk \b0 from class \b Animal, \b0 whereas classes \b Dog \b0 and \b Parrot \b0 re-implement\line \expndtw-1 their own versions of \b talk.}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb392\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs26 The Special Variable "super"}\par \pard \plain \cbpat0\qj\li11\fi0\ri4\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Occasionally, you may want to override a method, instead of using a method higher in\line \expndtw-3 the superclass chain. Generally, you'd do this whenever the specialized processing done\line \expndtw-4 by a method doesn't apply in a particular case. You would instead use the more general\line processing of a method with the same name which appears higher in the superclass chain.}\par \pard \plain \cbpat0\qj\li14\fi0\ri7\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 For example, look at the method \b talk \b0 for class \b Dog. \b0 A dog doesn't know how to talk\line \expndtw-4 if its instance variable \b barksAlot \b0 is undefined (has the value nil). In this case, it uses the\line \expndtw-1 following message to request the superclass' \b talk \b0 method:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb133\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 super talk}\par \pard \plain \cbpat0\qj\li4\fi0\ri11\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The special variable super represents the same object as the special variable self: the\line \expndtw-3 receiver in the method in which it appears. The difference is that when a message is sent\line \expndtw-2 to super, Smalltalk looks for the method not in the receiver object's class, but instead in\line \expndtw-3 the superclass of the class containing the method in which super appears. In the example\line \b\expndtw-5 talk \b0 method, the search begins in \b Mammal, \b0 the superclass of class \b Dog. \b0 There is no \b talk\line \b0\expndtw0 method in class \b Mammal, \b0 but there is one in class \b Animal, \b0 so that one is used.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb385\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs26 Creating Animal Objects}\par \pard \plain \cbpat0\qj\li0\fi0\ri18\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Evaluate the following expressions to create and assign to global variables five animal\line \expndtw-2 objects: two dogs, a penguin, a parrot and a whale (the animals "talk" to the System\line \expndtw1 Transcript, so first reframe the Disk Browser window to not overlap the System\line \expndtw-6 Transcript):}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2034\margrsxn2272\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs16 Chapter 6: Inheritance    85}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb317\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 "creating animals"}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 Snoopy := Dog new.}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Snoopy name: 'Snoopy'.}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Snoopy beQuiet.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Lassie := Dog new.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 Lassie name: 'Lassie'.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Lassie beNoisy.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Wally := Penguin new.}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Wally name: 'Wally'.}\par \pard \plain \cbpat0\ql\li418\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Polly := Parrot new.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Polly name: 'Polly*.}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Polly vocabulary: 'Polly want a Cracker'.}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Moby := "Whale new.}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Moby name: 'Moby'}\par \pard \plain \cbpat0\ql\li32\fi0\ri0\sb367\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-16\dn0\f2\cchs0\lang1033\fs28 Polymorphism}\par \pard \plain \cbpat0\qj\li11\fi0\ri4\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Polymorphism \i0 is a unique characteristic of object-oriented programming whereby different\line \expndtw-1 objects respond to the same message with their own unique behavior. For example,\line \expndtw-2 evaluate the following messages to see how the various animals respond to the \b talk\line \b0\expndtw-8 message:}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb155\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 "let's hear them talk"}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 Lassie talk.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Snoopy talk.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Wally talk.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Polly talk; talk; talk.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Polly vocabulary: 'Screeech@#!? Don"t bother me!'.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Polly talk.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Moby talk.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Snoopy beNoisy; talk.}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Lassie beQuiet; talk}\par \pard \plain \cbpat0\qj\li0\fi0\ri11\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Polymorphism lets you use entirely new classes of objects in existing applications, as long\line \expndtw1 as they implement the message protocol required by the application. This greatly\line \expndtw-4 facilitates the reusing of generic code. A simple example is the method \b max: \b0 defined in\line \expndtw0 class \b Magnitude, \b0 which returns the "maximum" of two objects:}\par \pard \plain \cbpat0\ql\li392\fi0\ri0\sb148\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 max: aMagnitude}\par \pard \plain \cbpat0\qj\li1181\fi-396\ri4309\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 self > aMagnitude\line ifTrue: [Aself]\line \expndtw-3 ifFalse: \scaps [a\scaps0 aMagnitude]}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2241\margrsxn1079\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li18\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs16 86    Chapter 6: Inheritance}\par \pard \plain \cbpat0\qj\li11\fi0\ri983\sb320\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The existing \b max: \b0 will work in any new subclass of \b Magnitude, \b0 as long as the new class\line \expndtw1 implements the greater than (>) method.}\par \pard \plain \cbpat0\ql\li25\fi0\ri0\sb378\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs26 More General Pattern Matching}\par \pard \plain \cbpat0\qj\li4\fi0\ri983\sb227\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 In Chapter 5, you created a method \b indexOfString: \b0 to do pattern matching on strings.\line By relocating this method to a superclass of class \b String, we \b0 can use it to do pattern\line \expndtw-4 matching for several more classes. We'll change the name of the method to \b indexOfCol-\line \expndtw-3 lection: \b0 to suggest its more general capability, but we won't change the processing. Use\line \expndtw0 the Class Hierarchy Browser to add the method \b indexOfCollection: \b0 to class\line \b\expndtw-1 IndexedColiection, \b0 a subclass of \b Collection:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb158\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 indexOfCollection: aCollection}\par \pard \plain \cbpat0\qr\li0\fi0\ri2718\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex10