0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs24 #John}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f3\fs20\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f3\fs20\cell \pard\intbl\row \pard\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2273\margrsxn1133\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li36\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs16 226    Chapter 14: Smalltalk/ V 286 Classes}\par \pard \plain \cbpat0\qj\li25\fi0\ri864\sb331\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Enumerating messages allow you to process all the elements of a collection. Enumerating\line \expndtw-3 messages usually take a one-argument block as an argument and evaluate it with each\line \expndtw-4 element in the receiver collection. Assume \b Customer \b0 and \b Supplier \b0 have the same values\line \expndtw2 as at the end of the last example.}\par \pard \plain \cbpat0\ql\li436\fi0\ri0\sb140\sa0\sl-241\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 I \b count I}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs22 count := 0.}\par \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Customer do: [ -.aName I count := count + aName size].}\par \pard \plain \cbpat0\ql\li439\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b0\i0\scaps\cf0\charscalex100\expndtw-9\dn0\f3\cchs0\lang1033\fs22 a \scaps0\b count}\par \pard \plain \cbpat0\ql\li22\fi0\ri0\sb4\sa0\sl-396\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 produces 17.}\par \pard \plain \cbpat0\ql\li22\fi400\ri0\sb4\sa0\sl-396\slmult0\tx8352 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Customer select: [ -.aName I aName \b0 == \b #John]\line \b0\expndtw-2 produces \b Bag (John John John ).{\charscalex100\expndtw0\tab }\i\expndtw0 W}\par \pard \plain \cbpat0\ql\li414\fi0\ri0\sb4\sa0\sl-396\slmult0\tx8384 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Customer reject: [ :aName I aName \super =:=::\nosupersub  #John]{\charscalex100\expndtw0\tab }\expndtw0 I}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 produces \b Bag (Peter ).}\par \pard \plain \cbpat0\ql\li18\fi396\ri0\sb7\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Customer collect: [ :aName \b0 I \b aName \b0 as \b Array]\line \b0\expndtw5 produces \b Bag(($J $o $h $n ) ($J $o $h $n ) ($J $o $h $n ) ($P $e $t $e $r ) ).}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Customer detect:}\par \pard \plain \cbpat0\ql\li828\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 [ :aName I aName includes: $P]}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb4\sa0\sl-396\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 produces \b Peter.}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 Customer detect:}\par \pard \plain \cbpat0\ql\li824\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 [ :aName I aName = #Mary] ifNone: ['Not found']}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa0\sl-396\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 produces \b 'Not found'.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb4\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Customer inject: 0 into:}\par \pard \plain \cbpat0\ql\li821\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 [ :count -.aName I count + aName size]}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb140\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 produces 17.}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb346\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-13\dn0\f2\cchs0\lang1033\fs24 Class Bag}\par \pard \plain \cbpat0\qj\li0\fi0\ri886\sb212\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 A \b Bag \b0 contains a collection of arbitrary objects. Duplicates are allowed and ordering is\line \expndtw-4 arbitrary. A \b Bag \b0 does not have external keys; therefore it cannot respond to the messages\line \b\expndtw-3 at: \b0 and \b at:put:. \b0 In addition to the common protocol, it has a message, \b add:withOccur-\line \expndtw-2 rences: \b0 to add an element a specified number of times. \b Bags \b0 are hashed for efficient\line \expndtw-3 lookup.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1996\margrsxn2278\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs16 Chapter 14: Smalltalk/ V 286 Classes    221}\par \pard \plain \cbpat0\qj\li18\fi0\ri7\sb313\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 As an example, here is an expression that computes the frequency of occurrence of words\line \expndtw-3 in a file.}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 I \b input frequency output word I\line input: ^File pathName: 'in.fil'.\line \expndtw-2 output: =File pathName: 'out.fiT.\line \expndtw-6 frequency: \loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0 Bag new.\line \expndtw1 [(word:=input next Word) isNil]}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 while False: [frequency add: word asLowerCase].\line \expndtw-6 frequency asSet asSortedCollection do: [:word I\line \expndtw-2 output}\par \pard \plain \cbpat0\ql\li1202\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 nextPutAll: word;}\par \pard \plain \cbpat0\ql\li1202\fi0\ri0\sb4\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-13\dn0\f3\cchs0\lang1033\fs22 tab;}\par \pard \plain \cbpat0\ql\li1206\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 nextPutAll: (frequency occurrencesOf: word) printString;}\par \pard \plain \cbpat0\ql\li403\fi796\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 cr].\line \expndtw-1 output close.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb320\sa0 \f3\fs20{\b\i0\cf0\charscalex83\expndtw0\dn0\f2\cchs0\lang1033\fs26 Class Set}\par \pard \plain \cbpat0\qj\li14\fi0\ri11\sb205\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 A Set \b0 is like a \b Bag \b0 except that it cannot have duplicate elements. \b Sets \b0 are hashed for\line \expndtw-4 efficient lookup.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb133\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 As an example, here is an expression that computes a sorted list of words in a file.}\par \pard \plain \cbpat0\ql\li432\fi0\ri0\sb144\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 I \b input words word I}\par \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 input: = File pathName: 'in.fil'.}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 words = Set new.}\par \pard \plain \cbpat0\ql\li428\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 [(word: = input nextWord) isNil]}\par \pard \plain \cbpat0\ql\li428\fi371\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 whileFalse: [words add: word asLowerCase].\line \b0\scaps\expndtw-3 a \scaps0\b words asSortedCollection.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb331\sa0 \f3\fs20{\b\i0\cf0\charscalex83\expndtw-3\dn0\f2\cchs0\lang1033\fs26 Class Dictionary}\par \pard \plain \cbpat0\qj\li0\fi0\ri11\sb202\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 Class \b Dictionary \b0 represents a set of objects with external lookup keys. Dictionaries are\line hashed for efficient lookup. A dictionary's elements are instances of class \b Association\line \b0\expndtw-1 which contain a lookup key and its corresponding value. Because the key is only for\line \expndtw-4 lookup purposes, the messages \b includes:, do:, \b0 and other inherited enumeration messages\line \expndtw-2 are applied to the values rather than to the keys or to the associations themselves. Class\line \b\expndtw-3 Dictionary \b0 provides other messages to deal with keys and associations. Refer to \b Part 4\line \b0\expndtw-1 for all the messages implemented by class \b Dictionary.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2324\margrsxn1931\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li25\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs16 228    Chapter 14: Smalltalk/ V 286 Classes}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb374\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs22 Class IdentityDictionary}\par \pard \plain \cbpat0\qj\li7\fi0\ri0\sb212\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Class \b IdentityDictionary \b0 is similar to Dictionary except that it uses equivalence (=\loch\af1\hich\af1\dbch\f3\cchs0 \'97\hich\af1\dbch\af3\loch\f1\cchs0 )\line \expndtw-3 instead of equality (=) during a key lookup. Its implementation also makes better storage\line utilization than a \b Dictionary. \b0 Because its key lookup matches object pointers instead of\line object contents, the only sensible classes for its keys (except for special situations) are\line \b\expndtw-1 Symbol \b0 and \b Smalllnteger.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb356\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs22 Class IndexedCollection}\par \pard \plain \cbpat0\qj\li11\fi0\ri18\sb216\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Class \b IndexedCollection \b0 represents collections with elements ordered externally by\line \expndtw-2 integer indices. It is an abstract class to contain common protocol for its subclasses and\line \expndtw1 therefore should not have any instance of its own created.}\par \pard \plain \cbpat0\qj\li11\fi0\ri14\sb158\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Because of its well-defined ordering, all of its subclasses implement the equality (=)\line \expndtw-3 message in such a way that the answer is true if two \b IndexedCollections \b0 have the same\line \expndtw-1 class and size, and their corresponding elements answer true for the equality message.}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb346\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs22 Class FixedSizeCollection}\par \pard \plain \cbpat0\qj\li7\fi0\ri25\sb223\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Class \b FixedSizeCollection \b0 is a subclass of class \b IndexedCollection. \b0 It is an abstract class\line \expndtw-4 to provide common protocol for its subclasses: \b Array, ByteArray, Interval, String, \b0 and\line \b Symbol. \b0 These subclasses represent collections with a fixed range of integer indices as\line external keys. Because these subclasses have fixed sizes, they cannot respond to the \b add:\line \b0\expndtw-7 message.}\par \pard \plain \cbpat0\qj\li7\fi0\ri25\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The instance creation message \b new: \b0 is subtly different when applied to a fixed size\line \expndtw0 collection than to a variable one. The following message:}\par \pard \plain \cbpat0\ql\li7\fi407\ri0\sb29\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 (Array new: 5) size\line \b0 evaluates to 5, while}\par \pard \plain \cbpat0\ql\li410\fi0\ri0\sb4\sa0\sl-396\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 (OrderedCollection new: 5) size}\par \pard \plain \cbpat0\qj\li4\fi0\ri22\sb130\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 evaluates to 0. When message \b new: \b0 is sent to class \b Array, \b0 the new instance is created\line \expndtw-4 with elements initialized to nil. When the message is sent to a variable size collection like\line \b\expndtw-2 OrderedCollection, \b0 the new instance is created with space allocated, but is logically\line \expndtw-6 empty.}\par \pard \plain \cbpat0\qj\li4\fi0\ri25\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The elements of an \b Array \b0 can be any objects. An element of a \b ByteArray \b0 must \b be a\line \expndtw3 Smalllnteger \b0 in the range of 0 to 255. The elements of a \b String \b0 or \b Symbol \b0 are\line \expndtw0 characters. \b Symbols \b0 are guaranteed to be unique.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1929\margrsxn2330\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 Chapter 14: Smalltalk/ V 286 Classes   229}\par \pard \plain \cbpat0\qj\li11\fi0\ri0\sb302\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 An Interval \b0 represents a finite arithmetic progression. Its elements can be any kind of\line \expndtw-2 number: integer, float, or fraction. Although \b Interval \b0 contains all the numbers within a\line \expndtw-4 specified range and with a specified increment between each number, it is represented\line \expndtw-3 concisely with only three instance variables: beginning, end, and increment. Its elements\line are regenerated upon access rather than stored in the instance. To create an instance, \b the\line \b0\expndtw-4 two \b Interval \b0 class messages, \b from-.to: \b0 and \b from:to:by:, \b0 are used. Class \b Number \b0 also\line \expndtw-1 provides some shorthand messages, \b to: \b0 and \b to:by:, \b0 to create new \b Intervals.}\par \pard \plain \cbpat0\ql\li11\fi0\ri0\sb346\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs22 Class OrderedCollection}\par \pard \plain \cbpat0\qj\li14\fi0\ri22\sb216\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 OrderedCollections \b0 are ordered by the sequence in which objects are added to and\line \expndtw-3 removed from them. They are like dynamic arrays, except that they can be expanded on\line \i\expndtw-2 both \i0 ends. To facilitate this feature, messages are provided to add, remove, and access\line \expndtw2 both the beginning and end.}\par \pard \plain \cbpat0\qj\li7\fi0\ri22\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The \b add: \b0 message defined in class \b Collection \b0 is implemented to be like \b addLast:. \b0 Other\line \expndtw-3 messages enable you to access, add, or remove an object in the middle by specifying its\line \expndtw0 preceding or succeeding object.}\par \pard \plain \cbpat0\qj\li14\fi0\ri25\sb151\sa184\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 OrderedCollections \b0 can act as stacks or queues. Operations to a stack are typically\line "last-in, first-out." Following is a comparison of terminology:}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2329\margrsxn5098\margtsxn1440\margbsxn720\cols2\colno1\colw1634\colsr1048\colno2\colw1800 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Typical Stack\line \expndtw-6 Vocabulary}\par {\shp {\*\shpinst \shpleft0\shptop4\shpright1058\shpbottom4\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 18415}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb194\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 push newElement}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 pop}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 top}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 empty}\par \column \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 OrderedCollection\line \expndtw-6 Message}\par {\shp {\*\shpinst \shpleft-4\shptop4\shpright766\shpbottom4\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 18415}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb194\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 addLast: newObject}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-9\dn0\f3\cchs0\lang1033\fs22 removeLast}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs22 last}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 isEmpty}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1929\margrsxn2330\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb108\sa180 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Operations to a queue are typically "first-in, first-out":}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2325\margrsxn5102\margtsxn1440\margbsxn720\cols2\colno1\colw1522\colsr1156\colno2\colw1803 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-241\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Typical Queue\line \expndtw-6 Vocabulary}\par {\shp {\*\shpinst \shpleft4\shptop4\shpright1062\shpbottom4\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 18415}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb194\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 add newElement}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 delete}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 front}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 empty}\par \column \pard \plain \cbpat0\ql\li7\fi0\ri0\sb7\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 OrderedCollection\line \ul\expndtw-6 Message}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb194\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-8\dn0\f3\cchs0\lang1033\fs22 addLast: newObject}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 removeFirst}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb4\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs20 first}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-234\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 isEmpty}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1929\margrsxn2330\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qj\li0\fi0\ri29\sb140\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Queues grow on one end and shrink on the other. When space is exhausted on the\line \expndtw-4 growing end, an \b OrderedCollection \b0 always checks the shrinking end. If there is enough\line \expndtw-3 space, it shifts the entire collection towards the shrinking end to make room for growing\line at the other end. If there is not enough space, it will allocate a larger space and copy the\line \expndtw0 original collection to the new space.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2291\margrsxn1975\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs16 230   Chapter 14: Smalltalk/V286 Classes}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb385\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs22 Class SortedCollection}\par \pard \plain \cbpat0\qj\li0\fi0\ri32\sb209\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 SortedCollections \b0 are ordered according to a two-argument block called the \i sort block.\line \i0 The sort block is used to determine whether two elements are correctly sorted relative to\line each other. Because the position of each element is dictated by the sort block, messages\line \expndtw-4 such as \b addLast: \b0 are disallowed. Message \b add: newObject, \b0 however, will insert the\line \b\expndtw2 newObject \b0 into the sorted position according to the sort block.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb133\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 There are five ways to create a new instance:}\par \pard \plain \cbpat0\ql\li403\fi0\ri0\sb148\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 SortedCollection new}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 SortedCollection new: 10}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 SortedCollection sortBlock: [ :a :b I a > b ]}\par \pard \plain \cbpat0\ql\li396\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 anyCollection asSortedCollection}\par \pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 anyCollection asSortedCollection: [ :a :b \b0 I \b a \b0 > \b b ]}\par \pard \plain \cbpat0\qj\li7\fi0\ri29\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 A sort block can be as complex as desired, but the last expression in the block must\line \expndtw-4 evaluate to either true or false. For example, the following sort block assumes that strings\line \expndtw1 are being compared. It sorts the strings based on the number of unique vowels.}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb137\sa0 \f3\fs20{\b\i0\cf0\charscalex85\expndtw7\dn0\f3\cchs0\lang1033\fs22 [ :a :b I}\par \pard \plain \cbpat0\ql\li810\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 (a asLowerCase select: [ :c I c isVowel]) asSet size}\par \pard \plain \cbpat0\ql\li806\fi0\ri0\sb220\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 (b asLowerCase select: [ :c I c isVowel]) asSet size]}\par \pard \plain \cbpat0\qj\li14\fi0\ri25\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 When the sort block is not specified at creation time, the following default sort block is\line \expndtw-8 used:}\par \pard \plain \cbpat0\ql\li425\fi0\ri0\sb130\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs24 [ :a :b I a <= b ]}\par \pard \plain \cbpat0\qj\li7\fi0\ri22\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The sort block can also be changed any time by sending message \b sortBlock: newBlock\line \b0 to a \b SortedCollection \b0 which automatically resorts the whole collection according to the\line \b\expndtw-2 newBlock.}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb371\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-12\dn0\f2\cchs0\lang1033\fs28 Window Classes}\par \pard \plain \cbpat0\qj\li14\fi0\ri0\sb220\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 To write an interactive application in \b Smalltalk/V, \b0 you need to understand \b Smalltalk/V\line \b0 window technology. In \b Smalltalk/V, \b0 a window typically involves three major kinds of\line \expndtw-4 classes (and their subclasses): the application classes (such as \b ClassBrowser) \b0 which\line \expndtw-2 synchronize panes, the \b Pane \b0 classes which display on the screen, and the \b Dispatcher\line \b0\expndtw-1 classes which process keyboard and mouse inputs.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1990\margrsxn2251\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs16 Chapter 14: Smalltalk/ V 286 Classes   231}\par \pard \plain \cbpat0\qj\li4\fi0\ri22\sb299\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 The application class is also referred to as the \b model \b0 class. It has to be written for each\line \expndtw-3 new application, although you can use an existing model as a template. The \b Pane \b0 and\line \b Dispatcher \b0 classes and their subclasses are complete building blocks in the system, and\line \expndtw1 you rarely need to modify them.}\par \pard \plain \cbpat0\qj\li11\fi0\ri22\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 The relationship among these classes is depicted in \i Figure 14.1 \i0 using the \b ClassBrowser\line \b0\expndtw-1 window as an example.}\par \pard \plain \cbpat0\qj\li11\fi0\ri25\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 You can look at the \b model \b0 class as the skeleton of a window which organizes all the\line \expndtw-3 window panes and is responsible for the communication and synchronization among the\line \expndtw-6 panes.}\par \pard \plain \cbpat0\qj\li14\fi0\ri18\sb151\sa0\sl-234\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 The \b Pane \b0 class has two immediate subclasses: \b TopPane \b0 and \b SubPane. \b0 The main function\line \expndtw-4 of an instance of class \b TopPane \b0 is to coordinate all of the subpanes in the \i model \i0 window.\line \expndtw-2 Thus there is one and only one instance of class \b TopPane \b0 in each window. It holds the\line \expndtw2 window label located at the top of the window.}\par \pard \plain \cbpat0\qj\li14\fi0\ri22\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 The \b SubPane \b0 class has three subclasses: \b GraphPane, IistPane \b0 and \b TextPane. \b0 An\line \expndtw-1 instance of class \b IistPane \b0 provides a view of a list of strings. You can browse through\line \expndtw-3 the list (scrolling if necessary), and select the string that you wish. When you make a\line \expndtw0 selection, the \b model \b0 instance will be notified and act accordingly.}\par \pard \plain \cbpat0\qj\li25\fi0\ri0\sb151\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 An instance of class \b TextPane \b0 lets you view and edit the text that it contains. The text\line \expndtw-3 is usually represented as an instance of class \b StringModel. \b0 When you save a piece of\line \expndtw1 modified text, the \b model \b0 instance is again notified to act according to your request.}\par \pard \plain \cbpat0\qj\li22\fi0\ri22\sb148\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Every pane has a unique dispatcher associated with it. The type of the pane determines\line \expndtw-3 the type of the associated dispatcher. An instance of a \b Dispatcher \b0 subclass serves as a\line \expndtw-4 messenger that collects input from the keyboard and mouse. It sends messages to its pane\line \expndtw2 to take actions according to the input events.}\par \pard \plain \cbpat0\qj\li22\fi0\ri22\sb155\sa0\sl-238\slmult0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Keep in mind that for an application with window panes that involve only classes\line \b\expndtw0 GraphPane, IistPane \b0 and \b TextPane, \b0 you only need to know about the application\line \expndtw2 model. If you want to define new kinds of panes, then you also need to define\line \expndtw-1 corresponding new \b Dispatcher \b0 subclasses, which means you need to learn about the\line entire trilogy. Or if you want to re-assign the meaning of a function key, then you need\line to know how to modify the existing \b Dispatchers. \b0 For these more advanced problems\line \expndtw-3 refer to the Smalltalk source code and \b Part 4: Encyclopedia of Classes \b0 for the relevant\line \expndtw-8 classes.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2198\margrsxn2022\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa968 \f3\fs20{\b0\i\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs16 232   Chapter 14: Smalltalk/V 286 Classes}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3641\margrsxn2526\margtsxn1440\margbsxn720\cols3\colno1\colw1357\colsr1386\colno2\colw720\colsr1559\colno3\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs24 Dispatchers}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb11\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f2\cchs0\lang1033\fs24 Panes}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs24 Model}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn8267\margrsxn2922\margtsxn1440\margbsxn720\cols1\colsx60\linebetcol \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-4637\posnegy331\absw0\absh1598\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw5588\pich2819\picwgoal3168\pichgoal1598\jpegblip
}\par\pard \plain \cbpat0\ql\li4\fi0\ri0\sb428\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs18 label}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb493\sa857 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f2\cchs0\lang1033\fs18 borders}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn5625\margrsxn2022\margtsxn1440\margbsxn720\cols2\colno1\colw1807\colsr1307\colno2\colw1148 {\shp {\*\shpinst \shpleft547\shptop-864\shpright3189\shpbottom-864\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}{\shp {\*\shpinst \shpleft2239\shptop-670\shpright4413\shpbottom-670\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft2232\shptop-295\shpright4414\shpbottom-295\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft2232\shptop-670\shpright2232\shpbottom2239\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft2952\shptop-295\shpright2952\shpbottom2239\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft1922\shptop-36\shpright1922\shpbottom1109\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft4385\shptop-662\shpright4385\shpbottom2240\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \cbpat0\ql\li148\fi0\ri0\sb0\sa0 \f3\fs20\pvpara\phmrg\posnegx-3236\posnegy335\absw749\absh-1091\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-6\dn0\f2\cchs0\lang1033\fs18 Mouse}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20\pvpara\phmrg\posnegx-3236\posnegy335\absw749\absh-1091\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-4\dn0\f2\cchs0\lang1033\fs18 Keyboard}\par {\shp {\*\shpinst \shpleft-3262\shptop122\shpright727\shpbottom1490\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw7035\pich2413\picwgoal3988\pichgoal1368\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;17;(4483,0);(4483,1477);(4483,1477);(4483,7048);(0,7048);(0,17166);(4483,17166);(4483,21600);(21600,21600);(21600,17166);(21600,17166);(21600,7048);(21600,7048);(21600,1477);(17584,1477);(17584,0);(4483,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs18 List Pane     dictionaries}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb468\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f2\cchs0\lang1033\fs18 Class Browser}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2198\margrsxn2022\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li3438\fi0\ri0\sb259\sa511 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f2\cchs0\lang1033\fs18 List Pane       selectors}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2198\margrsxn2022\margtsxn1440\margbsxn720 {\shp {\*\shpinst \shpleft3514\shptop-439\shpright4140\shpbottom-439\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft5659\shptop-259\shpright7833\shpbottom-259\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx1152\posnegy0\absw0\absh1346\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw4038\pich2374\picwgoal2289\pichgoal1346\jpegblip
}\par{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn7598\margrsxn3592\margtsxn1440\margbsxn720\cols1\colsx60\linebetcol {\shp {\*\shpinst \shpleft-1886\shptop7\shpright-1281\shpbottom7\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft-1591\shptop360\shpright670\shpbottom360\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft-1318\shptop756\shpright1720\shpbottom756\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-3967\posnegy770\absw0\absh2103\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw5829\pich3708\picwgoal3304\pichgoal2102\jpegblip
}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-216\slmult0 \f3\fs20\pvpara\phmrg\posnegx-5400\posnegy2268\absw1728\absh-652\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Figure 14.1\line \expndtw5 Dispatcher, Pane,\line \expndtw3 Model Relationships}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb1404\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f2\cchs0\lang1033\fs18 text}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2077\margrsxn2089\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f3\fs20{\b0\i\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs16 Chapter 14: Smalltalk/ V 286 Classes   25}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb349\sa0 \f3\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs22 Application Model}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb205\sa0 \f3\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 An application model has five major functions:}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb151\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb151\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Remember the Current State}\par {\pntext\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22  \'95\tab}\pard \plain \cbpat0\ql\li400\fi0\ri0\sb0\sa0\sl-238\slmult0\tx608 \f3\fs20{\*\pn\pnlvlblt\pnstart-1\pnindent208\pnf3{\pntxtb \'95}}\b0\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f3\cchs0\lang1033\fs22 {\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Create Panes}\par {\pntext\pard \plain \cbpat0\ql\li400\