\expndtw3 Wayman, Russel J., "Limits to Speed: A Case Study of a Smalltalk\line \expndtw5 Implementation Under VM/UNIX", Class Report CS-292R, Com-\line \expndtw1 puter Science Div., Dept. of E.E.C.S., Univ. of California, Berkeley,\line \expndtw-1 CA, Fall \lang1032 1981.}\par {\pntext\pard \plain \cbpat0\ql\li122\fi0\ri0\sb101\sa0\tx464 \b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22  12.\tab}\pard \plain \cbpat0\ql\li122\fi0\ri0\sb101\sa0\tx464 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart10\pnindent342\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Stinger, Jim, et. al., Private Communications, \lang1032 1981.}\par {\pntext\pard \plain \cbpat0\ql\li122\fi0\ri0\sb97\sa0\tx464 \b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22  13.\tab}\pard \plain \cbpat0\ql\li122\fi0\ri0\sb97\sa0\tx464 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart10\pnindent342\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 See reference \lang1032 11.}\par {\pntext\pard \plain \cbpat0\ql\li464\fi-342\ri0\sb115\sa0\sl-234\slmult0\tx464 \b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22  14.\tab}\pard \plain \cbpat0\ql\li464\fi-342\ri0\sb115\sa0\sl-234\slmult0\tx464 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart10\pnindent342\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Joy, William N., and Babaoglu, Ozalp, UNIX \i Programmers Manu-\line \expndtw4 al, \i0 Computer Science Div., Dept. of E.E.C.S., Univ. of California,\line \expndtw-1 Berkeley, CA, Nov. \lang1032 7, 1979.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1667\margrsxn1437\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li47\fi0\ri0\sb0\sa0\tlul\tx5227 \f2\fs20{\b0\i0\ul\cf0\charscalex135\expndt