}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;17;(0,0);(0,15572);(2909,15572);(2909,16576);(2960,16576);(2960,20344);(2960,20344);(2960,21600);(4608,21600);(4608,20344);(20287,20344);(20287,16576);(20287,16576);(20287,15572);(21600,15572);(21600,0);(0,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\qj\li0\fi0\ri14\sb0\sa0\sl-169\slmult0 \f2\fs20{\b0\i0\cf0\charscalex105\expndtw1\dn0\f2\cchs0\lang1033\fs14 Collect \expndtw14\loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'e9\'ef\'df\line \expndtw9\hich\af0\dbch\af2\loch\f0\cchs0\lang1033 Collectioi\line \expndtw1 Collect io \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'e9\line \expndtw4\hich\af0\dbch\af2\loch\f0\cchs0\lang1033 Collect ioi\line \expndtw8 Graphics\line Graphics}\par \column \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-169\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-13\dn0\loch\af0\hich\af0\dbch\f24\cchs161\lang1032\fs14 \'c2\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 e h a \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'ed\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 i \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'ef\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 r a. 11D y \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'e7\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 a m i c S \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'f5\hich\af0\dbch\af24\loch\f0\cchs161  \loch\af0\hich\af0\dbch\f24\cchs161 \'f1\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 e r c I a s s e s\line \expndtw-12\loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'c2\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 e h a v i \i\loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'ef\hich\af0\dbch\af24\loch\f0\cchs161  \lang1033 r \i0 a 111 n s t a n c e s}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa