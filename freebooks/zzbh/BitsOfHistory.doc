}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(3403,0);(3403,1036);(0,1036);(0,21600);(21600,21600);(21600,1036);(21600,1036);(21600,0);(3403,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-180\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 Apply hash\line \expndtw2 function to\line \expndtw-2 long Oop}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb763\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 This long Oop is not equal to ours.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2885\margrsxn2605\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb209\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2885\margrsxn2605\margtsxn1440\margbsxn720\cols3\colno1\colw720\colsr1685\colno2\colw756\colsr2027\colno3\colw1231 {\shp {\*\shpinst \shpleft839\shptop238\shpright3841\shpbottom1095\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw5295\pich1511\picwgoal3002\pichgoal856\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(17145,0);(17145,1270);(0,1270);(0,21600);(21600,21600);(21600,1270);(21600,1270);(21600,0);(17145,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Probe}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb68\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 Short Oop}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb587\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs18 Likewise, a miss.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1675\margrsxn1313\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li2048\ri3877\sb842\sa0{\pict\picw5283\pich901\picwgoal2995\pichgoal511\jpegblip
}\par\pard \plain \cbpat0\qj\li6394\fi0\ri227\sb0\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 This long Oop is the one we are\line \expndtw1 looking for. This object's short\line \expndtw0 Oop is the answer.}\par \pard \plain \cbpat0\ql\li918\fi0\ri0\sb450\sa0 \f2\fs20{\b0\i0\cf0\charscalex112\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.3}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1863\margrsxn1431\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li6869\fi0\ri0\sb0\sa0\tlul\tx8284 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex116\expndtw-10\dn0\f3\cchs0\lang1033\fs18 j?57}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex116\expndtw3\dn0\f3\cchs0\lang1033\fs18 The LOOM Details}\par \pard \plain \cbpat0\ql\li1962\fi0\ri0\sb230\sa0\sl-209\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 How Objects in Primary and \b0 Secondary Memory\line \expndtw4 Refer to Other Objects.}\par \pard \plain \cbpat0\ql\li1591\fi0\ri0\sb774\sa1087\sl-220\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Hash a long Oop into the ROT and see\line \expndtw2 if the object is cached in primary memory}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1863\margrsxn1597\margtsxn1440\margbsxn720\cols4\colno1\colw1209\colsr490\colno2\colw1915\colsr1037\colno3\colw1173\colsr518\colno4\colw2106 {\shp {\*\shpinst \shpleft526\shptop-1030\shpright5660\shpbottom-1030\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 20320}}}}{\shp {\*\shpinst \shpleft1548\shptop-79\shpright3730\shpbottom-79\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft6206\shptop-79\shpright8582\shpbottom-79\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft1548\shptop-86\shpright1548\shpbottom2074\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft3701\shptop-79\shpright3701\shpbottom2074\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft6206\shptop-79\shpright6206\shpbottom1361\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft8554\shptop-58\shpright8554\shpbottom1368\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb11\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 A Short Oop-}\par \column \pard \plain \cbpat0\ql\li0\fi475\ri0\sb76\sa0\sl-209\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The object\line \expndtw-1 (in Primary Memory)}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 A Long Oop.}\par \column \pard \plain \cbpat0\ql\li0\fi572\ri0\sb83\sa0\sl-205\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 The object\line \expndtw-2 (in Secondary Memory)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3908\margrsxn2094\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb288\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3908\margrsxn2094\margtsxn1440\margbsxn720\cols2\colno1\colw1252\colsr3546\colno2\colw1108 {\shp {\*\shpinst \shpleft4162\shptop-144\shpright6545\shpbottom-144\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft-497\shptop-137\shpright1677\shpbottom-137\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb7\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 The object's\line \expndtw-3 own long Oop}\par \column \pard \plain \cbpat0\ql\li313\fi-313\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The object's\line \expndtw0 fields}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1863\margrsxn1431\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft6206\shptop101\shpright8589\shpbottom101\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft1555\shptop108\shpright3729\shpbottom108\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}\pard \plain \cbpat0\ql\li2430\fi-320\ri0\sb274\sa1163\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 The object's\line \expndtw-1 fields}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2468\margrsxn2148\margtsxn1440\margbsxn720\cols2\colno1\colw2174\colsr2344\colno2\colw2775 {\shp {\*\shpinst \shpleft950\shptop-1048\shpright3124\shpbottom-1048\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft-547\shptop-104\shpright3514\shpbottom-104\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft3881\shptop-104\shpright7949\shpbottom-104\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li907\fi0\ri0\sb4\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 Primary Memory}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb148\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.4}\par \column \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 Secondary Memory}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 Objects here do not know if they}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 are currently cached in main memory.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1863\margrsxn1431\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qj\li1955\fi0\ri11\sb403\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 When an object on secondary storage is brought into main memory, its\line \expndtw3 fields must be translated from the long form to short form. The object is\line assigned an appropriate short Oop (one to which its long Oop hashes), a\line \expndtw6 block of memory is reserved for it, and all of its fields are translated\line \expndtw3 from long Oops to short Oops. Those fields that point to objects already\line \expndtw5 in main memory are given the short Oops of those objects; those that\line \expndtw6 point to objects not in main memory are handled in one of two ways,\line \expndtw4 with leaves or with lambdas.}\par \pard \plain \cbpat0\qj\li1951\fi0\ri14\sb241\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 Q \i Leaves \i0 Leaves are pseudo-objects that represent an object on sec-\line \expndtw3 ondary storage. They have a short Oop hashed by that object's long Oop\line \expndtw7 and a ROT entry, but their image in memory only contains a length\line \expndtw3 word, disk address words, and the delta word. Their image contains no\line \expndtw4 class word or fields, as shown in Fig. \lang1032 14.5. \lang1033 Leaves therefore, only take\line \expndtw3 up \lang1032 4 \lang1033 words of memory, whereas the average object takes up \lang1032 13. \lang1033 Leaves\line \expndtw4 are created without looking at that object's image on secondary storage.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1600\margrsxn1406\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs18 258}\par {\shp {\*\shpinst \shpleft-4\shptop-18\shpright6094\shpbottom-18\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex123\expndtw-2\dn0\f3\cchs0\lang1033\fs18 LOOM \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par \pard \plain \cbpat0\qj\li2243\fi0\ri0\sb259\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 This is very important, since a major cost in virtual memories is the\line number of disk accesses. The short Oop of the leaf may be treated as if\line \expndtw2 it were the short Oop of the object; it may be pushed and popped on the\line \expndtw3 stack, stored into fields of other objects, without ever needing the actual\line \expndtw4 contents of that object. Its reference count can be incremented and\line \expndtw0 decremented (see p. \lang1032 262).}\par \pard \plain \cbpat0\ql\li5188\fi0\ri0\sb144\sa346 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 A Leaf}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4195\margrsxn1410\margtsxn1440\margbsxn720\cols3\colno1\colw720\colsr1555\colno2\colw1267\colsr1332\colno3\colw1429 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb11\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs16 ROT}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 Primary Memory}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Secondary Memory}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn6676\margrsxn3343\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-198\shptop140\shpright-198\shpbottom1486\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft2560\shptop436\shpright2560\shpbottom3431\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-2905\posnegy155\absw0\absh1879\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw4216\pich3314\picwgoal2390\pichgoal1879\jpegblip
}\par\pard \plain \li0\ri0\sb0\sa0\pvpara\phcol\posnegx1040\posnegy18\absw0\absh1224\dfrmtxtx40\dfrmtxty0 {\pict\picw2108\pich2159\picwgoal1195\pichgoal1224\jpegblip
}\par\pard \plain \cbpat0\ql\li230\fi0\ri0\sb108\sa0\sl-324\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs18 Long\line Oop}\par {\shp {\*\shpinst \shpleft-191\shptop32\shpright1004\shpbottom32\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li198\fi0\ri0\sb115\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f2\cchs0\lang1033\fs18 Delta}\par {\shp {\*\shpinst \shpleft-191\shptop-68\shpright1004\shpbottom-68\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs18 Length \lang1032 (4)}\par {\shp {\*\shpinst \shpleft-198\shptop61\shpright1004\shpbottom61\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}\pard \plain \cbpat0\ql\li457\fi0\ri0\sb634\sa817\sl-184\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The object in\line \expndtw0 Secondary Memory}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2489\margrsxn1432\margtsxn1440\margbsxn720\cols2\colno1\colw1087\colsr234\colno2\colw6667 {\shp {\*\shpinst \shpleft6746\shptop-320\shpright7956\shpbottom-320\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex110\expndtw-4\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.5}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri7\sb331\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 An object is always in one of three states. Either the entire object is in\line \expndtw3 main memory, a leaf for the object is in main memory, or the object ex-\line \expndtw4 ists only on the disk. See Fig. \lang1032 14.6. \lang1033 When the interpreter needs a field\line \expndtw3 from an object which is represented by a leaf, the entire object with its\line \expndtw2 fields must be brought into main memory from disk. Since the leaf con-\line \expndtw3 tains the disk Oop, the body is easy to find. After the body is translated\line \expndtw4 into main memory form, its core address is stored into the leaf's OT en-\line \expndtw3 try, and the leaf body is discarded. Short Oop references to the object\line \expndtw5 remain the same, but now the full object is actually there. Since a leaf\line \expndtw3 can be substituted for an object body and vice versa with no effect on\line \expndtw2 pointers to the object, LOOM is always free to make more room in main\line \expndtw4 memory by turning resident objects into leaves.}\par \pard \plain \cbpat0\qj\li4\fi0\ri0\sb230\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw8\dn0\loch\af1\dbch\af25\hich\f1\cchs161\lang1032\fs22 \u9633\'3f\hich\af1\dbch\af25\loch\f1\cchs161  \i\lang1033 Lambdas \i0 Lambdas are the second way to represent fields of resi-\line dent objects that refer to objects on secondary storage. Lambda is a\line \expndtw6 place holder for a pointer to an object which has not been assigned a\line \expndtw3 short Oop. Its purpose is to reduce the number of leaves in the system.\line Lambda is a pseudo-Oop, a reserved short Oop (the Oop \lang1032 0) \lang1033 which is not\line \expndtw4 the name of any resident object. Consider an object which has a lambda\line \expndtw6 in one of its fields. To discover the actual value of that field, LOOM\line \expndtw8 must go back to the object's image on secondary storage, look in that}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2442\margrsxn1435\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li6239\fi0\ri0\sb0\sa0\tlul\tx7747 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f24\cchs161\lang1032\fs18 259}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 The LOOM Details}\par \pard \plain \cbpat0\ql\li3388\fi0\ri0\sb220\sa407 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs22 States of an Object in LOOM}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3972\margrsxn1590\margtsxn1440\margbsxn720\cols3\colno1\colw1422\colsr1242\colno2\colw1018\colsr1368\colno3\colw1296 {\shp {\*\shpinst \shpleft4982\shptop-76\shpright6429\shpbottom-76\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft-94\shptop-68\shpright1504\shpbottom-68\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft2556\shptop-68\shpright3766\shpbottom-68\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft-94\shptop-68\shpright-94\shpbottom486\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft1490\shptop-68\shpright1490\shpbottom486\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft2563\shptop-68\shpright2563\shpbottom594\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft4982\shptop-76\shpright4982\shpbottom594\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}{\shp {\*\shpinst \shpleft3751\shptop-68\shpright3751\shpbottom594\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft6415\shptop-83\shpright6415\shpbottom587\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb36\sa0\sl-169\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The entire object is\line \expndtw0 in main memory}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb14\sa0\sl-173\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 A leaf for this\line object is in\line \expndtw-1 main memory}\par \column \pard \plain \cbpat0\qj\li7\fi0\ri0\sb0\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 The object exists\line \expndtw-1 only in secondary\line \expndtw4 storage}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn5153\margrsxn2450\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb580\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn5153\margrsxn2450\margtsxn1440\margbsxn720\cols2\colno1\colw1018\colsr1771\colno2\colw1515 {\shp {\*\shpinst \shpleft3794\shptop-544\shpright5248\shpbottom-544\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft1375\shptop-536\shpright2592\shpbottom-536\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 Expand a leaf}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb14\sa0\sl-187\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Resolve a long Oop\line \expndtw0 (Assign a short Oop)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2442\margrsxn1435\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb929\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2442\margrsxn1435\margtsxn1440\margbsxn720\cols2\colno1\colw1094\colsr328\colno2\colw6609 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb1350\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.6}\par \pard\plain\fs2\sa0\sl-1\slmult0\column\par\trowd\trgaph40 \trrh-547 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1627 \clvertalt\clbrdrl\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx2412 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx4104 \clvertalt\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx4896 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx6610 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-184\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The entire object is\line \expndtw0 in main memory}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard \plain \cbpat0\ql\li0\fi32\ri0\sb0\sa0\sl-184\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 A leaf for this object\line \expndtw0 is in main memory}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-180\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The object exists only\line \expndtw3 in secondary storage}\cell \pard\intbl\row \trowd\trgaph40 \trrh-1044 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx2412 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx4104 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx6610 \pard \plain \cbpat0\ql\li1264\fi0\ri266\sb0\sa0\sl-184\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs18 Contract\line \expndtw0 to a leaf}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i\cf0\charscalex100\expndtw58\dn0\f25\cchs161\lang1032\fs18 *              \i0\lang1033 \\}\cell \pard \plain \cbpat0\ql\li248\fi0\ri1310\sb0\sa0\sl-184\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 Retire a\line short Oop}\cell \pard\intbl\row \pard\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2442\margrsxn1435\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qj\li1336\fi0\ri40\sb317\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 field for a long pointer, and create a leaf or resident object. This means\line \expndtw4 that the cost of fetching a lambda field is an extra disk reference. How-\line \expndtw6 ever, unlike leaves, lambdas do not take up ROT entries (they all use\line \expndtw4 the single pseudo-ROT entry at \lang1032 0) \lang1033 and they do not take up any main\line \expndtw2 memory storage. Since the number of ROT entries is limited to 2\super 15\nosupersub , and\line \expndtw4 main memory is a somewhat scarce resource, this saving can be impor-\line \expndtw3 tant. During an object's typical stay in main memory, some of its fields\line \expndtw9 will not be referenced. If leaves are created for the values in those\line \expndtw7 fields when the object is swapped in, and then destroyed again when\line the object is thrown out, much work is wasted. Putting lambdas into\line \expndtw3 fields which will not be referenced during the object's current stay in\line \expndtw8 primary memory saves both the space and the time needed to create\line \expndtw4 and destroy many leaves.}\par \pard \plain \cbpat0\qj\li1328\fi234\ri36\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 Determining whether to make the fields of an object be leaves or\line \expndtw3 lambdas when the object is brought into main memory is a tricky busi-\line \expndtw9 ness. The choice of strategy strongly affects the performance of a\line \expndtw3 LOOM system. Creating a leaf takes more time and uses up more mem-\line \expndtw6 ory and a ROT entry, but does not cause any extra disk accesses. A\line lambda will cause an extra disk access if the field it occupies happens\line \expndtw5 to be referenced, but a lambda is faster to create. One way to make the\line \expndtw2 decision between leaf and lambda is to rely on history; if a field was a\line \expndtw3 lambda when this object was written to the disk one time, it is likely to\line \expndtw6 remain a lambda during its next trip into main memory. Each pointer\line \expndtw8 field of the disk contains a hint, the \i noLambda \i0 bit, and the object\line \expndtw3 faulting code follows the advice of the hint.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1719\margrsxn1262\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\tlul\tx6102 \f2\fs20{\b0\i0\ul\cf0\charscalex134\expndtw-14\dn0\f25\cchs161\lang1032\fs16 260{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb7\sa238 \f2\fs20{\b0\i0\cf0\charscalex134\expndtw2\dn0\f3\cchs0\lang1033\fs16 LOOM \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1730\margrsxn1262\margtsxn1440\margbsxn720\cols2\colno1\colw1861\colsr392\colno2\colw6663 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb263\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex123\expndtw-1\dn0\f3\cchs0\lang1033\fs20 The Translation\line \expndtw-3 Between Object\line \expndtw-1 Representations}\par {\shp {\*\shpinst \shpleft-11\shptop1940\shpright1890\shpbottom1940\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}\pard \plain \cbpat0\ql\li25\fi0\ri0\sb2128\sa0 \f2\fs20{\b0\i\cf0\charscalex123\expndtw-2\dn0\f3\cchs0\lang1033\fs20 When to Translate}\par \column \pard \plain \cbpat0\qj\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw0\dn0\f3\cchs0\lang1033\fs20 Translating between the memory-resident and secondary-storage repre-\line \expndtw1 sentations of an object is straightforward. For those fields that contain\line \expndtw-1 short Oops, the Oop refers to an object or a leaf. The corresponding long\line \expndtw3 Oop can be found in the header of the object or leaf. If the field refers\line \expndtw4 to an object which has not yet been assigned a long pointer, a long\line \expndtw0 pointer is assigned to the object and a copy is installed in the field. For\line \expndtw5 those fields that contain lambdas, the field is guaranteed not to be\line \expndtw0 changed from the object's previous disk image. (The object's disk image\line is read before it is written). If the object being translated still has some\line \expndtw1 short pointers to it (has a positive in-core reference count), then it must\line \expndtw0 be converted to a leaf instead of being deleted completely from core.}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb212\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw2\dn0\f3\cchs0\lang1033\fs20 We have already mentioned when the translation between representa-\line tions must occur. When a field of an object being brought into main\line \expndtw3 memory has the noLambda bit set, and that field refers to a non-resi-\line \expndtw2 dent object, then a leaf is created. A leaf is also created when a field of\line \expndtw1 a resident object containing a lambda is accessed. When the interpreter\line \expndtw-2 needs to access a field in a leaf, the flow of control in LOOM begins (see\line \expndtw1 Fig. \lang1032 14.7). \lang1033 The leaf is expanded into a resident object; its fields are\line \expndtw0 translated from long form to short form. This is called an \i object fault\line \i0\expndtw1 (because the similar situation in paging virtual memory systems, trying\line \expndtw-1 to access a page that is not resident, is called a \i page fault). \i0 The inverse\line \expndtw3 operation, \i contracting \i0 an object into a leaf, may be done at any time.\line \expndtw-1 The final part of an object's journey into primary memory consists of\line \expndtw3 destroying the leaf and reusing its short Oop and memory space. This\line \expndtw2 can only be done when there are no longer any fields in any resident\line \expndtw0 objects pointing to the leaf.}\par \pard \plain \cbpat0\qj\li0\fi238\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw3\dn0\f3\cchs0\lang1033\fs20 Lambdas may be resolved into leaves and leaves may be expanded\line \expndtw4 into full objects before they are needed, and this is called a \i prefetch.\line \i0\expndtw3 The complementary operations of contraction and prefetch of objects\line \expndtw1 can both be done in the background. The exact order and mix of objects\line to prefetch or contract can be adjusted at run-time to optimize the per-\line \expndtw-1 formance of secondary storage (disk head movement or network traffic).}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1719\margrsxn1262\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft0\shptop576\shpright8921\shpbottom576\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb893\sa0\sl-238\slmult0\tx2264 \f2\fs20{\b\i0\cf0\charscalex123\expndtw0\dn0\f3\cchs0\lang1033\fs20 LOOM{\charscalex100\expndtw0\tab }\b0\charscalex113\expndtw-5 In   this   section,   we   provide   some   details   of   how   LOOM   may   be}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0\tx2264 \f2\fs20{\b\i0\cf0\charscalex113\expndtw3\dn0\f3\cchs0\lang1033\fs20 Implementation      \b0 implemented. In particular we discuss the discovery of object faults, ref-\line \b\charscalex143\expndtw-4 Details{\charscalex100\expndtw0\tab }\b0\charscalex113\expndtw3 erence-counting, and the assignment of the extra bits in the ROT entry}\par \pard \plain \cbpat0\ql\li2264\fi0\ri0\sb0\sa94\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw2\dn0\f3\cchs0\lang1033\fs20 and the delta word.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1719\margrsxn1287\margtsxn1440\margbsxn720\cols2\colno1\colw1324\colsr918\colno2\colw6660 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb234\sa0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs24 Object Faults}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw3\dn0\f3\cchs0\lang1033\fs20 Object faults occur when the interpreter tries to access a field in a leaf\line \expndtw1 or a field in an object whose value is lambda. By the time the interpret-\line er scrutinizes them, all objects must be full resident objects. How can\line leaves and lambdas be discovered without greatly slowing the speed of\line \expndtw5 the interpreter?}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1818\margrsxn1339\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li5843\fi0\ri0\sb0\sa0\tlul\tx8366 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18  \ul\charscalex124\expndtw-24 261}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex124\expndtw-1\dn0\f3\cchs0\lang1033\fs18 LOOM Implementation Details}\par \pard \plain \cbpat0\ql\li2689\fi0\ri0\sb234\sa421 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-6\dn0\f3\cchs0\lang1033\fs22 The Flow of Control in LOOM}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2711\margrsxn2617\margtsxn1440\margbsxn720\cols3\colno1\colw1360\colsr1094\colno2\colw1530\colsr965\colno3\colw1630 {\shp {\*\shpinst \shpleft-220\shptop-72\shpright1587\shpbottom-72\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft2322\shptop-65\shpright4100\shpbottom-65\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft4856\shptop-65\shpright6656\shpbottom-65\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft-220\shptop-72\shpright-220\shpbottom425\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft1559\shptop-65\shpright1559\shpbottom425\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft2329\shptop-65\shpright2329\shpbottom425\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft4072\shptop-65\shpright4072\shpbottom432\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft4864\shptop-65\shpright4864\shpbottom432\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}{\shp {\*\shpinst \shpleft6628\shptop-65\shpright6628\shpbottom432\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-169\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 The entire object\line \expndtw-1 is in main memory}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-173\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 A leaf for this object\line \expndtw0 is in main memory}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The object exists only\line \expndtw3 in secondary storage}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1818\margrsxn1339\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb40\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1818\margrsxn1339\margtsxn1440\margbsxn720 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx673\posnegy0\absw0\absh504\nowrap\dfrmtxtx10080\dfrmtxty0 {\pict\picw4978\pich889\picwgoal2822\pichgoal504\jpegblip
}\par{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4003\margrsxn4090\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb79\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4003\margrsxn4090\margtsxn1440\margbsxn720\cols3\colno1\colw738\colsr1181\colno2\colw720\colsr457\colno3\colw720 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs18 Expand\line \expndtw2 the object}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb313\sa0\sl-821\slmult0 \f2\fs20{\b\i\cf0\charscalex153\expndtw0\dn15\f2\cchs0\lang1033\fs112 f}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb11\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs18 Resolve a\line long Oop}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2682\margrsxn1717\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb180\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2682\margrsxn1717\margtsxn1440\margbsxn720\cols2\colno1\colw2376\colsr2156\colno2\colw2977 {\shp {\*\shpinst \shpleft-248\shptop-43\shpright602\shpbottom-43\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft2689\shptop-36\shpright3596\shpbottom-36\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft-212\shptop3996\shpright-212\shpbottom4500\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx515\posnegy0\absw0\absh2037\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw4140\pich3594\picwgoal2347\pichgoal2037\jpegblip
}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-220\slmult0 \f2\fs20\pvpara\phmrg\posnegx-864\posnegy360\absw2120\absh-662\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs24 The interpreter needs a\line \expndtw-6 field from an object\line which is a leaf}\par \pard \plain \cbpat0\qj\li4\fi0\ri0\sb0\sa0\sl-220\slmult0 \f2\fs20\pvpara\phmrg\posnegx2113\posnegy374\absw1962\absh-662\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs24 Expand needs to con-\line vert long Oop in each\line \expndtw-5 field to a short Oop}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20\pvpara\phmrg\posnegx468\posnegy2376\absw2048\absh-651\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs24 May have to contract\line \expndtw-4 some objects to get\line \expndtw-9 space in main memory}\par {\shp {\*\shpinst \shpleft1775\shptop2038\shpright4122\shpbottom4522\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw4140\pich4381\picwgoal2347\pichgoal2484\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;17;(463,0);(463,2754);(6824,2754);(6824,5947);(6957,5947);(6957,9015);(0,9015);(0,21600);(21600,21600);(21600,9015);(21600,9015);(21600,5947);(21600,5947);(21600,2754);(21600,2754);(21600,0);(463,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}{\shp {\*\shpinst \shpleft817\shptop4378\shpright2660\shpbottom5343\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw3251\pich1701\picwgoal1843\pichgoal964\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(6243,0);(6243,3062);(0,3062);(0,21600);(21600,21600);(21600,3062);(21600,3062);(21600,0);(6243,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-173\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 The entire object\line \expndtw-1 is in main memory}\par {\shp {\*\shpinst \shpleft-212\shptop-853\shpright1595\shpbottom-853\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li1001\fi0\ri0\sb0\sa0\sl-180\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 Contract an object\line \expndtw1 to a leaf      If}\par \column \pard \plain \cbpat0\ql\li929\fi0\ri0\sb155\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs24 In the very rare case\line that there is no empty\line \expndtw-4 ROT entry with the\line \expndtw-3 proper hash, contract\line objects until such an\line \expndtw-4 entry is freed}\par {\shp {\*\shpinst \shpleft1390\shptop324\shpright2276\shpbottom324\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft346\shptop2556\shpright2146\shpbottom2556\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li443\fi0\ri0\sb2628\sa0\sl-180\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 The object exists only\line \expndtw3 in secondary storage}\par {\shp {\*\shpinst \shpleft346\shptop43\shpright2146\shpbottom43\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 15875}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb889\sa0\sl-180\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 Retire a short Oop\line \expndtw0 (Destroy the leaf)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3672\margrsxn2833\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb508\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3672\margrsxn2833\margtsxn1440\margbsxn720\cols2\colno1\colw1940\colsr1480\colno2\colw1983 {\shp {\*\shpinst \shpleft295\shptop-274\shpright1310\shpbottom-274\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft3744\shptop-266\shpright4738\shpbottom-266\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs24 Contract converts   \\\line \expndtw-4 many short Oops to\line \expndtw-9 long Oops}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb14\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs24 The last short Oop \\\line \expndtw-4 pointing to a leaf is\line destroyed}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1818\margrsxn1339\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft2207\shptop198\shpright3136\shpbottom198\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft5612\shptop205\shpright6555\shpbottom205\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li659\fi0\ri0\sb410\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-7\dn0\f3\cchs0\lang1033\fs24 Figure \lang1032 14.7}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1676\margrsxn1320\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\tlul\tx6098 \f2\fs20{\b0\i0\cf0\charscalex132\expndtw-14\dn0\f25\cchs161\lang1032\fs16 262{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex132\expndtw4\dn0\f3\cchs0\lang1033\fs16 LOOM \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par \pard \plain \cbpat0\qj\li2236\fi241\ri4\sb241\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw3\dn0\f3\cchs0\lang1033\fs20 It has been our experience that implementations tend to have a sin-\line \expndtw0 gle subroutine (or expanded macro) that takes an Oop and sets up some\line base register to point to the actual address of that object. We call this\line \expndtw-1 subroutine "Otmap." It corresponds roughly to the ot:bits: method of the\line \expndtw0 memory manager in the formal specification of the Smalltalk-80 virtual\line \expndtw5 machine, in \i Smalltalk-80: The Language and its Implementation\super 4\nosupersub .\line \i0\expndtw-1 Otmap is called if and only if you want to fetch or store a field of an ob-\line \expndtw0 ject. Note that this is exactly the condition where you must test for the\line \expndtw-2 object being a leaf. (Otmap may sometimes be used for other purposes\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\line \expndtw4\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 for example a compaction routine may call Otmap to get the main\line \expndtw1 memory address of the object in order to move it, but it wants to treat\line \expndtw0 leaves and objects the same. These cases tend to be rare, so it is worth\line \expndtw1 having a second subroutine for them.) We reserve one bit of the ROT\line entry to say whether the entry is for an object or a leaf. The Otmap\line \expndtw2 subroutine tests this bit and calls the LOOM routines when the entry is\line \expndtw1 a leaf. Since both words of the ROT entry are fetched anyway, this ex-\line \expndtw2 tra test usually only costs one or two extra instruction executions.}\par \pard \plain \cbpat0\qj\li2250\fi238\ri11\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Testing for lambda however, must be done on \i every \i0 field reference. In\line \expndtw3 the worst case, this would mean testing occurs every time a field is\line \expndtw5 fetched from an object and every time an object is pushed onto the\line \expndtw1 stack. To decrease the number of tests, we include one bit in each resi-\line \expndtw4 dent object called "holds lambda." It is set by the LOOM routines\line \expndtw2 whenever that object has a field that is a lambda. The interpreter guar-\line \expndtw3 antees that the current context, the home context, the current method,\line \expndtw1 and the receiver all have no lambdas in them. If any of them does con-\line tain a lambda, then the LOOM routines are called to make those fields\line \expndtw0 into leaves. In this way, the most common fields fetched and all stack\line operations can work without testing for lambda. Note that these objects\line \expndtw-1 must be cleared of lambdas only when the active context changes. This\line \expndtw1 occurs during message sends, returns, process switches, and during the\line \expndtw-3 execution of BlockContext value and value:.}\par \pard \plain \cbpat0\qj\li2257\fi234\ri11\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw3\dn0\f3\cchs0\lang1033\fs20 It is useful to note that the LOOM design actually will work with\line \expndtw1 leaves alone, and without lambdas. When the expand routine brings an\line \expndtw2 object into main memory, it turns all the fields into leaves and never\line \expndtw6 creates a lambda. This approach tends to use more short Oops and\line \expndtw-1 main memory than the full LOOM design, but could be an intermediate\line \expndtw1 stage in the implementation; providing a working virtual memory sys-\line \expndtw2 tem with only the modification to the Otmap subroutine.}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb284\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw2\dn0\f3\cchs0\lang1033\fs20 Although some Smalltalk-80 implementations use mark/sweeping gar-}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb4\sa0\sl-234\slmult0\tx2261 \f2\fs20{\b0\i\cf0\charscalex118\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Reference{\charscalex100\expndtw0\tab }\i0\charscalex113\expndtw1 bage collection, most implementations so far, including ours, use refer-}\par \pard \plain \cbpat0\ql\li14\fi0\ri0\sb0\sa0\sl-234\slmult0\tx2264 \f2\fs20{\b0\i\cf0\charscalex123\expndtw-3\dn0\f3\cchs0\lang1033\fs20 Counting{\charscalex100\expndtw0\tab }\i0\charscalex113\expndtw1 ence  counting  to  identify  garbage.   Therefore  we  will  describe  the}\par \pard \plain \cbpat0\qj\li2261\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw-1\dn0\f3\cchs0\lang1033\fs20 reference-counting scheme as it applies to LOOM. Reference counting\line \expndtw1 serves two different purposes. One purpose is to detect when the total\line \expndtw3 count of any object goes to zero. The other is to detect when the last\line short pointer to any object disappears so that the short pointer may be}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1645\margrsxn1343\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri11\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs16 263}\par \pard \plain \cbpat0\ql\li6088\fi0\ri0\sb0\sa194 \f2\fs20{\b0\i0\cf0\charscalex139\expndtw-1\dn0\f3\cchs0\lang1033\fs16 LOOM Implementation Details}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1645\margrsxn1343\margtsxn1440\margbsxn720\cols2\colno1\colw1702\colsr544\colno2\colw6674 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb9788\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs24 Other Data\line \expndtw2 LOOM Holds for\line Each Object}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 reused. The resident Smalltalk-80 interpreter keeps reference counts of\line \expndtw2 short pointers. This count is kept in the ROT. LOOM uses the ROT ref-\line \expndtw3 erence count to keep the number of short pointers to an object. In addi-\line \expndtw4 tion, every object on the disk contains a reference count which is the\line \expndtw3 number of long pointers to the object. The total count is the sum of the\line number of short and long pointers to an object. Whenever a long Oop is\line \expndtw4 converted to a short Oop and installed in a field in main memory, both\line counts for the object pointed at must change. To avoid a disk access to\line \expndtw6 find and modify the long Oop count every time a field is converted,\line \expndtw7 LOOM keeps a "delta" or running change in the long Oop reference\line \expndtw3 count for each object in main memory. The true long pointer reference\line count of any object is the count found on the disk in the object's header\line \expndtw7 plus the count found in the "delta" part of the object's delta word in\line \expndtw2 main memory. Fig. \lang1032 14.8 \lang1033 shows the ROT entry, object body, and disk im-\line \expndtw5 age of an object. The object has three short Oops pointing at it. It used\line \expndtw7 to have pointers from \lang1032 6 \lang1033 long Oops, but two were destroyed recently\line \expndtw1 (they were probably converted to short Oops). The total number of ref-\line \expndtw3 erences to the object is seven.}\par \pard \plain \cbpat0\qj\li18\fi238\ri7\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 There are three sources of reference-count changes. One pointer can\line \expndtw3 be stored over another, a long pointer can be converted to a short point-\line \expndtw9 er, and a short pointer can be converted back. Since the interpreter\line \expndtw4 only deals with short Oops, every store consists of a short pointer re-\line \expndtw5 placing another short pointer. This high-bandwidth operation touches\line \expndtw4 only the short pointer reference counts, so the existing code in the in-\line \expndtw3 terpreter does not need modification. When a leaf expands to a normal\line \expndtw2 object, pointers in its fields change from long Oops to short ones. The\line \expndtw3 expand-a-leaf routine increments the short count of that object and dec-\line \expndtw4 rements the delta of its long count. The inverse happens when the rou-\line \expndtw3 tine which shrinks objects into leaves converts short Oops to long ones.}\par \pard \plain \cbpat0\qj\li7\fi238\ri7\sb11\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Consider the case when the short Oop count of an object goes to zero.\line \expndtw3 The reference-count routine then looks at the object's long Oop count to\line \expndtw2 see if the total count of the object is zero. If it is zero, the object is truly\line \expndtw6 free, and its storage can be recycled. If not, the object is still held by\line \expndtw5 some long pointers. When the short Oop reference count goes to zero,\line \expndtw6 and the delta reference count is zero, then the object's long Oop count\line \expndtw7 on disk need not change. Thus if the ultimate long pointer count of a\line leaf can be guessed correctly when the leaf is created, the disk count\line \expndtw4 and delta count can be adjusted so that the leaf disappears from main\line \expndtw5 memory without further disk references.}\par \pard \plain \cbpat0\qj\li18\fi0\ri7\sb270\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 As a help to the LOOM system, two other bits are added to the ROT en-\line \expndtw5 try for any object\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 "clean" and "unTouched." Clean is cleared when-\line \expndtw4 ever a field of the object is changed; unTouched is cleared whenever a\line \expndtw3 field of the object is read or changed. Clean tells the LOOM system that\line it need not rewrite the object's image on disk (unless of course, its true\line \expndtw4 reference count changed). Clean is set when the object is newly created}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1218\margrsxn1795\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\tlul\tx6098 \f2\fs20{\b0\i0\ul\cf0\charscalex120\expndtw-14\dn0\f25\cchs161\lang1032\fs18 264{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex120\expndtw2\dn0\f3\cchs0\lang1033\fs18 LOOM \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par \pard \plain \cbpat0\qr\li0\fi0\ri1627\sb238\sa209 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 The Three Types of Reference Counts}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4742\margrsxn1806\margtsxn1440\margbsxn720\cols3\colno1\colw720\colsr1184\colno2\colw1033\colsr994\colno3\colw1429 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 ROT}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs18 Main Memory}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb11\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Secondary Memory}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn8134\margrsxn1939\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20\pvpara\phmrg\posnegx-4738\posnegy1663\absw0\absh-209\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs18 ROT Count}\par {\shp {\*\shpinst \shpleft-4342\shptop50\shpright0\shpbottom3413\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw7658\pich5930\picwgoal4341\pichgoal3362\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;9;(0,0);(0,10221);(2256,10221);(2256,21600);(21600,21600);(21600,10221);(21600,10221);(21600,0);(0,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard\plain\fs2\sa43\sl-1\slmult0\par\trowd\trgaph40 \trrh-353 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx641 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1217 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1836 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-234\slmult0 \intbl \f2\fs20{\b0\i\cf0\charscalex100\expndtw18\dn0\f3\cchs0\lang1033\fs18 f      \i0\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'bb\line \i\expndtw0 \'c3}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard\intbl\row \trowd\trgaph40 \trrh-310 \clvertalt\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx641 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1836 \pard \plain \cbpat0\ql\li184\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs16 /}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard\intbl\row \trowd\trgaph40 \trrh-590 \clvertalt\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx641 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1836 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 /}\par \pard \plain \cbpat0\ql\li0\fi0\ri72\sb0\sa0\sl-180\slmult0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs18 Di?k\line \expndtw0 Count}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard\intbl\row \trowd\trgaph40 \trrh-598 \clvertalt\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx641 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1836 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard\intbl\row \trowd\trgaph40 \trrh-626 \clvertalt\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx641 \clvertalt\clbrdrt\brdrs\brdrw15\clbrdrl\brdrs\brdrw15\clbrdrb\brdrs\brdrw15\clbrdrr\brdrs\brdrw15\cltxlrtb\cellx1836 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\cell \pard\intbl\row \pard\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2129\margrsxn1795\margtsxn1440\margbsxn720\cols2\colno1\colw1087\colsr241\colno2\colw6656 {\shp {\*\shpinst \shpleft8777\shptop3071\shpright8777\shpbottom4734\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb3712\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.8}\par \column \pard \plain \cbpat0\qc\li0\fi0\ri25\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs22 Example Reference Counts}\par \pard \plain \cbpat0\ql\li2344\fi0\ri0\sb328\sa0\sl-180\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 There are a total of seven references to this object.\line \expndtw2 Three are from short Oops and\line \expndtw0\lang1032 (6 \i\loch\af1\hich\af1\dbch\f25\cchs161 \'cb\i0 \'97\hich\af1\dbch\af25\loch\f1\cchs161 2) = 4 \lang1033 are from long Oops.}\par {\shp {\*\shpinst \shpleft2596\shptop655\shpright4266\shpbottom655\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft3085\shptop1253\shpright4266\shpbottom1253\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}\pard \plain \cbpat0\qc\li148\fi0\ri0\sb1325\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs18 -2}\par {\shp {\*\shpinst \shpleft3085\shptop36\shpright4266\shpbottom36\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft3085\shptop346\shpright4266\shpbottom346\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}{\shp {\*\shpinst \shpleft3085\shptop1217\shpright4266\shpbottom1217\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\qj\li4\fi0\ri0\sb1526\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 or swapped in. UnTouched is set by a routine that sweeps core whenev-\line \expndtw6 er space is needed. Any object that the routine finds with unTouched\line \expndtw4 still set has not been touched in an entire pass through memory, and is\line thus a candidate for being \i contracted \i0 (turned into a leaf).}\par \pard \plain \cbpat0\qj\li0\fi241\ri0\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The activity which is most likely to cause LOOM to thrash is the res-\line \expndtw4 olution of lambdas. When a lambda needs to be resolved (turned into a\line \expndtw2 leaf or discovered to be an existing short Oop), LOOM must first look at\line \expndtw10 the disk image of the parent object. If the pattern of computation is}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1172\margrsxn1799\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4190\fi0\ri0\sb0\sa0\tlul\tx8654 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex139\expndtw-18\dn0\f25\cchs161\lang1032\fs16 265}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb11\sa0 \f2\fs20{\b0\i0\cf0\charscalex139\expndtw0\dn0\f3\cchs0\lang1033\fs16 LOOM Implemented in the Smalltalk-80 Language}\par \pard \plain \cbpat0\qj\li2257\fi0\ri18\sb270\sa968\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 such that the noLambda hint does not correctly predict which fields are\line \expndtw7 needed by the interpreter, lambdas would have to be resolved often.\line \expndtw8 Even so, lambda resolution is likely to happen soon after the parent\line \expndtw7 was expanded, so keeping the most recently fetched disk pages in a\line \expndtw3 cache relieves the need to go to the disk. When a lambda needs to be\line resolved, the LOOM procedure looks first in the cache of pages that is\line \expndtw2 called the \i disk buffer. \i0 If it finds the object in the buffer, it can directly\line \expndtw3 retrieve the long Oop for the lambda, saving one disk access.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1172\margrsxn1817\margtsxn1440\margbsxn720\cols2\colno1\colw1573\colsr673\colno2\colw6674 {\shp {\*\shpinst \shpleft-4\shptop-306\shpright8931\shpbottom-306\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-10\dn0\f3\cchs0\lang1033\fs26 LOOM\line \expndtw7 Implemented\line \expndtw11 in the}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs26 Smalltalk-80\line \expndtw10 Language}\par \column \pard \plain \cbpat0\qj\li22\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The LOOM design, though based on only a couple of simple principles,\line \expndtw4 has a number of reasonably complex algorithms that require a substan-\line \expndtw1 tial amount of code. We were faced with the problem of whether to im-\line \expndtw3 plement LOOM's object swapping algorithms in a low-level language or\line \expndtw2 a high-level language. Low-level implementations typically provide bet-\line \expndtw3 ter performance at the cost of some flexibility.}\par \pard \plain \cbpat0\qj\li14\fi238\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 We opted to implement the LOOM system in our favorite high-level\line \expndtw4 system, the Smalltalk-80 system. A number of factors influenced this\line \expndtw3 choice. The overriding factor was that for us, the Smalltalk-80 language\line \expndtw7 was the most natural way to express and understand complex algo-\line \expndtw5 rithms. We are implementing LOOM on the Xerox Dorado computer\super 5\line \nosupersub\expndtw2 (see also Chapter \lang1032 7). \lang1033 We believe that the Dorado has sufficient perfor-\line \expndtw4 mance and memory space so that the LOOM system will not be called\line very often. When LOOM is called, it will run with acceptable perfor-\line \expndtw5 mance. Also, once the system is up and running, we will have a com-\line \expndtw6 plete, debugged high-level description of the algorithms. Should we\line \expndtw2 decide to reimplement LOOM on the Dorado or another machine in a\line \expndtw5 lower-level language, only a translation of the code would be required.\line \expndtw1 In addition, we designed LOOM not only as a working virtual memory\line \expndtw6 system for our Smalltalk-80 work, but also as a test-bed for virtual\line \expndtw2 memory techniques. Jim Stamos' master's thesis\super 6\nosupersub  is an example of one\line \expndtw7 experimental technique based on simulation. We want further studies\line \expndtw5 to use a real virtual memory system.}\par \pard \plain \cbpat0\qj\li0\fi241\ri11\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Deciding to implement LOOM in the Smalltalk-80 language itself led\line \expndtw2 to problems that might not be encountered in a low-level language im-\line \expndtw7 plementation. In particular, the amount of "machine state" that needs\line \expndtw6 to be saved when switching between running the Smalltalk-80 inter-\line \expndtw4 preter for "user" and for LOOM was quite large. The amount is much\line \expndtw11 larger than the amount of Smalltalk-80 virtual machine state that\line \expndtw2 would have to be saved to run the LOOM code written in machine lan-\line \expndtw5 guage. Also, to avoid a fault on the faulting code, all of the code and\line \expndtw2 other objects which comprise the implementation of LOOM must be\line \expndtw6 guaranteed to stay in main memory at all times.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1620\margrsxn1354\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li25\fi0\ri0\sb0\sa0\tlul\tx5195 \f2\fs20{\b0\i0\cf0\charscalex137\expndtw-14\dn0\f25\cchs161\lang1032\fs16 266{\charscalex100\expndtw0\tab }\expndtw77\lang1033 _^___}\par \pard \plain \cbpat0\ql\li25\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex137\expndtw-1\dn0\f3\cchs0\lang1033\fs16 LOOM      Large Object-Oriented Memory for Smalltalk-80 Systems}\par \pard \plain \cbpat0\qj\li2272\fi238\ri0\sb259\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 We handled the first problem, saving state, by reworking our inter-\line \expndtw8 preter. It now obeys the convention that within the execution of a\line \expndtw2 bytecode, an object fault is possible only before any "destructive" opera-\line \expndtw4 tions occur. In other words, before the interpreter writes into a field of\line any object or changes the reference count of any object, it reads fields\line \expndtw6 from all objects needed by the current bytecode. In this way, the state\line \expndtw5 we needed to save was only the "permanent" state that exists between\line \expndtw4 bytecodes. Temporary state within a bytecode is not saved. In our sys-\line \expndtw3 tem then, if an object fault occurs, we back up the Smalltalk program\line \expndtw6 counter, switch the interpreter to the LOOM system, handle the fault,\line and then restart the bytecode.}\par \pard \plain \cbpat0\qj\li2272\fi238\ri7\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The second problem, insuring that no object faults occur during the\line \expndtw5 execution of the LOOM algorithms themselves, went through a couple\line \expndtw3 of different designs. The first method we tried was to have the LOOM\line \expndtw7 objects and the user's objects in the same Smalltalk-80 space, but to\line \expndtw3 mark all the objects LOOM would ever need "unpurgable", and to guar-\line \expndtw4 antee that free space never went below a certain level. We made an al-\line \expndtw8 most-complete implementation of LOOM using this method on the\line \expndtw0 Xerox Alto computer\super 7\nosupersub  before moving onto the Dorado. The problem with\line \expndtw6 LOOM and the user sharing the same Smalltalk is retaining the marks\line \expndtw5 on objects that LOOM needs. If the user adds many methods to class\line \expndtw4 Small Integer and its method dictionary grows, how does the new array\line \expndtw8 in the dictionary get marked "unpurgable"? There are many similar\line \expndtw-4 cases.}\par \pard \plain \cbpat0\qj\li2268\fi234\ri14\sb0\sa1199\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw10\dn0\f3\cchs0\lang1033\fs22 The LOOM implementation on the Dorado has two separate\line \expndtw3 Smalltalk-80 systems in the same machine: a full-size system for user's\line \expndtw1 programs, and a smaller one for LOOM. The LOOM system has some\line \expndtw5 primitives that enable it to manipulate the bits inside of objects in the\line user system. (Note that because they use the same interpreter, the user\line system has these primitives also. However, they make no sense in the\line \expndtw1 user system, so are never used.) Because the LOOM system uses only a\line \expndtw7 small subset of the Smalltalk-80 system, it can be much smaller, and\line \expndtw3 can be guaranteed to fit entirely within its portion of main memory and\line \expndtw1 never cause an object fault. Fig. \lang1032 14.9 \lang1033 provides a view of the communica-\line \expndtw3 tion between the systems.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1620\margrsxn1368\margtsxn1440\margbsxn720\cols2\colno1\colw1360\colsr904\colno2\colw6656 {\shp {\*\shpinst \shpleft-4\shptop-310\shpright8924\shpbottom-310\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb7\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs28 Alternative}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs28 Smalltalk}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs28 Virtual}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-5\dn0\f3\cchs0\lang1033\fs28 Memory}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb4\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs28 Designs}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 The LOOM virtual memory design is only one of many ways to imple-\line \expndtw7 ment a virtual memory for a Smalltalk-80 system. The advantages of\line \expndtw2 the LOOM design are:}\par \pard \plain \cbpat0\ql\li497\fi-241\ri0\sb234\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw12\dn0\f25\cchs161\lang1032\fs22 1. \lang1033 It runs as fast as a resident Smalltalk-80 interpreter when the\line \expndtw3 working set is in core,}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2408\margrsxn1494\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li3254\fi0\ri0\sb0\sa0\tlul\tx7718 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex126\expndtw-19\dn0\f25\cchs161\lang1032\fs18 267}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex126\expndtw1\dn0\f3\cchs0\lang1033\fs18 Alternative Smalltalk Virtual Memory Designs}\par \pard \plain \cbpat0\ql\li1523\fi0\ri0\sb212\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs22 Two Separate Smalltalks in the Same Machine}\par \pard \plain \cbpat0\ql\li1220\fi0\ri0\sb324\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs18 User's Smalltalk}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn6232\margrsxn1714\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft-1397\shptop7171\shpright-1397\shpbottom8093\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\shp {\*\shpinst \shpleft-317\shptop7178\shpright-317\shpbottom7912\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-4558\posnegy6934\absw0\absh1548\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw5575\pich2730\picwgoal3160\pichgoal1548\jpegblip
}\par\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-176\slmult0 \f2\fs20\pvpara\phmrg\posnegx-4550\posnegy3017\absw2380\absh-716\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs18 (Really, these are the same\line \expndtw2 interpreter. Only pointers to the\line \expndtw4 interpreter state and location\line \expndtw0 of the ROT change)}\par \pard \plain \cbpat0\ql\li180\fi-180\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20\pvpara\phmrg\posnegx-2844\posnegy4187\absw2840\absh-1530\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Interpreter requests to LOOM:\line \expndtw5 Expand a leaf\line \expndtw4 Fix a lambda\line \expndtw2 Make more space\line Make more ROT space\line \expndtw1 Handle overflow\line \expndtw2 reference counts}\par \pard \plain \cbpat0\ql\li436\fi0\ri0\sb0\sa0 \f2\fs20\pvpara\phmrg\posnegx-1487\posnegy7394\absw871\absh-1281\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs22 ROT}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20\pvpara\phmrg\posnegx-1487\posnegy7394\absw871\absh-1281\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex111\expndtw-2\dn0\f3\cchs0\lang1033\fs18 Interpreter}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20\pvpara\phmrg\posnegx-1487\posnegy7394\absw871\absh-1281\nowrap\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex111\expndtw-1\dn0\f3\cchs0\lang1033\fs18 State}\par {\shp {\*\shpinst \shpleft-4572\shptop36\shpright410\shpbottom3557\shpfhdr0\shpbxmargin\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw8788\pich6210\picwgoal4982\pichgoal3520\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;29;(0,0);(0,13869);(0,13869);(0,14400);(0,14400);(0,17889);(10082,17889);(10082,18463);(10082,18463);(10082,19435);(10456,19435);(10456,19656);(10456,19656);(10456,21600);(21600,21600);(21600,19656);(19539,19656);(19539,19435);(19539,19435);(19539,18463);(18603,18463);(18603,17889);(18603,17889);(18603,14400);(18821,14400);(18821,13869);(21225,13869);(21225,0);(0,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}{\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}{\shp {\*\shpinst \shpleft1051\shptop511\shpright1994\shpbottom2973\shpfhdr0\shpbxcolumn\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw1663\pich4343\picwgoal943\pichgoal2462\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;25;(1648,0);(1648,12063);(16653,12063);(16653,12821);(17642,12821);(17642,14589);(18467,14589);(18467,17747);(16653,17747);(16653,18884);(0,18884);(0,21600);(21600,21600);(21600,18884);(21600,18884);(21600,17747);(21600,17747);(21600,14589);(21600,14589);(21600,12821);(21600,12821);(21600,12063);(21600,12063);(21600,0);(1648,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}\pard \plain \cbpat0\ql\li1202\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Resident Objects}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20\pvpara\phcol\posnegx-364\posnegy572\absw2070\absh-651\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Loom manipulation of\line \expndtw4 bits in user's ROT and\line resident object space}\par {\shp {\*\shpinst \shpleft-1138\shptop1750\shpright374\shpbottom5300\shpfhdr0\shpbxcolumn\shpbypara\shpwr5\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 75}}{\sp{\sn fFlipH}{\sv 0}}{\sp{\sn fFlipV}{\sv 0}}{\sp{\sn pib}{\sv {\pict\picw2667\pich6261\picwgoal1512\pichgoal3549\jpegblip
}}}{\sp{\sn pictureGray}{\sv 1}}{\sp{\sn pWrapPolygonVertices}{\sv 8;21;(205,0);(205,3286);(15428,3286);(15428,3724);(17074,3724);(17074,7229);(10697,7229);(10697,13801);(0,13801);(0,21600);(21600,21600);(21600,13801);(21600,13801);(21600,7229);(21600,7229);(21600,3724);(21600,3724);(21600,3286);(21600,3286);(21600,0);(205,0)}}{\sp{\sn fLayoutInCell}{\sv 1}}{\sp{\sn fIsBullet}{\sv 0}}{\sp{\sn fAllowOverlap}{\sv 1}}{\sp{\sn fEditedWrap}{\sv 0}}{\sp{\sn fBehindDocument}{\sv 1}}{\sp{\sn fPrint}{\sv 1}}{\sp{\sn dxWrapDistLeft}{\sv 0}}{\sp{\sn dxWrapDistRight}{\sv 0}}}}{\shp {\*\shpinst \shpleft-1721\shptop-940\shpright3816\shpbottom-940\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\qj\li2617\fi0\ri389\sb0\sa0\sl-176\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Objects on I\line Secondary \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'e9\line \expndtw3\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 Storage}\par \pard \plain \li2304\ri97\sb0\sa0{\pict\picw2755\pich2794\picwgoal1562\pichgoal1584\jpegblip
}\par\pard \plain \li0\ri0\sb0\sa0\pvpara\phcol\posnegx1937\posnegy1476\absw0\absh1786\dfrmtxtx40\dfrmtxty0 {\pict\picw2133\pich3149\picwgoal1209\pichgoal1785\jpegblip
}\par\pard \plain \cbpat0\ql\li1739\fi0\ri0\sb0\sa0\sl-216\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Loom manipulation of\line \expndtw5 user's objects in\line \expndtw4 secondary storage using\line \expndtw1 normal Smalltalk file\line \expndtw4 and ethernet code}\par \pard \plain \cbpat0\ql\li864\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f25\cchs161\lang1032\fs18 4 \lang1033 Primitives}\par {\shp {\*\shpinst \shpleft-2117\shptop-216\shpright1857\shpbottom-216\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Resident Objects}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2408\margrsxn1494\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb119\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 14.9}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1238\margrsxn1779\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\tlul\tx6102 \f2\fs20{\b\i0\ul\cf0\charscalex135\expndtw-14\dn0\f25\cchs161\lang1032\fs16 268{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb7\sa0 \f2\fs20{\b\i0\cf0\charscalex135\expndtw1\dn0\f3\cchs0\lang1033\fs16 LOOM \b0\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par {\pntext\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb227\sa0\tx2740 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb227\sa0\tx2740 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent260\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 It uses 16-bit fields in core to conserve space,}\par {\pntext\pard \plain \cbpat0\ql\li2740\fi-259\ri0\sb108\sa0\sl-238\slmult0\tx2740 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  3.\tab}\pard \plain \cbpat0\ql\li2740\fi-259\ri0\sb108\sa0\sl-238\slmult0\tx2740 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs22 It allows the interpreter to avoid handling 32-bit Oops, which\line \expndtw6 makes the interpreter smaller and faster on 16-bit machines,}\par {\pntext\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb101\sa0\tx2740 \b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22  4.\tab}\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb101\sa0\tx2740 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent260\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 It only uses memory for objects that are actually referenced, and}\par {\pntext\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb97\sa0\tx2740 \b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22  5.\tab}\pard \plain \cbpat0\ql\li2480\fi0\ri0\sb97\sa0\tx2740 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent260\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 It provides a large, 32-bit virtual address space.}\par \pard \plain \cbpat0\ql\li2236\fi0\ri0\sb166\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Its major disadvantages are:}\par {\pntext\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb227\sa0\sl-241\slmult0\tx2732 \b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22  1.\tab}\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb227\sa0\sl-241\slmult0\tx2732 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 It relies on fairly complicated algorithms to translate between the\line \expndtw1 address spaces,}\par {\pntext\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb119\sa0\sl-234\slmult0\tx2732 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb119\sa0\sl-234\slmult0\tx2732 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 It takes no advantage of current hardware technology for memory\line \expndtw4 fault detection, and}\par {\pntext\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb126\sa0\sl-234\slmult0\tx2732 \b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22  3.\tab}\pard \plain \cbpat0\ql\li2732\fi-259\ri0\sb126\sa0\sl-234\slmult0\tx2732 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-11\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 It must move objects between disk buffers and their place in mem-\line \expndtw-5 ory.}\par \pard \plain \cbpat0\qj\li2250\fi0\ri7\sb187\sa0\sl-241\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 There are alternatives to many of the design decisions within LOOM\line \expndtw3 and to using the LOOM design itself.}\par \pard \plain \cbpat0\qj\li2243\fi241\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 LOOM was designed specifically to experiment with various methods\line \expndtw4 of "grouping" objects on disk pages. If objects which are likely to be\line \expndtw6 faulted on at the same time live on the same disk page, only the first\line \expndtw5 fault actually has to wait for the disk. Static grouping restructures the\line \expndtw3 arrangement of objects on disk pages while the system is quiescent. It\line \expndtw6 reduces the number of disk accesses for both paged virtual memories\line \expndtw5 and object swapping systems. Stamos extensively studied the advan-\line \expndtw4 tages of static grouping and compared LOOM to paged virtual memo-\line \expndtw1 ries\super 8\nosupersub . LOOM is also designed for experiments in dynamic grouping. We\line \expndtw3 have several algorithms in mind for moving objects on the disk while\line \expndtw4 Smalltalk is running. These algorithms will endeavor to reduce faulting\line \expndtw3 by dynamically placing related objects on the same disk page.}\par \pard \plain \cbpat0\qj\li2246\fi234\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 We also mentioned that a LOOM system can be built that only uses\line \expndtw7 leaves and not lambdas. Another alternative that we did not pursue is\line \expndtw2 to use a marking garbage collection scheme for resident objects and ref-\line \expndtw4 erence counting for disk references. This should be possible using the\line \expndtw3 delta reference-count scheme.}\par \pard \plain \cbpat0\qj\li2239\fi241\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 LOOM is currently intended for use over a local area network. The\line \expndtw7 design could be extended to bring many users, many machines, and\line \expndtw4 large quantities of immutable data into the same large address space. If\line \expndtw2 32-bit long Oops are not big enough, objects in secondary memory could\line \expndtw-1 be quad-word aligned, giving 2\super 36\nosupersub  bytes of address space. The LOOM al-\line \expndtw7 gorithms are parameterized for the width of long pointers, so that a\line \expndtw2 change to 48-bit wide long Oops would not be difficult to do.}\par \pard \plain \cbpat0\qj\li2232\fi238\ri11\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 The LOOM design may be used for non-Smalltalk systems. In partic-\line \expndtw3 ular, we have proposed a LOOM-like design to extend the address space\line \expndtw6 of Interlisp-D. The design adds another level of virtual memory to the}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1226\margrsxn1748\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4183\fi0\ri0\sb0\sa0\tlul\tx8644 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\ul\cf0\charscalex100\expndtw-15\dn0\f25\cchs161\lang1032\fs22 269}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Acknowledgments}\par \pard \plain \cbpat0\ql\li2268\fi0\ri0\sb230\sa1058\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 existing Interlisp-D paging system by treating a page as a single object\line and an existing page address as a short pointer.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1226\margrsxn1755\margtsxn1440\margbsxn720\cols2\colno1\colw1742\colsr515\colno2\colw6670 {\shp {\*\shpinst \shpleft-25\shptop-306\shpright8910\shpbottom-306\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li18\fi0\ri0\sb0\sa0\sl-241\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs26 Learning from\line \expndtw-8 LOOM}\par \column \pard \plain \cbpat0\qj\li4\fi0\ri0\sb7\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Our LOOM virtual memory system is in its infancy. We are only begin-\line \expndtw5 ning to make measurements on its performance. The design choices of\line \expndtw3 the LOOM system are based on the belief that the way to design good\line \expndtw4 virtual memory systems is to determine what happens most of the time,\line \expndtw9 make it go fast, and hope it continues to happen most of the time.\line Many trade-offs were made to meet this goal. Some of the design\line \expndtw3 choices we made apply to almost all Smalltalk-80 implementations and\line \expndtw4 some were determined by our hardware/software environment. For ex-\line ample, the general idea that object swapping saves main memory over\line paging applies to all Smalltalk-80 systems, but the relative cost of ob-\line \expndtw2 ject swapping versus paging can be heavily influenced by hardware sup-\line \expndtw4 port for one or the other. Since we know of no current hardware that\line \expndtw3 supports object swapping, but we do know that a great deal of current\line \expndtw7 hardware supports paging, paging has a tremendous advantage. Many\line \expndtw4 of the costs of paging are hidden, such as the address computation on\line every memory reference, and the "built in" paging hardware on many\line \expndtw8 machines. If those costs were brought into the open, and the same\line \expndtw4 amount were spent on assisting object references, object oriented virtu-\line al memories might have better cost-performance than paging systems.}\par \pard \plain \cbpat0\qj\li0\fi241\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 The LOOM design uses two levels of object addressing and translates\line \expndtw2 between address spaces when necessary. Up to 2\super 31\nosupersub  objects residing on\line \expndtw4 secondary storage are represented by a cache of 2\super 15\nosupersub  objects in main\line \expndtw3 memory. These behave almost identically to resident Smalltalk-80 ob-\line jects. When a reference from an object in main memory to one in sec-\line \expndtw8 ondary memory is made, an object fault occurs, the latter is brought\line \expndtw4 into main memory, and processing continues. This design allows for a\line \expndtw6 large virtual address space and a space- and speed-efficient resident\line \expndtw4 space. Because the major algorithms in LOOM are written in Smalltalk\line \expndtw3 itself, LOOM will be a major test-bed for new swapping algorithms and\line \expndtw1 for new ways of reducing page faults by grouping objects in secondary\line storage.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1233\margrsxn1773\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb1066\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1233\margrsxn1773\margtsxn1440\margbsxn720\cols2\colno1\colw1566\colsr695\colno2\colw6642 {\shp {\*\shpinst \shpleft-11\shptop-306\shpright8910\shpbottom-306\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs28 Acknowledg-\line \expndtw-1 ments}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb7\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 The design of LOOM was a true group effort. Jim Althoff and Steve\line \expndtw2 Weyer proposed an early version to improve the speed of their work on\line \expndtw5 programmer directed object overlays. Peter Deutsch worked out a de-\line \expndtw3 sign for an early version of the dual name spaces (short and long Oops).}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1546\margrsxn1457\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li18\fi0\ri0\sb0\sa0\tlul\tx6116 \f2\fs20{\b0\i0\ul\cf0\charscalex134\expndtw-14\dn0\f25\cchs161\lang1032\fs16 270{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex134\expndtw2\dn0\f3\cchs0\lang1033\fs16 LOOM \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Large Object-Oriented Memory for Smalltalk-80 Systems}\par \pard \plain \cbpat0\qj\li2261\fi0\ri0\sb234\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex111\expndtw7\dn0\f3\cchs0\lang1033\fs20 Dan Ingalls, Glenn, and Ted designed the three kinds of reference\line \expndtw5 counts. Danny Bobrow said that leaves were not enough, and Larry\line \expndtw0 Tesler suggested lambdas from the design of his operating system called\line \expndtw2 Caravan. Ted, Dan, and Glenn worked out the final system design, and\line \expndtw1 Ted and Diana Merry built a test version of the LOOM algorithms. Ted\line \expndtw3 and Glenn did the Alto and Dorado implementations.}\par {\shp {\*\shpinst \shpleft-11\shptop889\shpright8910\shpbottom889\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb1206\sa0\tx2509 \f2\fs20{\b\i0\cf0\charscalex141\expndtw-4\dn0\f3\cchs0\lang1033\fs20 References{\charscalex100\expndtw0\tab }\charscalex111\expndtw5\lang1032 1. \b0\lang1033 Denning, Peter J., "Virtual Memory", \i Computing Surveys \i0 vol. \lang1032 2,}\par \pard \plain \cbpat0\ql\li2750\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex111\expndtw-2\dn0\f3\cchs0\lang1033\fs20 no. \lang1032 3, \lang1033 Sept. \lang1032 1970.}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20  2.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw9\dn0\f3\cchs0\lang1033\fs20 Burton, Richard R., et al., (The Interlisp-D Group), Papers on\line \expndtw4 Interlisp-D, Xerox PARC CIS-5, July \lang1032 1981; \lang1033 (a revised version of\line \expndtw-5 Xerox PARC SSL-80-4).}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb119\sa0\sl-238\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20  3.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb119\sa0\sl-238\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw-2\dn0\f3\cchs0\lang1033\fs20 Kaehler,   Ted,   "Virtual   Memory   for   an   Object-Oriented   Lan-\line \expndtw-1 guage", \i Byte \i0 vol. \lang1032 6, \lang1033 no. \lang1032 8, \lang1033 Aug. \lang1032 1981.}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb119\sa0\sl-238\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20  4.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb119\sa0\sl-238\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw2\dn0\f3\cchs0\lang1033\fs20 Goldberg, Adele, and Robson, David, \i Smalltalk-80: The Language\line \expndtw0 and Its Implementation, \i0 Addison-Wesley, Reading, Mass., \lang1032 1983.}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb112\sa0\sl-238\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20  5.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb112\sa0\sl-238\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-12\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw7\dn0\f3\cchs0\lang1033\fs20 Lampson, Butler W., and Pier, Kenneth \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'c1\hich\af1\dbch\af25\loch\f1\cchs161 .,  \lang1033 "A Processor for a\line \expndtw2 High-Peformance   Personal   Computer",   Seventh   International\line \expndtw4 Symposium on Computer Architecture, SigArch/IEEE, La Baule,\line \expndtw-1 France, May \lang1032 1980; \lang1033 (also in Xerox PARC CSL-81-1, Jan. \lang1032 1981.)}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-14\dn0\f25\cchs161\lang1032\fs20  6.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-14\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw7\dn0\f3\cchs0\lang1033\fs20 Stamos, James W., "A Large Object-Oriented Virtual Memory:\line \expndtw0 Grouping  Strategies,   Measurements,   and   Performance,"   Xerox\line \expndtw-5 PARC SCG-82-2, May \lang1032 1982.}\par {\pntext\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb122\sa0\sl-234\slmult0\tx2736 \b0\i0\cf0\charscalex111\expndtw-14\dn0\f25\cchs161\lang1032\fs20  7.\tab}\pard \plain \cbpat0\ql\li2736\fi-259\ri0\sb122\sa0\sl-234\slmult0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-14\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw4\dn0\f3\cchs0\lang1033\fs20 Thacker, C. P., et al., "Alto: A Personal Computer", in \i Computer\line Structures: Readings and Examples, \i0\lang1032 2nd \lang1033 Edition, Eds. Sieworek,\line \expndtw-3 Bell,   and  Newell,   McGraw-Hill,   New  York,   \lang1032 1981;  \lang1033 (also  Xerox\line \expndtw-5 PARC CSL-79-11, Aug. \lang1032 1979.}\par {\pntext\pard \plain \cbpat0\ql\li2477\fi0\ri0\sb126\sa0\tx2736 \b0\i0\cf0\charscalex111\expndtw-13\dn0\f25\cchs161\lang1032\fs20  8.\tab}\pard \plain \cbpat0\ql\li2477\fi0\ri0\sb126\sa0\tx2736 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart2\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex111\expndtw-13\dn0\f25\cchs161\lang1032\fs20 {\b0\i0\cf0\charscalex111\expndtw0\dn0\f3\cchs0\lang1033\fs20 See reference \lang1032 6.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2738\margrsxn1539\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri1037\sb0\sa0{\pict\picw11633\pich20053\picwgoal6595\pichgoal11368\jpegblip
}\par\pard \plain \cbpat0\qr\li0\fi0\ri0\sb43\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs18 271}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn734\margrsxn11175\margtsxn1440\margbsxn720 {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1823\margrsxn683\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft4180\shptop-306\shpright8918\shpbottom-306\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li4180\fi0\ri0\sb0\sa0\sl-436\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs44 Managing the Evolution\line \expndtw2 of Smalltalk-80 Systems}\par \pard \plain \cbpat0\ql\li4176\fi0\ri0\sb292\sa0\sl-234\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs32 Steve Putz}\par \pard \plain \cbpat0\ql\li4180\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Software Concepts Group}\par \pard \plain \cbpat0\ql\li4176\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Xerox Palo Alto Research Center}\par \pard \plain \cbpat0\ql\li4183\fi0\ri0\sb7\sa1832\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Palo Alto, California}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1823\margrsxn1169\margtsxn1440\margbsxn720\cols2\colno1\colw1519\colsr738\colno2\colw6660 {\shp {\*\shpinst \shpleft-4\shptop-241\shpright8917\shpbottom-241\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs28 Introduction}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb65\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 This paper describes a software system currently being used by the\line \expndtw2 Software Concepts Group (SCG) to help facilitate and document our de-\line \expndtw3 velopment of the Smalltalk-80 system. The central feature of this devel-\line \expndtw7 opment support system is a remote database containing information\line \expndtw3 about past and proposed changes to the Smalltalk-80 system, as well as\line \expndtw7 bug reports and an informal library of application programs. We call\line \expndtw6 the present program which maintains this database the Smalltalk-80\line \expndtw4 version handler.}\par \pard \plain \cbpat0\ql\li0\fi234\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Three kinds of documentation which we have found to be important\line \expndtw4 in the development of the Smalltalk-80 system are:}\par {\pntext\pard \plain \cbpat0\ql\li223\fi0\ri0\sb137\sa0\sl-356\slmult0\tx482 \b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22  1.\tab}\pard \plain \cbpat0\ql\li223\fi0\ri0\sb137\sa0\sl-356\slmult0\tx482 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Documentation of system changes and system release versions,}\par {\pntext\pard \plain \cbpat0\ql\li223\fi0\ri0\sb0\sa0\sl-356\slmult0\tx482 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li223\fi0\ri0\sb0\sa0\sl-356\slmult0\tx482 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Documentation of known bugs and other problems, and}\par {\pntext\pard \plain \cbpat0\ql\li223\fi0\ri0\sb0\sa0\sl-356\slmult0\tx482 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  3.\tab}\pard \plain \cbpat0\ql\li223\fi0\ri0\sb0\sa0\sl-356\slmult0\tx482 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Maintenance of a software applications library.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1823\margrsxn1169\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb774\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1823\margrsxn1169\margtsxn1440\margbsxn720\cols2\colno1\colw1677\colsr587\colno2\colw6652 {\shp {\*\shpinst \shpleft-4\shptop-310\shpright8924\shpbottom-310\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs28 A Research}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs28 Programming}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs28 Environment}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 The SCG Smalltalk-80 programming environment is used as an experi-\line \expndtw3 mental basis for the development of new concepts in user interfaces,\line language, and system development tools. The system is modified in or-\line \expndtw5 der to repair bugs, to enhance existing functions, and to introduce new}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4069\margrsxn683\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb137\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn4069\margrsxn683\margtsxn1440\margbsxn720\cols2\colno1\colw4262\colsr2174\colno2\colw720 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs18 Copyright \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'a9\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 Xerox Corporation \lang1032 1982. \lang1033 All rights reserved.}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb241\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs18 273}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1122\margrsxn1870\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft9742\shptop7211\shpright9742\shpbottom11409\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\tlul\tx4579 \f2\fs20{\b0\i0\ul\cf0\charscalex134\expndtw-14\dn0\f25\cchs161\lang1032\fs16 274{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex134\expndtw5\dn0\f3\cchs0\lang1033\fs16 Managing the Evolution of Smalltalk-80 Systems}\par \pard \plain \cbpat0\qj\li2272\fi0\ri0\sb227\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw4\dn0\f3\cchs0\lang1033\fs20 functionality. New versions of the system are released for use within\line \expndtw1 the group frequently. Since different people are often working on the\line \expndtw2 system at the same time, it is important to coordinate and document\line \expndtw3 changes to the system, so that inconsistencies are not introduced and\line \expndtw-1 new bugs are kept to a minimum. Since each user has their own copy of\line \expndtw1 the system, those who are using the Smalltalk-80 system for creating\line \expndtw2 independent applications also need to know about changes to the sys-\line \expndtw0 tem, so they can maintain compatibility and take advantage of new fea-\line \expndtw-1 tures. Documentation of problems found by users of the system can help\line \expndtw0 to warn other users, as well as serving as a list of "things to fix." It is\line \expndtw5 therefore very desirable to have a well maintained bug list which is\line \expndtw0 easy to update and access.}\par \pard \plain \cbpat0\qj\li2268\fi238\ri4\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw2\dn0\f3\cchs0\lang1033\fs20 In addition to fixing and improving the Smalltalk-80 system itself,\line \expndtw1 SCG and other users often create small software applications or en-\line \expndtw0 hancements which may be of interest to others. We call these programs\line and enhancements "goodies." It is useful to have easy availability and\line \expndtw-1 documentation for these goodies in the form of a software applications\line \expndtw2 library. If popular, goodies may be incorporated into a later version of\line \expndtw0 the system.}\par {\shp {\*\shpinst \shpleft0\shptop1368\shpright8914\shpbottom1368\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb1678\sa0\sl-234\slmult0\tx2264 \f2\fs20{\b\i0\cf0\charscalex145\expndtw-3\dn0\f3\cchs0\lang1033\fs20 Past Practices{\charscalex100\expndtw0\tab }\b0\charscalex113\expndtw1 In the early development of the Smalltalk-80 system, as with its precur-}\par \pard \plain \cbpat0\qj\li2254\fi0\ri11\sb7\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw10\dn0\f3\cchs0\lang1033\fs20 sors, we had only some \i ad hoc \i0 and informal mechanisms for\line \expndtw2 maintaining the three kinds of system documentation mentioned earli-\line er. At any given time, our current Smalltalk system would be more or\line \expndtw-1 less stable depending on the current focus of activity. During a period of\line \expndtw0 rapid change and development, many people are doing systems pro-\line gramming and new versions of the system may be created as often as\line \expndtw1 several times a day. Eventually this is followed by a more stable period\line in which more people are doing applications and other independent ex-\line \expndtw0 periments; new versions of the system, with minimal changes, are then\line released every few months or so.}\par \pard \plain \cbpat0\qj\li2250\fi241\ri11\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex113\expndtw-1\dn0\f3\cchs0\lang1033\fs20 During the periods of rapid system development, changes were fre-\line \expndtw4 quently made directly to the current system image, which was then\line \expndtw1 written out to become the new, current system. Although old versions\line \expndtw-1 were always maintained for reference and recovery, no systematic docu-\line \expndtw0 mentation was kept of the changes made, other than verbal communi-\line \expndtw4 cation and some notes (written by the programmer) kept within the\line \expndtw2 system itself. Bugs were either communicated verbally or sometimes\line \expndtw1 listed on a whiteboard until fixed.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1189\margrsxn1766\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4190\fi0\ri0\sb0\sa0\tlul\tx8672 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex139\expndtw-18\dn0\f25\cchs161\lang1032\fs16 275}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\cf0\charscalex139\expndtw0\dn0\f3\cchs0\lang1033\fs16 An Interim Development Support Mechanism}\par \pard \plain \cbpat0\qj\li2246\fi238\ri47\sb263\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 During more stable periods, changes were collected in Smalltalk-80\line \expndtw3 code files and later applied to the system all at once. A more or less de-\line tailed message would be distributed (via electronic mail) outlining the\line changes in the new version. Problems and bugs were usually communi-\line \expndtw4 cated verbally and not necessarily written down.}\par \pard \plain \cbpat0\qj\li2246\fi238\ri58\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 An informal applications ("goodie") library evolved where users\line \expndtw2 placed Smalltalk-80 code files on a special file directory and announced\line \expndtw3 the new goodie via electronic mail. Usually little or no documentation\line \expndtw4 accompanied the announcement. The announcements were not system-\line \expndtw3 atically collected, so unfortunately there was not a satisfactory index of\line what was available.}\par \pard \plain \cbpat0\qj\li2243\fi234\ri61\sb0\sa1670\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 These informal methods worked reasonably well due to the small\line \expndtw4 number of people involved, and the relative simplicity of the changes\line \expndtw3 being made. One of the disadvantages was that less urgent information,\line \expndtw8 such as a small bug, was often forgotten. Another disadvantage was\line \expndtw4 that no detailed record was kept of \i why \i0 a particular change or fix was\line \expndtw8 made, and why it was done the way it was. Often the programmer is\line \expndtw2 not even fully aware of his implicit design decisions. As a result, some-\line \expndtw3 times an important part of a change would be accidentally undone or\line \expndtw5 interfered with by a later change.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1189\margrsxn1795\margtsxn1440\margbsxn720\cols2\colno1\colw1576\colsr673\colno2\colw6674 {\shp {\*\shpinst \shpleft-4\shptop-313\shpright8917\shpbottom-313\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs28 An Interim\line Development\line \expndtw-3 Support\line \expndtw-2 Mechanism}\par \column \pard \plain \cbpat0\qj\li7\fi0\ri14\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 During one period of especially frantic development, we decided that\line \expndtw2 some more formal mechanisms for dealing with documentation and sys-\line \expndtw3 tem software were required in order to better support our needs for\line \expndtw7 communication about our changing Smalltalk-80 system. One reason\line \expndtw4 for this is that the Smalltalk-80 system is significantly larger and more\line \expndtw5 complex than earlier Smalltalk systems. Software tools for manipulat-\line \expndtw3 ing this information would be very helpful and would be much less te-\line \expndtw5 dious than the corresponding manual methods.}\par \pard \plain \cbpat0\qj\li0\fi238\ri22\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Although we planned to create software within the Smalltalk-80 sys-\line tem itself for system development support, we started with a simple\line \expndtw8 mechanism consisting of a minimum of automation in order to gain\line \expndtw4 some preliminary experience. Fig. \lang1032 15.1 \lang1033 is a diagram of the components\line \expndtw6 of the interim support system, outlining as an example the submission\line \expndtw3 of a bug fix report.}\par \pard \plain \cbpat0\qj\li25\fi230\ri0\sb7\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Initially we used an electronic mail system that was not part of the\line \expndtw3 Smalltalk-80 system in order to enter and collect messages about the\line Smalltalk-80 system. Standard forms were used to send messages to a\line \expndtw4 special "mailbox" (called "Smalltalk80Support") regarding bug reports,}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1552\margrsxn1368\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li47\fi0\ri0\sb0\sa0\tlul\tx4608 \f2\fs20{\b0\i0\ul\cf0\charscalex135\expndtw-14\dn0\f25\cchs161\lang1032\fs16 276{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li40\fi0\ri0\sb7\sa360 \f2\fs20{\b0\i0\cf0\charscalex135\expndtw3\dn0\f3\cchs0\lang1033\fs16 Managing the Evolution of Smalltalk-80 Systems}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1552\margrsxn1368\margtsxn1440\margbsxn720\cols4\colno1\colw1814\colsr252\colno2\colw1926\colsr338\colno3\colw2070\colsr342\colno4\colw2246 {\shp {\*\shpinst \shpleft6941\shptop-47\shpright8856\shpbottom-47\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft2268\shptop-40\shpright3794\shpbottom-40\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft4529\shptop-40\shpright6221\shpbottom-40\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}{\shp {\*\shpinst \shpleft194\shptop-32\shpright1576\shpbottom-32\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 8890}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb32\sa0\sl-140\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f2\cchs0\lang1033\fs16 /user fixes a bug and  \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'cb\line \expndtw-4\hich\af0\dbch\af24\loch\f0\cchs161 ( \lang1033 places the code file      I \dbch\af24\loch\af0\hich\f0\cchs161\lang1032 \u9632\'3f\line \expndtw1\hich\af0\dbch\af2\loch\f0\cchs0\lang1033 \\on a remote file server/}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb40\sa0\sl-144\slmult0\tx742\tx1782 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs16 /user sends an electron ic\\\line \lang1032 ( \lang1033 message describing the \lang1032 )\line \lang1033 \\{\charscalex100\expndtw0\tab }\expndtw-6 bug fix{\charscalex100\expndtw0\tab }\expndtw0\lang1032 /}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb32\sa0\sl-144\slmult0\tx1955 \f2\fs20{\b0\i\cf0\charscalex100\expndtw4\dn0\f24\cchs161\lang1032\fs16 ( \i0\lang1033 maintainer appends the \loch\af0\hich\af0\dbch\f24\cchs161\lang1032 \'cb\line \expndtw-4\hich\af0\dbch\af24\loch\f0\cchs161 ( \lang1033 message to the appropriate \lang1032 )\line \expndtw-5\lang1033 V.         remote mail file{\charscalex100\expndtw0\tab }\i\expndtw0 J}\par \column {\pard\plain \sb0\sa0\sl-1\slmult0\fs2\par}\pard\sl-548\slmult0\sb58\keepn\pvpara\dropcapli3\dropcapt1{\cbpat0\b0\i0\ul0\charscalex100\f2\fs54\up1{(}\par}\pard \plain \cbpat0\ql\li151\fi-151\ri0\sb58\sa0\sl-144\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs16 user opens a mail browser\line \expndtw-4 and may inspect \i or \i0 incorporate\line the code files mentioned}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1696\margrsxn1735\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb47\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1696\margrsxn1735\margtsxn1440\margbsxn720\cols4\colno1\colw1501\colsr788\colno2\colw1080\colsr1292\colno3\colw1083\colsr1246\colno4\colw1486 {\shp {\*\shpinst \shpleft6998\shptop-22\shpright8445\shpbottom-22\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft2326\shptop-14\shpright3341\shpbottom-14\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft4694\shptop-14\shpright5709\shpbottom-14\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft36\shptop-7\shpright1469\shpbottom-7\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb22\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-6\dn0\f24\cchs161\lang1032\fs16 ( \lang1033 Smalltalk-80 System)}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb14\sa0 \f2\fs20{\b0\i0\ul\cf0\charscalex100\expndtw0\dn0\f24\cchs161\lang1032\fs16 ( \lang1033 Mail System\ul0  \i f}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb7\sa0 \f2\fs20{\b0\i0\ul\cf0\charscalex100\expndtw3\dn0\f2\cchs0\lang1033\fs16 (Mail System\ul0  \lang1032 )}\par \column \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\ul\cf0\charscalex100\expndtw-6\dn0\f2\cchs0\lang1033\fs16 ^Smalltalk-80 System)}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1552\margrsxn1368\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li3755\fi0\ri0\sb356\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs16 Mail Server}\par \pard \plain \cbpat0\ql\li5180\fi0\ri0\sb313\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f2\cchs0\lang1033\fs16 File Server}\par \pard \plain \cbpat0\ql\li972\fi0\ri0\sb115\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 15.1}\par \pard \plain \cbpat0\qj\li2293\fi0\ri47\sb518\sa785\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 bug fixes, system changes, "goodies," or miscellaneous comments about\line \expndtw3 the Smalltalk-80 system. Copies of these messages were also sent to a\line \expndtw5 Smalltalk-80 users' group called "Smalltalk80Users." Fig. \lang1032 15.2 \lang1033 shows\line \expndtw3 the form used for submitting bug fixes. These messages were collected\line \expndtw4 daily by a system maintainer in a number of mail files on a remote file\line \expndtw1 server.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn2527\margrsxn3265\margtsxn1440\margbsxn720\cols2\colno1\colw1090\colsr241\colno2\colw4784 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb2174\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Figure \lang1032 15.2}\par \column \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f2\cchs0\lang1033\fs18 Subject: Smalltalk-80 Bug Fix: \b\i ShortDescription}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f2\cchs0\lang1033\fs18 To: Smalltalk80Support.PA}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb7\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f2\cchs0\lang1033\fs18 cc: Smalltalk80Userst.PA}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs18 Source-File: [Phylum] \lang1032 < \lang1033 Smalltalk80Support \lang1032 > \b\i\lang1033 FileName \b0\i0 .st}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f2\cchs0\lang1033\fs18 From-Version: \b\i VersionDate}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-5\dn0\f2\cchs0\lang1033\fs20 Bug:     \b\i DescriptionOfBug}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-3\dn0\f2\cchs0\lang1033\fs20 Fix:      \b\i DescriptionOfFix}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb11\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f2\cchs0\lang1033\fs18 Methods Affected:}\par \pard \plain \cbpat0\ql\li0\fi598\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b\i\cf0\charscalex100\expndtw2\dn0\f2\cchs0\lang1033\fs20 ListMethodsAffected\line \b0\i0\expndtw-5 Reviewer:      \b\i NameOfReviewer}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1552\margrsxn1368\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qj\li2308\fi0\ri29\sb544\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs22 Messages regarding software submissions (e.g., bug fixes or goodies) con-\line \expndtw5 tained the field \i Source-File \i0 indicating the name of a centrally-located\line \expndtw2 file containing the source code. Periodically new versions of the system\line \expndtw5 would be created based on the messages received. An electronic mes-\line \expndtw4 sage would then be sent documenting the new version.}\par \pard \plain \cbpat0\qj\li2297\fi245\ri29\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 A simple user interface was created for browsing the message files\line \expndtw4 from within the Smalltalk-80 system. The mail browser window shown\line \expndtw6 in Fig. \lang1032 15.3 \lang1033 has two parts. The top part is a menu containing the titles\line of the messages in the file. When the user selects a title, the corre-\line \expndtw3 sponding message is displayed in the lower part, Fig. \lang1032 15.4.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1580\margrsxn1369\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 271}\par \pard \plain \cbpat0\ql\li4331\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Detecting Conflicts Between Software Submissions}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn6588\margrsxn1505\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \li0\ri0\sb0\sa0\pvpara\phmrg\posnegx-5011\posnegy263\absw0\absh5983\nowrap\dfrmtxtx40\dfrmtxty0 {\pict\picw7950\pich10553\picwgoal4507\pichgoal5983\jpegblip
