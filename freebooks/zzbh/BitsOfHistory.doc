tbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 store new IP}\cell \pard \plain \cbpat0\ql\li821\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 1}\cell \pard \plain \cbpat0\ql\li205\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 0}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx2844 \clvertalt\cltxlrtb\cellx4637 \clvertalt\cltxlrtb\cellx5047 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs20 store new SP}\cell \pard \plain \cbpat0\ql\li821\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 1}\cell \pard \plain \cbpat0\ql\li205\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 0}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx2844 \clvertalt\cltxlrtb\cellx4637 \clvertalt\cltxlrtb\cellx5047 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 get address of new context}\cell \pard \plain \cbpat0\ql\li806\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 0}\cell \pard \plain \cbpat0\ql\li216\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 1}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx2844 \clvertalt\cltxlrtb\cellx4637 \clvertalt\cltxlrtb\cellx5047 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 get address of new method}\cell \pard \plain \cbpat0\ql\li806\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 0}\cell \pard \plain \cbpat0\ql\li205\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 2}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx2844 \clvertalt\cltxlrtb\cellx4637 \clvertalt\cltxlrtb\cellx5047 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 get address of new receiver}\cell \pard \plain \cbpat0\ql\li810\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 0}\cell \pard \plain \cbpat0\ql\li216\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 1}\cell \pard\intbl\row \trowd\trgaph40 \trrh-194 \clvertalt\cltxlrtb\cellx2844 \clvertalt\cltxlrtb\cellx4637 \clvertalt\cltxlrtb\cellx5047 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs20 Total}\cell \pard \plain \cbpat0\ql\li817\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 14}\cell \pard \plain \cbpat0\ql\li202\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 4}\cell \pard\intbl\row \pard{\shp {\*\shpinst \shpleft2239\shptop94\shpright8877\shpbottom94\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 6985}}}}\pard \plain \cbpat0\qj\li2250\fi0\ri0\sb724\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Computing the indirections for the other operations was straightfor-\line \expndtw4 ward, except for the nonarithmetic primitives, where we cheated by as-\line \expndtw3 suming three indirections each. (These are only \lang1032 6% \lang1033 of the bytecodes\line \expndtw6 executed.) Table \lang1032 11.13 \lang1033 gives the number of indirections required for\line \expndtw2 each type of bytecode. A by-the-book implementation performs an indi-\line rection for every bytecode simply to fetch it; caching this address of the\line next bytecode is every implementor's favorite optimization. The optimi-\line \expndtw4 zations are successful, they remove three-quarters of the indirections.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn3533\margrsxn1694\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4396\fi0\ri0\sb0\sa0\tlul\tx6390 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\ul\cf0\charscalex111\expndtw-23\dn0\f25\cchs161\lang1032\fs20 201}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex111\expndtw0\dn0\f3\cchs0\lang1033\fs20 Object Table Indirection}\par {\shp {\*\shpinst \shpleft11\shptop320\shpright6664\shpbottom320\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li1112\fi0\ri0\sb374\sa238 \f2\fs20{\b\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Table \lang1032 11.12 \lang1033 Object Table Indirections for Returns}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3533\margrsxn3332\margtsxn1440\margbsxn720\cols2\colno1\colw2246\colsr1127\colno2\colw1670 {\shp {\*\shpinst \shpleft18\shptop-198\shpright6671\shpbottom-198\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li709\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs20 Operation}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb126\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs20 fetch bytecode}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 pop result}\par \pard \plain \cbpat0\ql\li7\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 push result}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 stor