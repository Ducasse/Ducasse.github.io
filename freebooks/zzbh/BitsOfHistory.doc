par {\shp {\*\shpinst \shpleft2268\shptop36\shpright8906\shpbottom36\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li2282\fi0\ri0\sb248\sa0\tx5562\tx7060 \f2\fs20{\b0\i\cf0\charscalex109\expndtw3\dn0\f3\cchs0\lang1033\fs18 Type of Instantiation{\charscalex100\expndtw0\tab }\expndtw-4 Percentage{\charscalex100\expndtw0\tab }\expndtw-1 Cumulative Percentage}\par \pard \plain \cbpat0\ql\li2560\fi0\ri0\sb122\sa0\sl-238\slmult0\tx5706\tx7661 \f2\fs20{\b0\i0\cf0\charscalex109\expndtw2\dn0\f3\cchs0\lang1033\fs18 pointer object{\charscalex100\expndtw0\tab }\expndtw-5\lang1032 99.11%{\charscalex100\expndtw0\tab }\expndtw-4 99.11%}\par \pard \plain \cbpat0\ql\li2560\fi0\ri0\sb0\sa0\sl-238\slmult0\tx5800\tx7661 \f2\fs20{\b0\i0\cf0\charscalex109\expndtw0\dn0\f3\cchs0\lang1033\fs18 word object{\charscalex100\expndtw0\tab }\expndtw-5\lang1032 0.49%{\charscalex100\expndtw0\tab }\expndtw-4 99.60%}\par \pard \plain \cbpat0\ql\li2560\fi0\ri0\sb0\sa0\sl-238\slmult0\tx5800\tx7578 \f2\fs20{\b0\i0\cf0\charscalex109\expndtw1\dn0\f3\cchs0\lang1033\fs18 byte object{\charscalex100\expndtw0\tab }\expndtw-5\lang1032 0.40%{\charscalex100\expndtw0\tab }100.00%}\par {\shp {\*\shpinst \shpleft2261\shptop54\shpright8907\shpbottom54\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\qj\li2246\fi0\ri11\sb630\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Table \lang1032 12.32 \lang1033 shows the percentage of memory allocated to the three ob-\line \expndtw4 ject types. Pointer objects lead this category by an overwhelming mar-\line gin with an even greater share than in Table \lang1032 12.31. \lang1033 The next places are\line reversed, with word objects taking second. Though the system instanti-\line ates byte objects more frequently than word objects, the average word\line \expndtw8 object is more than three times larger. A breakdown by classes and\line \expndtw4 sizes will further clarify this situation.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn3538\margrsxn1682\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li4878\fi0\ri0\sb0\sa0\tlul\tx6379 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\cf0\charscalex139\expndtw-16\dn0\f25\cchs161\lang1032\fs16 229}\par \pard \plain \cbpat0\ql\li3780\fi0\ri0\sb4\sa0 \f2\fs20{\b0\i0\cf0\charscalex139\expndtw0\dn0\f3\cchs0\lang1033\fs16 Memory System Measurements}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn3538\margrsxn1696\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft0\shptop335\shpright6653\shpbottom335\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li1094\fi0\ri0\sb389\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs20 Table \lang1032 12.33 \lang1033 Object Instantiations by Size in Words}\par {\shp {\*\shpinst \shpleft0\shptop32\shpright6653\shpbottom32\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb238\sa0\tx3290\tx4795 \f2\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs20 Size of Instantiation{\charscalex100\expndtw0\tab }\expndtw-5 Percentage{\charscalex100\expndtw0\tab }\expndtw-2 Cumulative Percentage}\par \trowd\trgaph40 \trrh-187 \clvertalt\cltxlrtb\cellx1231 \clvertalt\cltxlrtb\cellx2549 \pard \plain \cbpat0\qr\li0\fi0\ri526\sb0\sa0 \intbl \f2\fs20\pvpara\phcol\posnegx3434\posnegy112\absw0\absh1094\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\charscalex100\expndtw-6\dn0\f25\cchs161\lang1032\fs20 83.86%}\cell \pard \plain \cbpat0\qr\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20\pvpara\phcol\posnegx3434\posnegy112\absw0\absh1094\dfrmtxtx40\dfrmtxty0 {\b0\i0\cf0\c