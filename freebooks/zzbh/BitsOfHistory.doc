\f25\cchs161\lang1032\fs18 63}\cell \pard \plain \cbpat0\ql\li274\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 136}\cell \pard \plain \cbpat0\qr\li0\fi0\ri180\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 811}\cell \pard \plain \cbpat0\ql\li544\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 3}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx1411 \clvertalt\cltxlrtb\cellx3175 \clvertalt\cltxlrtb\cellx4521 \clvertalt\cltxlrtb\cellx5306 \clvertalt\cltxlrtb\cellx6674 \pard \plain \cbpat0\ql\li421\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 16}\cell \pard \plain \cbpat0\ql\li806\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 125}\cell \pard \plain \cbpat0\ql\li263\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 271}\cell \pard \plain \cbpat0\qr\li0\fi0\ri173\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs20 1622}\cell \pard \plain \cbpat0\ql\li544\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 5}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx1411 \clvertalt\cltxlrtb\cellx3175 \clvertalt\cltxlrtb\cellx4521 \clvertalt\cltxlrtb\cellx5306 \clvertalt\cltxlrtb\cellx6674 \pard \plain \cbpat0\ql\li403\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 32}\cell \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 250}\cell \pard \plain \cbpat0\ql\li256\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 543}\cell \pard \plain \cbpat0\qr\li0\fi0\ri176\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f25\cchs161\lang1032\fs20 3245}\cell \pard \plain \cbpat0\ql\li454\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 10}\cell \pard\intbl\row \trowd\trgaph40 \trrh-238 \clvertalt\cltxlrtb\cellx1411 \clvertalt\cltxlrtb\cellx3175 \clvertalt\cltxlrtb\cellx4521 \clvertalt\cltxlrtb\cellx5306 \clvertalt\cltxlrtb\cellx6674 \pard \plain \cbpat0\ql\li407\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 64}\cell \pard \plain \cbpat0\ql\li792\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 500}\cell \pard \plain \cbpat0\ql\li176\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-12\dn0\f25\cchs161\lang1032\fs20 1085}\cell \pard \plain \cbpat0\qr\li0\fi0\ri173\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-7\dn0\f25\cchs161\lang1032\fs20 6489}\cell \pard \plain \cbpat0\ql\li443\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 21}\cell \pard\intbl\row \trowd\trgaph40 \trrh-317 \clvertalt\clbrdrb\brdrs\brdrw15\cltxlrtb\cellx1411 \clvertalt\clbrdrb\brdrs\brdrw15\cltxlrtb\cellx3175 \clvertalt\clbrdrb\brdrs\brdrw15\cltxlrtb\cellx4521 \clvertalt\clbrdrb\brdrs\brdrw15\cltxlrtb\cellx5306 \clvertalt\clbrdrb\brdrs\brdrw15\cltxlrtb\cellx6674 \pard \plain \cbpat0\ql\li317\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 128}\cell \pard \plain \cbpat0\ql\li709\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs20 1000}\cell \pard \plain \cbpat0\ql\li166\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-8\dn0\f25\cchs161\lang1032\fs20 2170}\cell \pard \plain \cbpat0\qr\li0\fi0\ri173\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs20 12978}\cell \pard \plain \cbpat0\ql\li443\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b0\i0\cf0\charscalex100\expndtw0\dn0\f25\cchs161\lang1032\fs18 41}\cell \pard\intbl\row \pard\sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1476\margrsxn1469\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li7247\fi0\ri0\sb0\sa0\tlul\tx8672 \f2\fs20{\charscalex100\expndtw0\tab }{\b0\i0\ul\cf0\charscalex100\expndtw-4\dn0\f24\cchs161\lang1032\fs18 339}\par \pard \plain \cbpat0\ql\li7304\fi0\ri0\sb11\sa544 \f2\fs20{\b0\i0\cf0\charscalex139\expndtw-3\dn0\f3\cchs0\lang1033\fs16 Acknowledgments}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1498\margrsxn1491\margtsxn1440\margbsxn720\cols2\colno1\colw1310\colsr940\colno2\colw6670 {\shp {\*\shpinst \shpleft-11\shptop-259\shpright8924\shpbottom-259\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs28 Evaluation}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri4\sb61\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 For interactive use, we recommend 128K bytecode reclamation periods.\line \expndtw8 At this interval the accumulation of unusable storage is reasonable,\line \expndtw2 10K words\super 30\nosupersub , and the latency time is short, 41ms. We recommend an \lang1032 8\line \expndtw3\lang1033 window cache. Eight windows are far superior to four, but we appear to\line reach a diminishing rate of return at \lang1032 8; 16 \lang1033 windows do not improve per-\line \expndtw2 formance (i.e. overflow and underflow rates) significantly.}\par \pard \plain \cbpat0\qj\li14\fi238\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Our scheme reduces storage reclamation time by at least \lang1032 80%\loch\af1\hich\af1\dbch\f25\cchs161 \'97\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 it\line \expndtw3 rarely allocates method contexts, avoiding \lang1032 82% \lang1033 of the object allocations\line \expndtw5 and deallocations, and does \lang1032 89% \lang1033 fewer reference-count operations than\line \expndtw4 a non-volatilizing implementation. Reclamation overhead is reduced to\line \expndtw9\lang1032 4% \lang1033 to \lang1032 5%, \lang1033 and generally, the SVM performance is improved by\line \expndtw-11 22%-27%\super 31\nosupersub .}\par \pard \plain \cbpat0\qj\li11\fi238\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Although we have not considered the speedup due to the caching of\line contexts in fast registers, we feel that it will be significant. We base our\line choice of fast registers over slower memory on current trends which fa-\line \expndtw1 vor the inclusion of more processor registers\super 32\nosupersub .}\par \pard \plain \cbpat0\qj\li11\fi241\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Our results were based on a 400ns processor cycle time. If a faster or\line \expndtw6 slower one is available, then an implementor will adjust the reclama-\line \expndtw5 tion period to suit any response time requirements.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1501\margrsxn1487\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb893\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1501\margrsxn1487\margtsxn1440\margbsxn720\cols2\colno1\colw1436\colsr810\colno2\colw6674 {\shp {\*\shpinst \shpleft-7\shptop-259\shpright8928\shpbottom-259\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs28 Conclusions}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb58\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 A Smalltalk-80 system can save considerable time managing dynamic\line \expndtw3 storage if it treats context objects as special objects. The hardware is in-\line expensive and a \lang1032 20% \lang1033 general improvement in performance is realizable.\line \expndtw0 The savings could be as high as \lang1032 30%, \lang1033 depending on the implementation\super 33\nosupersub .\line \expndtw7 Although the strategy looks attractive, we must caution the reader\line \expndtw3 that we have not dealt with two significant issues: how to reclaim cyclic\line \expndtw6 garbage, and how to handle the special cases mentioned on p. \lang1032 332. \lang1033 In\line \expndtw4 the first case, we must resort to garbage collection or develop a scheme\line \expndtw5 to keep track of cycles\super 34\nosupersub . In the second case, the system implementor\line \expndtw3 must weigh the technique's benefits against its complexity. The special\line \expndtw10 cases are not straightforward and their complexity may make our\line \expndtw5 scheme appear less attractive, i.e., we may want to replace the refer-\line \expndtw6 ence-count technique by garbage collection. No clear-cut answer has\line \expndtw1 been found.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1476\margrsxn1509\margtsxn1440\margbsxn720\cols1\colsx60 {\pard\plain \sb806\sa0\sl-1\slmult0\fs2\par}\sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1476\margrsxn1509\margtsxn1440\margbsxn720\cols2\colno1\colw1558\colsr706\colno2\colw6660 {\shp {\*\shpinst \shpleft11\shptop-313\shpright8953\shpbottom-313\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs28 Acknowledg-\line ments}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 I'd like to thank my colleagues here at Berkeley: Ricki Blau, Clem Cole,\line \expndtw5 John Foderaro, Robert Hagmann, Peter Kessler, Ed Pelegri, Richard\line \expndtw10 Probst, Russell Wayman, and especially David Ungar, with whom I}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1679\margrsxn1305\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\tlul\tx6768 \f2\fs20{\b0\i0\ul\cf0\charscalex134\expndtw-14\dn0\f25\cchs161\lang1032\fs16 340{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0 \f2\fs20{\b0\i0\cf0\charscalex134\expndtw6\dn0\f3\cchs0\lang1033\fs16 Low-Overhead Storage Reclamation in the Smalltalk-80 Virtual Machine}\par \pard \plain \cbpat0\qj\li2272\fi0\ri0\sb212\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 spent many enjoyable evenings discussing Smalltalk. At Xerox: Adele\line Goldberg, Dan Ingalls, Ted Kaehler, Glenn Krasner; also Peter Deutsch,\line \expndtw6 who has shared with me and my colleagues a good deal of his insight\line \expndtw3 into the Smalltalk-80 system. At Hewlett-Packard, I'd like to thank Bob\line \expndtw5 Ballance, Ted Laliotis, and Jim Stinger. Without their help this work\line \expndtw2 would never have been possible.}\par \pard \plain \cbpat0\qj\li2272\fi234\ri4\sb0\sa1415\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw8\dn0\f3\cchs0\lang1033\fs22 Two faculty members have been instrumental in the execution of\line \expndtw2 this project: Yale Patt and my advisor David Patterson. Yale kindly of-\line \expndtw8 fered his time as second reader. Dave made Smalltalk a reality at\line \expndtw4 Berkeley. He provided a good deal of moral support\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 I am grateful for\line \expndtw5 his time and for his consideration throughout the project.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1690\margrsxn1309\margtsxn1440\margbsxn720\cols2\colno1\colw1501\colsr724\colno2\colw6685 {\shp {\*\shpinst \shpleft-7\shptop-313\shpright8914\shpbottom-313\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb4\sa0\sl-238\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs28 Appendix\loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'97\line \expndtw2\hich\af1\dbch\af3\loch\f1\cchs0\lang1033 Analysis of\line \expndtw-1 Storage\line \expndtw-3 Reclamation\line \expndtw-5 Times}\par \column \pard \plain \cbpat0\qj\li32\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 Reclamation consists of two activities: marking the entry as "free" in\line \expndtw4 the object table, and chasing its pointers. We present both algorithms,\line \expndtw5 assuming one 400ns machine instruction per step. We include branch-\line \expndtw3 ing probabilites at all decision steps (they are enclosed in square brack-\line \expndtw0 ets, e.g. \lang1032 "[0.24]"). \lang1033 These probabilities were reported in\super 35\nosupersub .\line \expndtw3 The freeing algorithm involves seven steps totaling \lang1032 2.8\loch\af1\hich\af1\dbch\f25\cchs161 \'ec\hich\af1\dbch\af25\loch\f1\cchs161 8:}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb86\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-16\dn0\f25\cchs161\lang1032\fs22  1.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb86\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-16\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Read and clear a ZCT entry.}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Shift the Oop (to remove the tag bit).}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  3.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Read the OT entry.}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  4.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 Set the "free" bit.}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  5.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 Write the OT entry back.}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  6.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 Thread the free object (in the object memory) into the free list.}\par {\pntext\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  7.\tab}\pard \plain \cbpat0\ql\li324\fi0\ri0\sb0\sa0\sl-356\slmult0\tx583 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 Update the head-of-free-list pointer.}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb202\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The pointer chasing algorithm involves \lang1032 12 \lang1033 steps totaling \lang1032 2.7\loch\af1\hich\af1\dbch\f25\cchs161 \'ec\'e2\hich\af1\dbch\af25\loch\f1\cchs161 :}\par {\pntext\pard \plain \cbpat0\ql\li313\fi0\ri0\sb140\sa0\sl-353\slmult0\tx576 \b0\i0\cf0\charscalex100\expndtw-16\dn0\f25\cchs161\lang1032\fs22  1.\tab}\pard \plain \cbpat0\ql\li313\fi0\ri0\sb140\sa0\sl-353\slmult0\tx576 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent263\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-16\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Read the field.}\par {\pntext\pard \plain \cbpat0\ql\li313\fi0\ri0\sb0\sa0\sl-353\slmult0\tx576 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li313\fi0\ri0\sb0\sa0\sl-353\slmult0\tx576 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent263\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Nil the field.}\par {\pntext\pard \plain \cbpat0\ql\li313\fi0\ri0\sb0\sa0\sl-353\slmult0\tx576 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  3.\tab}\pard \plain \cbpat0\ql\li313\fi0\ri0\sb0\sa0\sl-353\slmult0\tx576 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent263\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0