n720\cols2\colno1\colw1573\colsr688\colno2\colw6652 {\shp {\*\shpinst \shpleft0\shptop-317\shpright8921\shpbottom-317\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 13970}}}}\pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-241\slmult0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-2\dn0\f3\cchs0\lang1033\fs28 Acknowledg-\line ments}\par \column \pard \plain \cbpat0\qj\li0\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 The authors wish to thank the management of Apple Computer, and es-\line pecially John Couch, Wayne Rosing, Nellie Connors, and Ron Johnston\line \expndtw6 for providing the equipment, the environment and the freedom needed\line \expndtw3 to implement the Smalltalk-80 system successfully on the \lang1032 MC68000.\line \expndtw2\lang1033 Thanks also go to Bill Atkinson and David Hough, who helped with the\line \expndtw3 engineering effort.}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn10519\margrsxn360\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft14\shptop-238\shpright1180\shpbottom-238\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}{\shp {\*\shpinst \shpleft-612\shptop101\shpright-612\shpbottom490\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 2540}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-4\dn0\f3\cchs0\lang1033\fs28 Abstract}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn2710\margrsxn2542\margtsxn1440\margbsxn720\cols1\colsx60 {\shp {\*\shpinst \shpleft1912\shptop-302\shpright6657\shpbottom-302\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 4445}}}}\pard \plain \cbpat0\qj\li1912\fi0\ri1123\sb0\sa0\sl-439\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs44 Berkeley Smalltalk:\line \expndtw2 Who Knows Where\line \expndtw3 the Time Goes?}\par \pard \plain \cbpat0\ql\li1904\fi0\ri0\sb252\sa0\sl-302\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs30 David M. Ungar\line \expndtw5 David A. Patterson}\par \pard \plain \cbpat0\ql\li1904\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Computer Science Division\line \expndtw3 Department of Electrical Engineering\line \expndtw2 and Computer Sciences\line University of California, Berkeley}\par {\shp {\*\shpinst \shpleft-1105\shptop1170\shpright6657\shpbottom1170\shpfhdr0\shpbxcolumn\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li238\fi0\ri0\sb1487\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw0\dn0\f3\cchs0\lang1033\fs22 Sad deserted shore,}\par \pard \plain \cbpat0\ql\li270\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 Your fickle friends are leaving.}\par \pard \plain \cbpat0\ql\li230\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 Ah but then you know}\par \pard \plain \cbpat0\ql\li234\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 It's time for them to go.}\par \pard \plain \cbpat0\ql\li234\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 But I will still be here}\par \pard \plain \cbpat0\ql\li230\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw3\dn0\f3\cchs0\lang1033\fs22 I have no thought of leaving.}\par \pard \plain \cbpat0\ql\li230\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 I do not count the time.}\par \pard \plain \cbpat0\ql\li263\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Who knows where the time goes?}\par \pard \plain \cbpat0\ql\li259\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 Who knows where the time goes?}\par \pard \plain \cbpat0\ql\li461\fi0\ri0\sb0\sa0\sl-238\slmult0 \f2\fs20{\b0\i\cf0\charscalex100\expndtw1\dn0\f3\cchs0\lang1033\fs22 "Who Knows Where the Time Goes"*}\par \pard \plain \cbpat0\qj\li0\fi0\ri11\sb155\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw4\dn0\f3\cchs0\lang1033\fs22 We have implemented the Smalltalk-80 virtual machine in the C pro-\line \expndtw5 gramming language for the Digital Equipment Corp. VAX-\lang1032 11/780 \lang1033 un-\line \expndtw3 der Berkeley Unix. We call this system Berkeley Smalltalk (BS). An\line AED-512 terminal connected over a 9600-baud serial link serves as the\line \expndtw4 display device. In four months one person wrote BS in about \lang1032 9000 \lang1033 lines}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb396\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw5\dn0\f25\cchs161\lang1032\fs18 * \lang1033 [Denny, Sandy, "Who Knows Where the Time Goes?" (BMI) Winckler Music, Judy}\par \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-1\dn0\f3\cchs0\lang1033\fs18 Collins (BMI), Irving Music, used by permission]}\par \pard \plain \cbpat0\ql\li4\fi0\ri0\sb0\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw9\dn0\f3\cchs0\lang1033\fs18 Copyright \loch\af1\hich\af1\dbch\f25\cchs161\lang1032 \'a9\hich\af1\dbch\af25\loch\f1\cchs161  \lang1033 David M. Ungar, David A. Patterson, \lang1032 1982. \lang1033 All rights reserved.}\par \pard \plain \cbpat0\qr\li0\fi0\ri0\sb4\sa0\sl-234\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw-10\dn0\f24\cchs161\lang1032\fs18 189}\par \sect\sectd \sbkpage\pgwsxn11909\pghsxn16834\marglsxn1642\margrsxn763\margtsxn1440\margbsxn720\cols1\colsx60 \pard \plain \cbpat0\ql\li29\fi0\ri0\sb0\sa0\tlul\tx5191 \f2\fs20{\b0\i0\ul\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs20 190{\charscalex100\expndtw0\tab }}\par \pard \plain \cbpat0\ql\li18\fi0\ri0\sb0\sa0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw11\dn0\f3\cchs0\lang1033\fs20 Berkeley Smalltalk: Who Knows Where the Time Goes?}\par \pard \plain \cbpat0\qj\li2290\fi0\ri572\sb277\sa1123\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw2\dn0\f3\cchs0\lang1033\fs22 of source code. Other Smalltalk-80 implementations on non-micropro-\line \expndtw1 grammable computers have suffered from poor performance. We believe\line \expndtw5 that a straightforward, literal implementation of the specification can-\line \expndtw3 not achieve acceptable performance. This paper explains how the opti-\line mizations in BS have increased performance fourfold.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1674\margrsxn1336\margtsxn1440\margbsxn720\cols2\colno1\colw1515\colsr731\colno2\colw6652 {\shp {\*\shpinst \shpleft-4\shptop-252\shpright8902\shpbottom-252\shpfhdr0\shpbxmargin\shpbypara\shpwr3\shpwrk0\shpfblwtxt1\shpz0\shplid1{\sp{\sn shapeType}{\sv 20}}{\sp{\sn lineWidth}{\sv 11430}}}}\pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \f2\fs20{\b\i0\cf0\charscalex100\expndtw-3\dn0\f3\cchs0\lang1033\fs28 Introduction}\par \column \pard \plain \cbpat0\qj\li7\fi0\ri0\sb61\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 The Smalltalk-80 book\super 1\nosupersub  includes a clear and intelligible definition of\line \expndtw4 the Smalltalk-80 virtual machine. To learn about the performance con-\line \expndtw3 sequences of following this definition, we have measured key compo-\line \expndtw0 nents of:}\par {\pntext\pard \plain \cbpat0\ql\li241\fi0\ri0\sb216\sa0\tx500 \b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22  1.\tab}\pard \plain \cbpat0\ql\li241\fi0\ri0\sb216\sa0\tx500 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-18\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw5\dn0\f3\cchs0\lang1033\fs22 An interpreter that follows the book exactly; and}\par {\pntext\pard \plain \cbpat0\ql\li500\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx500 \b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22  2.\tab}\pard \plain \cbpat0\ql\li500\fi-259\ri0\sb115\sa0\sl-238\slmult0\tx500 \f2\fs20{\*\pn\pnlvlbody\pndec\pnstart1\pnindent259\pnf25{\pntxta .}}\b0\i0\cf0\charscalex100\expndtw-10\dn0\f25\cchs161\lang1032\fs22 {\b0\i0\cf0\charscalex100\expndtw7\dn0\f3\cchs0\lang1033\fs22 Berkeley Smalltalk (BS), which meets the specification but does\line \expndtw4 not mimic the definition in the book.}\par \pard \plain \cbpat0\qj\li0\fi0\ri0\sb238\sa0\sl-238\slmult0 \f2\fs20{\b0\i0\cf0\charscalex100\expndtw6\dn0\f3\cchs0\lang1033\fs22 The results of this study are shown in Table \lang1032 11.1 \lang1033 below. Berkeley\line \expndtw7 Smalltalk is \lang1032 4.8 \lang1033 times faster than a straight-forward implementation.\line \expndtw5 The rest of this paper details the steps behind this result.}\par \sect\sectd \sbknone\pgwsxn11909\pghsxn16834\marglsxn1642\margrsxn763\margtsxn1440\margbsxn720\cols1\colsx60 \pard\plain\fs2\sa410\sl-1\slmult0\par\trowd\trgaph40 \trrh-295 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx1951 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx3636 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx5350 \clvertalt\clbrdrt\brdrs\brdrw15\cltxlrtb\cellx7244 \pard \plain \cbpat0\ql\li1379\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw-12\dn0\f3\cchs0\lang1033\fs20 Tabl<}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw0\dn0\loch\af1\hich\af1\dbch\f25\cchs161\lang1032\fs20 \'fa\hich\af1\dbch\af25\loch\f1\cchs161  11.1 \lang1033 Summary of}\cell \pard \plain \cbpat0\ql\li0\fi0\ri0\sb0\sa0 \intbl \f2\fs20{\b\i0\cf0\charscalex100\expndtw2\dn0